import "sha1";
import "ssl";

class Bencode {
  init(data) {
    this.data = data;
    this.pos = 0;
    this.info = "";
  }

  get_info_string() {
    
  }

  peek() { return this.data[this.pos]; }
  advance() {
    var char = this.peek();
    this.pos = this.pos + 1;
    return char;
  }

  decode() {
    var b = this.peek();
    if (b == 105) return this.parse_int();
    if (b == 108) return this.parse_list();
    if (b == 100) return this.parse_dict();
    if (b >= 48 and b <= 57) return this.parse_string();
    return nil;
  }

  parse_int() {
    this.pos = this.pos + 1;
    var start = this.pos;
    while (this.data[this.pos] != 101) {
      this.pos = this.pos + 1;
    }
    //var val = Math.to_number(this.data.slice(start, this.pos));
    var res = this.data.slice(start, this.pos);
    this.pos = this.pos + 1;
    //return val;
    return Math.to_number(res);
  }

  parse_list() {
    this.pos = this.pos + 1; // skip 'l'
    var list = [];
    
    while (this.data[this.pos] != 101) { // 101 is 'e'
      list.push(this.decode());
    }

    this.pos = this.pos + 1; // skip 'e'
    return list;
  }

  parse_dict() {
    var start = this.pos;
    this.pos = this.pos + 1; // skip 'd'
    var dict = {};

    while (this.data[this.pos] != 101) { // 101 is 'e'
      var key = this.decode();
      var val = this.decode();
      dict[key] = val;
    }

    this.pos = this.pos + 1; // skip 'e'
    var end = this.pos;
    // start, end
    return dict;
  }

  parse_string() {
    var start = this.pos;
    while (this.data[this.pos] != 58) {
      this.pos = this.pos + 1;
    }

    var lenStr = this.data.slice(start, this.pos);
    var len = Math.to_number(lenStr);

    this.pos = this.pos + 1;

    var str = this.data.slice(this.pos, this.pos + len);

    this.pos = this.pos + len;

    return str;
  }
}

