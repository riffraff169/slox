      }
      return Result(false, nil, "Unable to connect");
    } else {
      print "Unable to connect";
      System.exit(3);
    }
  }

  announce_udp(event = 0) {
    if (this.verbose) print "Executing UDP announce, event id: ", event;

    var announce_packet = Struct.pack("8s I I 20s 20s Q Q Q I I I I H", [
      this.connection_id, // 64bit connection id
      1,                  // action 1 = announce
      this.trans_id,      // transaction id to verify response matching
      this.info_hash,     // 20 byte torrent info hash
      this.peer_id_str,   // 20 byte unique client peer id
      0, 0, 0,            // downloaded, left, upload offsets (64 bit)
      event,              // current swarm event flag
      0,                  // ip address (0 means tracker uses sender ip)
      this.key,           // unique extensions key
      -1,                 // nu_want (-1 means default chunk size)
      6881                // the port your client listens on for inbound peers
    ]);

    this.sock.send(announce_packet);
    var aresponse = this.sock.recv(1024);

    if (aresponse != nil and aresponse.ok) {
      this.peers = [];
      var header = Struct.unpack("I I I I I", aresponse.val);
      var action = header[0];
      var ret_tid = header[1];
      var interval = header[2];
      var leechers = header[3];
      var seeders = header[4];

      if (action == 1) {
        if (this.verbose) print "Seeders: ", seeders, " Leechers: ", leechers;

        for (var i = 20; i < aresponse.val.len(); i = i + 6) {
          var ip = str(aresponse.val[i]) + "." +
                   str(aresponse.val[i + 1]) + "." +
                   str(aresponse.val[i + 2]) + "." +
                   str(aresponse.val[i + 3]);

          var p = (aresponse.val[i + 4] << 8) | aresponse.val[i + 5];

          if (this.verbose) print "Found UDP peer: ", ip, ":", p;
          this.peers.push([ip, p]);
        }
        return true;
      } else if (action == 3) {
        var error_msg = Struct.unpack("s", aresponse.val.slice(8));
        print "Tracker UDP Protocol Error: ", error_msg;
        return false;
      }
    } else {
      print "UDP Announce failed: No response or socket error.";
    }
    return false;
  }

  announce_http(event = 0) {
    print "announce_http...";
    var benc = Bencode(this.http_response_body);
    var tracker_dict = benc.decode();

    if (tracker_dict.has("failure reason")) {
      print "Tracker Error: ", tracker_dict["failure reason"];
      return nil;
    }

    this.peers = [];
    var raw_peers = tracker_dict["peers"];

    if (typeof(raw_peers) == "String") {
      for (var i = 0; i < raw_peers.len(); i = i + 6) {
        var ip = str(raw_peers[i]) + "." + str(raw_peers[i+1]) + "." +
                 str(raw_peers[i+2]) + "." + str(raw_peers[i+3]);
        var p = (raw_peers[i+4] << 8) | raw_peers[i+5];

        if (this.verbose) print "Found HTTP peer: ", ip, ":", p;
        this.peers.push([ip, p]);
      }
    }
  }

  announce(event = 0) {
    if (this.active_protocol == "udp") {
      return this.announce_udp(event);
    } else if (this.active_protocol == "http" or this.active_protocol == "https") {
      return this.announce_http(event);
    }
    return nil;
  }

  announce1(event = 0) {
    var announce_packet = Struct.pack("8s I I 20s 20s Q Q Q I I I I H", [
      this.connection_id,
      1,
      this.trans_id,
      this.info_hash,
      this.peer_id_str,
      0, 0, 0,
      0,
      event,
      this.key,
      -1,
      6881
    ]);

    this.sock.send(announce_packet);

    var aresponse = this.sock.recv(1024);

    if (aresponse.ok) {
      this.peers = [];
      var header = Struct.unpack("I I I I I", aresponse.val);
      var action = header[0];
      var ret_tid = header[1];
      var interval = header[2];
      var leechers = header[3];
      var seeders = header[4];


      if (action == 1) {
        if (this.verbose) print "Seeders:", seeders, "Leechers:", leechers;

        for (var i = 20; i < aresponse.val.len(); i = i + 6) {
          var ip = str(aresponse.val[i]) + "." + str(aresponse.val[i+1]) + "." + str(aresponse.val[i+2]) + "." + str(aresponse.val[i+3]);
          var p = (aresponse.val[i+4] << 8) | aresponse.val[i+5];
          if (this.verbose) print "Found peer: " + ip + ":" + str(p);
          this.peers.push([ip, p]);
        }
      } else if (action == 3) {
        var error_msg = Struct.unpack("s", aresponse.val.slice(8));
        print "Tracker Error: ", error_msg;
      }
    } else { 
      print "Response == nil";
    }
  }

  create_connect_socket() {
    this.sock = IO.udp();
  }

  peer_connection() {
    for (var i = 0; i < this.peers.len(); i = i + 1) {
      var peer_info = this.peers[i];
      var ip = peer_info[0];
      var port = peer_info[1];

      print "Attempting connect to ", ip, ":", port, "...";

      this.p_sock = IO.tcp();
      if (this.p_sock.connect(ip, port, 2).ok) {
        print "Connected to peer: ", ip;

        this.p_sock.set_recv_timeout(5000);

        var handshake = Struct.pack("B 19s 8s 20s 20s", [
          19,
          "BitTorrent protocol",
          "\0\0\0\0\0\0\0\0",
          this.info_hash,
          this.peer_id_str
        ]);
        this.p_sock.send(handshake);

        var response = this.p_sock.recv(68);

        if (response.ok and response.val.len() == 68) {
            //print "Received handshake hex: ", res.val.hex();
            if (this.verbose == true) {
              print "Handshake successful!";
            }
            var new_peer = Peer(ip, port, this.p_sock);
            this.active_peers.push(new_peer);
        } else {
          if (this.verbose == true) {
            print "Handshake failed.";
            print response.err;
          }
        }
      } else {
        if (errno == 111) {
          print "Skipping ", ip, " - peer is not accepting connections.";
        } else {
          if (this.verbose) print "Peer", ip, "unreachable,  trying next...";
        }
      }
    }
  }

  manage_loop() {
  }

  download() {
    print "Starting download loop with ", this.active_peers.len(), " peers.";

    while (this.active_peers.len() > 0) {
      var result = IO.poll(this.active_peers, 1000);

      if (!result.ok) {
        print "Poll error: ", result.err;
        break;
      }

      var ready = result.val;
      for (var i = 0; i < ready.len(); i = i + 1) {
        var peer = ready[i];
        if (!this.handle_peer(peer)) {
          this.active_peers = this.active_peers.filter(fun(p) {
            return p.ip != peer.ip;
          });
        }
      }

      this.request_blocks();
    }
  }

  fetch_peers_http(host, port, path) {
    var sock = IO.tcp();
    var res = sock.connect(host, port);
    if (res.ok) {
      var request = "GET " + path + "HTTP/1.1\r\n" +
                    "Host: " + host + "\r\n" +
                    "User-Agent: GM0101/1.0\r\n" +
                    "Connection: closer\n\r\n";
      sock.send(request);

      var response = "";
      while (true) {
        var chunk = sock.recv(4096);
        if  (chunk.ok) {
          if (chunk.val.len() == 0) break;
          response = response + chunk;
        } else {
          return Result(false, nil, "Bad response");
        }
      }
      sock.close();
      return Result(true, nil, response);
    }
  }

  recv_all(socket, size) {
    var buffer = "";
    while (buffer.len() < size) {
      var res = socket.recv(size - buffer.len());

      if (!res.ok) {
        return Result(false, nil, "Socket recv error: " + res.err);
      }

      if (res.val == nil) {
        return Result(false, nil, "Peer disconnected cleanly (received nil)");
      }

      if (res.val.len() == 0) {
        return Result(false, nil, "Peer disconnected cleanly (received 0 bytes)");
      }

      buffer = buffer + res.val;
    }
    return Result(true, buffer, nil);
  }

  download_all() {
    print "Starting sequential download for ", this.total_pieces, " pieces...";

    for (var i = 0; i  < this.total_pieces; i = i + 1) {
      print "------------------------------------------------";
      print "PROGRESS: Processing Piece", i, "/", this.total_pieces - 1;
      print "------------------------------------------------";

      var success = this.download_piece(i);

      if (success) {
        print "Successfully secured and verified Piece:", i;
      } else {
        print "FATAL: Failed to download Piece", i, ". Aborting pipeline.";
        return false;
      }
    }

    print "================================================";
    print "DOWNLOAD COMPLETE: ALl pieces verified successfully!";
    print "================================================";
    return true;
  }

  download_piece(piece_index) {
    var BLOCK_SIZE = 16384;
    var piece_size = this.piece_length;

    // handle the last piece of the torrent being smaller
    if (piece_index == this.total_pieces - 1) {
      piece_size = this.total_torrent_size % this.piece_length;
      if (piece_size == 0) piece_size = this.piece_length;
    }

    if (this.active_peers.len() < 1) return false;
    var peer = this.active_peers[0];

    peer.send_interested();
    if (this.verbose) print "Targeting: ", peer.ip, " for Piece#", piece_index;

    var next_offset = 0;
    this.piece_store = {};
    var start_time = clock();

    if (peer.is_choked == false) {
      if (this.verbose) print "Peer already unchoked. Bootstrapping initial block for Piece#", piece_index;
      peer.send_request(piece_index, next_offset, BLOCK_SIZE);
    } else {
      peer.send_interested();
    }

    while (next_offset < piece_size) {
      var res = peer.sock.recv(4);
      if (!res) break;

      var len = Struct.unpack("I", res.unwrap())[0];
      if (len == 0) continue; // keep alive

      var payload_res = this.recv_all(peer.sock, len);
      if (!payload_res) break;

      var payload = payload_res.unwrap();
      var id = payload[0];

      if (id == 0) { // choke
        if (this.verbose) print "Peer choked us.";
        peer.is_choked = true;

      } else if (id == 1) { // unchoke
        // GUARD 1: Only request the initial block if we weren't already unchoked
        if (peer.is_choked == true) {
          peer.is_choked = false;
          //start_time = clock();
          if (this.verbose) print "Peer unchoked us! Requesting initial block...";
          peer.send_request(piece_index, next_offset, BLOCK_SIZE);
        } else {
          if (this.verbose) print "Peer sent redundant unchoke frame. Ignoring request trigger.";
        }

      } else if (id == 7) { // piece payload
        // extract index (4 bytes) and begin offset (4 bytes) safely
        var info = Struct.unpack("I I", payload.slice(1, 9));
        var r_piece = info[0];
        var r_begin = info[1];
        var data = payload.slice(9);

        // GUARD 2: If we already captured this block offset, it's a network duplicate. Skip
        if (this.piece_store.has(str(r_begin))) {
          if (this.verbose) print "Ignored duplicate block packet at offset: ", r_begin;
          continue;
        }

        print "Received block: Offset ", r_begin, " Size: ", data.len();

        // write this block directly into our multi-file mapping system
        var global_offset = (r_piece * this.piece_length) + r_begin;
        this.write_to_storage(global_offset, data);

        // cache for piece validation
        this.piece_store[str(r_begin)] = data;

        // advance our offset state machine to grab the next block
        if (r_begin == next_offset) {
          next_offset = next_offset + data.len();
        }

        if (next_offset < piece_size) {
          // request next chunk
          var remaining = piece_size - next_offset;
          var next_len = BLOCK_SIZE;
          if (remaining < next_len) next_len = remaining;

          peer.send_request(piece_index, next_offset, next_len);
        } else if (id == 4 or id == 5) {
          // ignore runtime HAVE or BITFIELD frames inside this download loop
        }
      }
    }

    //entire piece loop finished, now verify
    print "Piece extraction finished. Assembling hash...";
    var duration = clock() - start_time;
    var full_piece = "";

    for (var offset = 0; offset < piece_size; offset = offset + BLOCK_SIZE) {
      var block = this.piece_store[str(offset)];
      if (block == nil) {
        print "CRITICAL ERROR: Missing block data at offset ", offset, ". Aborting piece.";
        return false;
      }
      full_piece = full_piece + block;
    }

    var sha1 = SHA1();
    sha1.update(full_piece);
    var my_hash = sha1.final();
    var expected_hash = this.pieces[piece_index];
    var expected = Struct.unpack("I I I I I", this.pieces[piece_index]);

    //if (my_hash == expected_hash) {
    if (my_hash[0] == expected[0] and
        my_hash[1] == expected[1] and
        my_hash[2] == expected[2] and
        my_hash[3] == expected[3] and
        my_hash[4] == expected[4]) {
      print "SUCCESS: Piece ", piece_index, " is valid!";
      return true;
    } else {
      print "CRITICAL ERROR: Piece hash mismatch. Data corrupted.";
      return false;
    }
  }

  request_blocks() {
    if (this.active_peers.len() <1) return false;
    var peer = this.active_peers[0];
    if (this.verbose) print "Targeting peer: ", peer.ip;

    peer.send_interested();
    if (this.verbose) print "Sent INTERESTED to ", peer.ip;

    var downloaded = false;
    while (!downloaded) {
      var res = peer.sock.recv(4);
      if (!res.ok) break;
      
      var len = Struct.unpack("I", res.val)[0];
      if (this.verbose) print "Len: ", len;
      if (len == 0) { // keep-alive
        print "Keep-alive";
        continue;
      }

      var payload_res = this.recv_all(peer.sock, len);
      if (!payload_res.ok) break;

      var payload = payload_res.val;
      var id = payload[0];

      if (this.verbose) print "Full Message - Len: ", len, " ID: ", id;

      if (id == 1) { // unchoke
        if (this.verbose) print "Peer unchoked us!  Requesting block...";

        // id 6, piece 0, offset 0, length 16384
        // format: "B I I I" -> id, index, begin, length
        var request = Struct.pack("I B I I I", [13, 6, 0, 0, 16384]);
        peer.sock.send(request);
      } else if (id == 4) {
        if (this.verbose) print "Peer sent HAVE message, ID: ", id;
      } else if (id == 5) {
        if (this.verbose) print "Received Bitfield (", len - 1, " bytes)";
      } else if (id == 7) { // piece
        // payload for id 7 is [index(4), begin(4), data(X)]
        var info = Struct.unpack("I I", payload.slice(1, 8));
        var piece_index = info[0];
        var block_offset = info[1];
        var global_offset = (piece_index * this.piece_length) + block_offset;

        var data = payload.slice(9);

        if (this.verbose) {
          print "SUCCESS! Received block for Piece ", info[0];
          print "Block size: ", data.len(), "bytes";
        }

        if (!this.piece_store.has(index)) {
          this.piece_store[index] = {};
        }

        this.piece_store[index][begin] = block_data;

        if (this.piece_store[index].len() == blocks_needed) {
          var full_piece = this.piece_store[index][0] + this.piece_store[index][16384];

          var sha1 = SHA1();
          sha1.update(full_piece);
          var my_hash = sha1.final();

          var expected = Struct.unpack("I I I I I", this.pieces[index]);

          if (my_hash == expected) { // real array compare
            this.write_to_files(index, full_piece);
            //this.piece_store.remove(index);
          }
        }
        var f = File.open("piece_0.bin", "wb");
        f.seek(global_offset);
        f.write(data);
        f.close();

        downloaded = true;
        break;

      } else if (id == 20) {
        if (this.verbose) print "Peer sent Extended handshake.";
      } else {
        if (this.verbose) print "Ignoring Message ID: ", id;
      }
    }
  }

  write_to_files(piece_index, data) {
    var piece_start = piece_index * this.piece_length;
    var piece_end = piece_start + data.len();

    for  (var i = 0; i < this.files.len(); i = i +  1) {
      var f = this.files[i]; //{path, length, start, end}

      var overlap_start = Math.max(piece_start, f.start);
      var overlap_end = Math.min(piece_end, f.end);

      if (overlap_start < overlap_end) {
        var slice_start = overlap_start - piece_start;
        var slice_len = overlap_end - overlap_start;
        var file_offset = overlap_start - f.start;

        var chunk = data.slice(slice_start, slice_len);

        var fh = File.open(f.full_path, "rb+");
        fh.seek(file_offset);
        fh.write(chunk);
        fh.close();

        print "Saved piece ", piece_index, " fragment to ", f.path;
      }
    }
  }

  main_loop() {
  }

  peer_listen() {
    this.running = true;

    while (this.running) {
      var res = IO.poll(this.active_peers, 1000);

      if (!res.ok) {
        print "Poll Error: ", res.err;
        break;
      }

      var ready_peers = res.val;
      for (var i = 0; i < read_peers.len(); i = i + 1) {
        var peer_sock = ready_peers[i];

        // this will not block because poll said it's ready
        var msg_res = peer_sock.recv(4096);

        if (msg_res.ok) {
          this.process_data(peer_sock, msg_res.val);
        } else {
          print "Peer disconnected.";
          peer_sock.close();
        }
      }
    }
  }

  message_loop() {
    while (true) {
      var header = this.p_sock.recv(4);
      if (!header.ok) break;

      var length = Struct.unpack("I", header.val)[0];
      if (length == 0) continue; // keep-alive

      var payloadRes = this.p_sock.recv(length);
      if (!payloadRes.ok) break;

      var payload = payloadRes.val;
      var msgid = payload[0];

      if (msgid == 5) { // bitfield
        this.handle_bitfield(payload);
        peer.send_interested();
      } else if (msgid == 1) { // unchoke
        this.is_choked = false;
        break;
      }
    }
  }
  
  handle_bitfield(payload) {
    // payload[0] is the id (5), bytes start at payload[1]
    for (var i = 0; i < this.total_pieces; i = i + 1) {
      var byteIdx = Math.floor(i / 8) + 1;
      var bitIdx = 7 - (i % 8);
      var res = (payload[byteIdx] >> bitIdx) & 1;

      if (res == 1) {
        this.peer_pieces[i] = true;
      }
    }
  }

  remove_zombies() {
    var now = System.time();
    this.active_peers = this.active_peers.filter(fun(p) {
      if (now - p.last_seen > this.peer_timeout) {
        p.sock.close();
        return false;
      }
      return true;
    });
  }

}

fun url_encode(bytes) {
  var result = "";
  //var hex_chars = "0123456789abcdef";

  for (var i = 0; i < bytes.len(); i = i + 1) {
    var c = bytes[i];

    //var high = (b >> 4) & 0x0f;
    //var low = b & 0x0f;
    result = result + "%" + Math.hex(c, 2, false);
  }
  return result;
}

