class Peer {
  init(ip, port, socket) {
    this.ip = ip;
    this.port = port;
    this.sock = socket;
    this.is_choked = true;
    this.am_interested = false;
    this.bitfield = nil;
    this.last_seen = System.time();
  }

  send_interested() {
    var msg = Struct.pack("I B", [1, 2]);
    this.sock.send(msg);
    this.am_interested = true;
  }

  send_request(index, begin, length) {
    // mesage id 6: request
    // payload: index (4), begin (4), length (4)
    var msg = Struct.pack("I B I I I", [13, 6, index, begin, length]);
    this.sock.send(msg);
  }

  to_string() {
    return "Peer(" + this.ip + ", " + str(this.port) + ")";
  }
}

class DownloadManager {
  init(torrent) {
    this.torrent = torrent;
    this.pieces_needed = [];
    this.in_flight = {};
  }

  get_next_request() {
    // 1. look at peer.bitfield to see what they have
    // 2. cross reference with this.pieces_needed
    // 3. ensure the block isn't already in_flight
    // 4. return [index, begin, length]
  }

  handle_block(index, begin, data) {
    // 1. seek and write to the file
    // 2. remove from in_flight
    // 3. check if the whole piece is done
    // 4. if yes, sha1-verify and remove from pieces_needed
  }

  write_block(global_offset, data) {
    var bytes_written = 0;
    var data_to_write = data;
    var current_offset = global_offset;

    for (var i = 0; i < this.file_manifest.len(); i = i + 1) {
      var f = this.file_manifest[i];

      // does this block start before the file end ands end after the file starts
      if (current_offset < f.end and (current_offset + data_to_write.len()) > f.start) {
        // calculate where to start in the file and whre to start in the data buffer
        var file_seek = 0;
        if (current_offset > f.start) {
          file_seek = current_offset - f.start;
        }

        var buffer_offset = 0;
        if (current_offset < f.start) {
          buffer_offset = f.start - current_offset;
        }

        var write_len = data_to_write.len() - buffer_offset;
        if ((file_seek + write_len) > f.length) {
          write_len = f.length - file_seek;
        }

        // write
        this.write_to_disk(f.path, file_seek, data_to_write.slice(buffer_offset, write_len));
      }
    }
  }
}

class Piece {
  init(index, total_size) {
    this.index = index;
    this.total_size = total_size;
    this.data = "";
    this.blocks_received = 0;
    this.expected_blocks = -Math.floor(-(total_size / 16384));
  }

  add_block(offset, block_data) {
  }

  is_complete() {
    return this.blocks_received == this.expected_blocks;
  }
}

fun compare_hashes(h1, h2) {
  if (h1.len() != h2.len()) return false;
  for (var i = 0; i < h1.len(); i = i + 1) {
    if (h1[i] != h2[i]) return false;
  }
  return true;
}

class BT {
  init(file) {
    this.file = file;
    this.data = File.load(this.file);
    this.decoder = Bencode(this.data);
    this.torrent = this.decoder.decode();
    this.announce = this.torrent["announce"];
    this.info = this.torrent["info"];
    this.files = this.info["files"];
    this.name = this.info["name"];
    this.pieces_str = this.info["pieces"];
    this.piece_length = this.info["piece length"];
    //this.peer_id_str = "-GM0001-123456789012";
    this.peer_id = [0; 20];
    this.peer_id[0] = '-';
    this.peer_id[1] = 'G';
    this.peer_id[2] = 'M';
    this.peer_id[3] = '0';
    this.peer_id[4] = '1';
    this.peer_id[5]  = '0';
    this.peer_id[6] = '2';
    this.peer_id[7] = '-';
    for (var i = 8; i < 20; i = i + 1) {
      this.peer_id[i] = (i * Math.random()) % 10 + '0';
    }
    this.peer_id_str = this.peer_id.to_string();
    this.peers = nil;
    this.get_tracker_urls();
    this.create_pieces();
    this.create_info_str();
    //this.generate_transaction_id();
    this.verbose = false;
    this.active_peers = [];
    this.peer_timeout = 120;
    //this.piece_store = [];

    this.create_file_map();
    this.prepare_files();
  }

  write_piece(piece_index, data) {
    var global_start = piece_index * this.piece_length;
    var data_ptr = 0;

    for (var i = 0; i < this.files.len(); i = i + 1) {
      var f = this.file[i];

      var intersect_start = Math.max(global_start, f.start);
      var intersect_end = Math.min(global_start + data.len(), f.end);

      if (intersect_start < intersect_end) {
        var write_size = intersect_end - intersect_start;
        var file_offset = intersect_start - f.start;
        var buffer_offset = intersect_start - global_start;

        var file_handle = File.open(f.full_path, "rb+");
        file_handle.seek(file_offset);
        file_handle.write(data.slice(buffer_offset, write_size));
        file_handle.close();

        print "Wrote ", write_size, " bytes to ", f.path;
      }
    }
  }

  prepare_files() {
    for (var i = 0; i < this.file_map.len(); i = i + 1) {
      var f_info = this.file_map[i];
      var full_path = f_info["path"];

      this.ensure_directories(full_path);

      var f_res = File.open(full_path, "r+b");
      //if (!f_res.ok) {
      if (!f_res) {
        // file doesn exist yet
        if (this.verbose) print "Creating and preallocating: ", full_path;

        var create_res = File.open(full_path, "wb");
        //if (create_res.ok) {
        if (create_res) {
          var f = create_res.unwrap();
          if (f_info["length"] > 0) {
            // seek to the final byte and write a single null padding byte
            f.seek(f_info["length"] - 1, 0);
            f.write("\0");
          }
          f.close();
        }
      } else {
        // file exists, close safely
        if (this.verbose) print "Found existing file structure: ", full_path;
        var f = f_res.unwrap();
        f.close();
      }

      if (this.verbose) {
        print "Preallocated target structure: ", full_path, " (", f_info["length"], " bytes)";
      }
    }
  }

  ensure_directories(path_string) {
    var parts = path_string.split("/");
    var current_path = "";

    for (var i = 0; i < parts.len() - 1; i = i + 1) {
      if (i == 0) {
        current_path = parts[i];
      } else {
        current_path = current_path + "/" + parts[i];
      }

      if (File.mkdir(current_path)) {
      }
    }
  }

  create_file_map() {
    this.file_map = [];
    var current_offset = 0;

    for (var i = 0; i < this.files.len(); i = i + 1) {
      var f_info = this.files[i];

      var full_path = this.name + "/" + f_info["path"].join("/");

      this.file_map.push({
        "path": full_path,
        "length": f_info["length"],
        "start": current_offset,
        "end": current_offset + f_info["length"]
      });
      current_offset = current_offset + f_info["length"];
    }
    this.total_torrent_size = current_offset;
    this.total_pieces = this.pieces.len();
  }

  create_pieces() {
    this.pieces = [];
    for (var i = 0; i < this.pieces_str.len() / 20; i = i + 1) {
      this.pieces.push(this.pieces_str.slice(i * 20, i * 20 + 20));
    }
  }

  create_info_str() {
    var start = this.data.find("4:info") + 6;
    var i = start;
    var depth = 0;
    var total_len = this.data.len();
    var info_str = this.data.slice(start, -1);
    var searching = true;

    while (i < total_len and searching) {
      var char = this.data[i];

      if (char == 'd' or char == 'l') { // d or l
        depth = depth + 1;
        i = i + 1;
      } else if (char == 'e') { // e
        depth = depth - 1;
        i = i + 1;
        if (depth == 0) searching = false;
      } else if (char == 'i') { // i
        i = i + 1;
        while (i < total_len and this.data[i] != 'e') { // e
          i = i + 1;
        }
        i = i + 1; // skip e
      } else if (char >= '0' and char <= '9') { // 0 - 9
        var colon_pos = i;
        while (colon_pos < total_len and this.data[colon_pos] != ':') { // :
          colon_pos = colon_pos + 1;
        }
        var num_str = this.data.slice(i, colon_pos);
        var num = Math.to_number(num_str);
        i = colon_pos + 1 + num;
      } else {
        i = i + 1;
      }
    }

    this.info_str = this.data.slice(start, i);
    var sha1 = SHA1();
    sha1.update(this.info_str);
    var hash_array = sha1.final();
    this.info_hash = Struct.pack("I I I I I", hash_array, true);
    //this.info_hash = sha1.final();
  }

  get_tracker_urls() {
    this.trackers = [];
    var urls = [];

    // 1. check for the extension list first
    if (this.torrent.has("announce-list")) {
      var list = this.torrent["announce-list"];
      for (var i = 0; i < list.len(); i = i + 1) {
        urls.push(list[i][0]);
      }
    }

    // 2. always add the primary announce if not already there
    if (this.torrent.has("announce")) {
      var primary = this.torrent["announce"];

      if (!urls.has(primary))
        urls.push(primary);
    }

    var udplist = urls.filter(fun(url) { return url.slice(0, 3) == "udp"; });
    var httplist = urls.filter(fun(url) { return url.slice(0, 4) == "http"; });
    this.trackers = udplist + httplist;
  }

  get_http_list() {
    //print this.torrent["announce"];
    var httplist = this.urls.find(fun(a) { return a.slice(0,4) == "http"; });
    return httplist;
  }

  get_udp_list() {
    var udplist = this.urls.find(fun(a) { return a.slice(0,4) == "udp:"; });
    return udplist;
  }

  get_name() {
    return this.name;
  }
    
  get_info() {
    return this.info;
  }

  get_info_str() {
    return this.info_str;
  }

  get_info_hash() {
    return this.info_hash;
  }

  get_pieces() {
    return this.pieces;
  }

  get_piece(i) {
    return this.pieces[i];
  }

  get_files() {
    return this.info["files"];
  }

  total_length() {
    var tl = this.info["files"].reduce(fun(a, x) { return a + x["length"]; }, 0);
    return tl;
  }

  generate_transaction_id() {
    //this.trans_id = Math.floor(Math.random() * 0x3FFFFFFF);
    this.trans_id = Math.floor(Math.random() * 0x7fffffff) & 0xffffffff;
  }

  generate_key() {
    this.key = Math.floor(Math.random() * 0xffffffff);
  }

  preallocate() {
    var total_size = this.pieces.len() * this.piece_length;

    var f = File.open(this.name, "wb");
    if (f) {
      f.seek(total_size - 1);
      f.write("\0");
      f.close();
      if (this.verbose) print "Preallocated ", total_size, " bytes for ", this.name;
    }
  }

  write_to_storage(global_offset, data) {
    var bytes_written = 0;
    var data_len = data.len();
    var current_global = global_offset;

    for (var i = 0; i < this.file_map.len(); i = i + 1) {
      var f_info = this.file_map[i];
      var f_start = f_info["start"];
      var f_end = f_start + f_info["length"];

      if (current_global < f_end and (current_global + (data_len - bytes_written)) > f_start) {
        var local_offset = 0;
        if (current_global > f_start) {
          local_offset = current_global - f_start;
        }

        var available_space = f_end - (f_start + local_offset);
        var remaining_data = data_len - bytes_written;

        var write_size = remaining_data;
        if (available_space < write_size) {
          write_size = available_space; // clamp to file edge
        }

        var chunk = data.slice(bytes_written, bytes_written + write_size);

        // open, seek, write, close natively
        var f_res = File.open(f_info["path"], "r+b");
        if (f_res) {
          //print "local_offset: ", local_offset;
          //print typeof(local_offset);
          var f = f_res.unwrap();
          f.seek(local_offset);
          f.write(chunk);
          f.close();
        }

        bytes_written = bytes_written + write_size;
        current_global = current_global + write_size;

        if (bytes_written >= data_len) break;
      }
    }
  }

  create_udp_socket() {
    this.sock = IO.udp();
  }

  create_tcp_socket() {
    this.sock = IO.tcp();
  }

  connect_udp(host, port) {
    this.create_udp_socket();
    this.generate_transaction_id();
    this.generate_key();

    if (!this.sock.connect(host, port)) {
      return Result(false, nil, "UDP connection failed");
    }

    for (var attempts = 1; attempts < 4; attempts = attempts + 1) {
      print "Sending UDP connect request (Attempt", attempts, ")...";

      var packet = Struct.pack("Q I I", [0x41727101980, 0, this.trans_id]);
      this.sock.send(packet);
      this.sock.set_recv_timeout(5000);

      var response = this.sock.recv(5000);
      if (response.ok) {
        this.trans_data = Struct.unpack("I I 8s", response.val);

        if (this.trans_data[1] != this.trans_id) {
          print "Warning: Transaction ID mismatch. Retrying...";
          continue;
        }

        this.connection_id = this.trans_data[2];
        return Result(true, "UDP Connection success", nil);
      }
      this.trans_id = this.trans_id + 1;
    }
    return Result(false, nil, "UDP handshake timed out");
  }

  connect_http(protocol, host, port, path) {
    print "connect_http via ", protocol;
    this.create_tcp_socket();

    if (!this.sock.connect(host, port)) {
      return Result(false, nil, protocol + " connection failed");
    }

    var is_ssl = (protocol == "https");
    var sec = nil;

    if (is_ssl) {
      if (this.verbose) print "Wrapping TCP socket with BearSSL layer...";
      sec = SSL(host, this.sock);

      if (errno == 62) {
        print "SSL Handshake failure. errno: ", errno, " -> ", errstr;
        return Result(false, nil, "TLS Handshake Failed");
      }
    }

    var escaped_hash = url_encode(this.info_hash);
    var escaped_peer = url_encode(this.peer_id_str);

    var query = path + "?info_hash=" + escaped_hash +
                       "&peer_id=" + escaped_peer +
                       "&port=6881&uploaded=0&downloaded=0&left=0&compact=1";

    var http_req = "GET " + query + " HTTP/1.1\r\n" +
                   "Host: " + host + "\r\n" +
                   "User-Agent: GM0101/1.0\r\n" + 
                   "Connection: close\r\n\r\n";

    //print "query: ", query;
    //print "req: ", http_req;
    if (is_ssl) {
      sec.write(http_req);
    } else {
      this.sock.send(http_req);
    }

    var response_str = "";
    if (is_ssl) {
      while (true) {
        var chunk = sec.read();
        if (chunk == nil) break;
        response_str = response_str + chunk;
      }
    } else {
      var response = this.sock.recv(8192);
      if (!response.ok) {
        return Result(false, nil, "HTTP payload receipt failed");
      }
      response_str = response.val;
    }

    print "after response...";
    if (this.verbose) {
      print "================";
      print response_str;
      print "================";
    }
     
    var body_offset = response_str.find("\r\n\r\n");
    if (body_offset == -1) {
      return Result(false, nil, "Malformed HTTP response header");
    }
    body_offset = body_offset + 4;
    var body = response_str.slice(body_offset);

    if (response_str.find("Transfer-Encoding: chunked") != -1) {
      var first_line_end = body.find("\r\n");
      if (first_line_end != nil) {
        //print body;
        //print body.len();
        //print first_line_end;
        body = body.slice(first_line_end + 2);
      }
    }
    this.http_response_body = body;
    return Result(true, "HTTP Tracker endpoint validated", nil);
    //return Result(false, nil, "HTTP Scrape failed");
  }

  connect() {
    if (this.trackers.len() == 0) {
      this.trackers = [this.announce];
    }

    var hostre = Regex("^([a-zA-Z]+)://([^:/]+):?([0-9]+)?(/.*)?$");

    for (var i = 0; i < this.trackers.len(); i = i + 1) {
      var url = this.trackers[i];
      var matches = hostre.match(url);

      if (matches == nil) {
        print "Skipping malformed tracker URL:", url;
        continue;
      }

      var protocol = matches[1];
      var host = matches[2];

      var port = 80;
      if (protocol == "https") port = 443;
      if (protocol == "udp") port = 6969;

      if (matches[3]) {
        port = Math.to_number(matches[3]);
      }

      var path = "/announce";
      if (matches[4]) path = matches[4];

      print "Attempting tracker connection (", protocol, "):", host, ":", port;
      var result = nil;

      if (protocol == "udp") {
        result = this.connect_udp(host,port);
        print "udp test...";
      } else if (protocol == "http" or protocol == "https") {
        result = this.connect_http(protocol, host, port, path);
        print "http test...";
      } else {
        print "Invalid protocol";
        continue;
      }

      if (result != nil and result.ok) {
        this.active_protocol = protocol;
        this.active_host = host;
        this.active_port = port;
        this.active_path = path;
        return result;
      }

      print "Tracker failed. Moving to fallback target...";
    }

    return Result(false, nil, "All trackers exhausted. Unable to connect.");
  }

