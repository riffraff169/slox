}

class Quad < Material {
  // Takes: Vec3, Vec3, Vec3, Material
  init(Q, u, v, mat) {
    this.Q = Q;
    this.u = u;
    this.v = v;
    this.mat = mat;

    var n = u.cross(v);
    this.normal = unit_vector(n);
    this.D = this.normal.dot(Q);
    this.w = n / n.dot(n);

    this.set_bounding_box();
  }

  set_bounding_box() {
    var bbox_diagonal1 = Aabb();
    bbox_diagonal1.set_box_vec(this.Q, this.Q + this.u + this.v);
    var bbox_diagonal2 = Aabb();
    bbox_diagonal2.set_box_vec(this.Q + this.u, this.Q + this.v);
    this.bbox = Aabb();
    this.bbox.set_box_aabb(bbox_diagonal1, bbox_diagonal2);
  }

  bounding_box() {
    return this.bbox;
  }

  hit(r, ray_t_min, ray_t_max) {
    var rec = HitRecord();
    var denom = this.normal.dot(r.direction);

    if (Math.abs(denom) < 1e-8) return false;

    var t = (this.D - this.normal.dot(r.origin)) / denom;
    if (!interval_contains_var(ray_t_min, ray_t_max, t))
      return false;

    var intersection = r.at(t);
    var planar_hitpt_vector = intersection - this.Q;
    var alpha = this.w.dot(planar_hitpt_vector.cross(this.v));
    var beta = this.w.dot(this.u.cross(planar_hitpt_vector));

    var ret = this.is_interior(alpha, beta);
    if (!ret)
      return false;
    rec.u = alpha;
    rec.v = beta;

    rec.t = t;
    rec.p = intersection;
    rec.mat = this.mat;
    rec.set_face_normal(r, this.normal);
    return rec;
  }

  // Takes: Number, Number
  is_interior(a, b) {
    if (!interval_contains_var(0, 1, a) or !interval_contains_var(0, 1, b))
      return false;
    
    return [a, b];
  }
}

class Sphere {
  init(center, radius, mat) {
    this.center = Ray(center, black, 0);
    //this.center = center;
    this.radius = radius;
    if (radius < 0) {
      this.radius = 0;
    }
    this.mat = mat;
    this.moving = false;
    var rvec = Vec3(this.radius, this.radius, this.radius);
    this.bbox = Aabb();
    this.bbox.set_box_vec(this.center.at(0) - rvec, this.center.at(0) + rvec);
  }
 
  // Vec3
  set_motion(c2) {
    this.center = Ray(this.center.origin, c2 - this.center.origin, 0);
    this.moving = true;
    var rvec = Vec3(this.radius, this.radius, this.radius);
    var box1 = Aabb();
    box1.set_box_vec(this.center.at(0) - rvec, this.center.at(0) + rvec);
    var box2 = Aabb();
    box2.set_box_vec(this.center.at(1) - rvec, this.center.at(1) + rvec);
    this.bbox.set_box_aabb(box1, box2);
  }

  // Takes: Vec3, Number, Number
  // Returns: Vec3, really tuple of (u, v, 0)
  get_sphere_uv(p) { 
    // , u, v) 
    // p: a given point on the sphere of radius one, centered at origin
    // u: return value [,1] of angle around the y axis from x=-1
    // v: return value [,1] of angle from y=-1 to y=+1
    // <1 0 0> yields <0.50 0.50>  < -1  0  0> yields <0.00 0.50>
    // <0 1 0> yields <0.50 1.00>  <  0 -1  0> yields <0.50 0.00>
    // <0 0 1> yields <0.25 0.50>  <  0  0 -1> yields <0.75 0.50>

    var theta = Math.acos(-p.y);
    var phi = Math.atan2(-p.z, p.x) + PI;

    return Vec3(phi / TWO_PI, theta / PI, 0);
    //return [phi / TWO_PI, theta / PI];
  }

  // Takes: Ray, Interval
  // Returns: HitRecord | false
  hit(r, ray_t_min, ray_t_max) {
    //print "[SPHERE]: hit";
    var current_center = this.center.at(r.time());
    //var oc = this.center - r.origin;
    var oc = current_center - r.origin;
    var a = r.direction.length_squared();
    var h = r.direction.dot(oc);
    var c = oc.length_squared() - this.radius * this.radius;

    var discriminant = h * h - a * c;
    if (discriminant < 0) {
      return false;
    }

    var sqrtd = Math.sqrt(discriminant);

    var root = (h - sqrtd) / a;
    if (!interval_surrounds_var(ray_t_min, ray_t_max, root)) {
      root = (h + sqrtd) / a;
      if (!interval_surrounds_var(ray_t_min, ray_t_max, root)) {
        return false;
      }
    }
    
    var rec = HitRecord();
    rec.t = root;
    rec.p = r.at(rec.t);
    //var outward_normal = (rec.p - this.center) / this.radius;
    var outward_normal = (rec.p - current_center) / this.radius;
    rec.set_face_normal(r, outward_normal);
    var uv = this.get_sphere_uv(outward_normal);
    rec.u = uv.x;
    rec.v = uv.y;
    rec.mat = this.mat;

    return rec;
  }
}

var vec000 = Vec3(0, 0, 0);

class HitRecord {
  init() {
    this.p = vec000; // Vec3(0, 0, 0);
    this.t = 0;
    this.normal = vec000; // Vec3(0, 0, 0);
    this.front_face = true;
    this.mat = nil;
    this.u = 0;
    this.v = 0;
  }

  set_face_normal(r, outward_normal) {
    //this.front_face = dot(r.direction, outward_normal) < 0;
    this.front_face = r.direction.dot(outward_normal) < 0;
    if (this.front_face) {
      this.normal = outward_normal;
    } else {
      this.normal = -outward_normal;
    }
  }

  to_string() {
    return "HitRecord()";
    //return "HitRecord(" + this.p.to_string + ")";
    //return "HitRecord(" + this.p.to_string() + ", " + this.t.to_string() + ", "
    //  + this.normal.to_string() + ",  " + this.front_face + ", " + this.mat + ")";
  }
}

fun interval_size(i) {
  return i[1] - i[0];
}

fun interval_contains(i, x) {
  return i[0] <= x and x <= i[1];
}

fun interval_contains_var(min, max, x) {
  return min <= x and x <= max;
}

fun interval_surrounds(i, x) {
  return i[0] < x and x < i[1];
}

fun interval_surrounds_var(min, max, x) {
  return min < x and x < max;
}

fun interval_clamp(i, x) {
  if (x < i[0]) return i[0];
  if (x > i[1]) return i[1];
  return x;
}

fun interval_clamp_var(min, max, x) {
  if (x < min) return min;
  if (x > max) return max;
  return x;
}

fun checker2(u, v, p) {
  var check = Math.floor(10 * u) + Math.floor(10 * v);
  if (check % 2 == 0) {
    return dark_square;
  }
  return light_square;
}

fun checker3(u, v, p, scale) {
  var inv_scale = 1.0 / scale;
  var xint = Math.floor(inv_scale * p.x);
  var yint = Math.floor(inv_scale * p.y);
  var zint = Math.floor(inv_scale * p.z);
  var isEven = ((xint + yint + zint) % 2 == 0);

  if (isEven) {
    return dark_square;
  }
  return light_square;
}

class Solid_Color {
  // Takes: Vec3 (color)
  init(v) {
    this.albedo = v;
  }

  set_rgb(r, g, b) {
    this.albedo = Vec3(r, g, b);
  }

  value(u, v, p) {
    //print "Solid_Color.value: ", this.albedo;
    return this.albedo;
  }
}

var dark_square = Vec3(0.1, 0.1, 0.1);
var light_square = Vec3(0.9, 0.9, 0.9);
var color_scale = 1.0 / 255.0;

class Image_Texture {
  init(filename) {
    this.image = Image.load(filename);
  }

  value(u, v, p) {
    if (this.image.height <= 0) return Vec3(0,0,0);
    var newu = interval_clamp_var(0, 1, u);
    var newv = 1.0 - interval_clamp_var(0, 1, v);
    var i = Math.floor(newu * this.image.width);
    var j = Math.floor(newv * this.image.height);

    if (i >= this.image.width) i = this.image.width - 1;
    if (j >= this.image.height) j = this.image.height - 1;

    var pixel = this.image.get_pixel(i, j);
    return Vec3(color_scale * pixel[0], color_scale * pixel[1], color_scale * pixel[2]);
  }
}

class Checker {
  // Takes: Number, Vec3, Vec3
  init(scale, even, odd) {
    this.inv_scale = 1.0 / scale;
    this.even = Solid_Color(even);
    this.odd = Solid_Color(odd);
  }

  set_colors(c1, c2) {
    this.even = Solid_Color(c1);
    this.odd = Solid_Color(c2);
  }

  set_texture(t1, t2) {
    this.even = t1;
    this.odd = t2;
  }

  value(u, v, p) {
    // var local_p = p - sphere_center;
    var xint = Math.floor(this.inv_scale * p.x);
    var yint = Math.floor(this.inv_scale * p.y);
    var zint = Math.floor(this.inv_scale * p.z);

    var sum = xint + yint + zint;
    var isEven = (sum % 2) == 0;

    var result;
    if (isEven) result = this.even.value(u, v, p);
    else result = this.odd.value(u, v, p);
    //print this.even.value(u, v, p);
    //print this.odd.value(u, v, p);
    //print "Checker result type: ", typeof(result);
    return result;
  }
}

class Lambertian < Material {
  init(albedo) {
    //this.albedo = albedo;
    this.tex = Solid_Color(albedo);
    //this.tex = nil;
    //this.using_tex = false;
  }

  set_texture(tex) {
    this.tex = tex;
    //this.using_tex = true;
  }

  // Takes: Ray, HitRecord
  // Returns: [Ray (scattered), Vec3 (attenuation)] | nil
  scatter(r_in, rec) {
    //print "LAMBERTIAN.scatter";
    var rand_v = random_unit_vector();
    var scatter_direction = rec.normal + rand_v;

    if (near_zero(scatter_direction)) {
      scatter_direction = rec.normal;
    }
    //var shifted_origin = rec.p + (rec.normal * 0.001);
    var scattered = Ray(rec.p, scatter_direction, r_in.time());
    //print "Lambertian: tex: ", this.tex;
    var attenuation = this.tex.value(rec.u, rec.v, rec.p);
    //print "Lambertian: attuenuation: ", attenuation;
    //print "typeof(attenuation): ", typeof(attenuation);
    return [scattered, attenuation];
  }

  to_string() {
    //return "Lambertian(" + this.albedo.to_string() + ")";
    return "Lambertian()";
  }
}

class Metal < Material {
  // Takes: Vec3, Number
  init(albedo, fuzz) {
    this.albedo = albedo;
    if (fuzz < 1) {
      this.fuzz = 1;
    } else {
      this.fuzz = fuzz;
    }
  }

  // Takes: Ray, HitRecord
  // Returns: [Ray (scattered), Vec3 (attenuation)] | nil
  scatter(r_in, rec) {
    var reflected = reflect(r_in.direction, rec.normal);
    reflected = (random_unit_vector() * this.fuzz) + unit_vector(reflected);
    var scattered = Ray(rec.p, reflected, r_in.time());

    //if (dot(scattered.direction, rec.normal) > 0) {
    if (scattered.direction.dot(rec.normal) > 0) {
      return [scattered, this.albedo];
    }
    return nil;
  }

  to_string() {
    return "Metal()";
  }
}

var vec111 = Vec3(1.0, 1.0, 1.0);

class Dielectric < Material {
  init(ref) {
    this.ref = ref;
  }

  scatter(r_in, rec) {
    var attenuation = vec111;
    var ri = this.ref;
    if (rec.front_face) {
      ri = 1.0 / this.ref;
    } 

    var uv = unit_vector(r_in.direction);
    //var cos_theta = dot(uv * -1.0, rec.normal);
    var cos_theta = (-uv).dot(rec.normal);
    if (cos_theta > 1.0) {
      cos_theta = 1.0;
    } 
    var sin_theta = Math.sqrt(1.0 - cos_theta * cos_theta);

    var cannot_refract = ri * sin_theta > 1.0;
    var direction = nil;

    if (cannot_refract or this.reflectance(cos_theta, ri) > Math.random()) {
      direction = reflect(uv, rec.normal);
    } else {
      direction = refract(uv, rec.normal, ri);
    }
    //var refracted = refract(uv, rec.normal, ri);
    var scattered = Ray(rec.p, direction, r_in.time());

    return [scattered, attenuation];
  }

  // Takes: Number, Number
  // Returns: Number
  reflectance(cosine, refraction_index) {
    var r0 = (1 - refraction_index) / (1 + refraction_index);
    r0 = r0 * r0;
    return r0 + (1 - r0) * ((1 - cosine) ** 5);
  }
}

class Camera {
  init(out) {
    this.white = Vec3(1.0, 1.0, 1.0);
    this.blue = Vec3(0.5, 0.7, 1.0);
    this.red = Vec3(1, 0, 0);
    this.black = Vec3(0, 0, 0);
    this.aspect_ratio = 1.0;
    this.image_width = 100;
    this.out = out;
    this.samples_per_pixel = 10;
    this.max_depth = 10;
    this.stats = []; // store times;
    this.stats.push(0);
    this.vfov = 90;
    this.lookfrom = Vec3(0,0,0);
    this.lookat = Vec3(0,0,1);
    this.vup = Vec3(0,1,0);
    this.u = nil;
    this.v = nil;
    this.w = nil;

    this.defocus_angle = 0;
    this.focus_dist = 10;
    this.defocus_disk_u = nil;
    this.defocus_disk_v = nil;
    this.background = this.black;
  }

  setup() {
    this.image_height = Math.floor(this.image_width / this.aspect_ratio);
    if (this.image_height < 1) {
      this.image_height = 1;
    }

    this.pixel_samples_scale = 1.0 / this.samples_per_pixel;

    this.center = this.lookfrom; 

    //this.focal_length = (this.lookfrom - this.lookat).length();
    var theta = degrees_to_radians(this.vfov);
    var h = Math.tan(theta / 2);
    //this.viewport_height = 2.0 * h * this.focal_length;
    this.viewport_height = 2 * h * this.focus_dist;
    this.viewport_width = this.viewport_height * (this.image_width / this.image_height);

    this.w = unit_vector(this.lookfrom - this.lookat);
    this.u = unit_vector(cross(this.vup, this.w));
    this.v = cross(this.w, this.u);

    //this.viewport_u = Vec3(this.viewport_width, 0, 0);
    this.viewport_u = this.u * this.viewport_width;
    //this.viewport_v = Vec3(0, -this.viewport_height, 0);
    this.viewport_v = (this.v * -1) * this.viewport_height;

    this.pixel_delta_u = this.viewport_u / this.image_width;
    this.pixel_delta_v = this.viewport_v / this.image_height;

    //this.viewport_upper_left = this.center - Vec3(0, 0, this.focal_length) -
    //    this.viewport_u / 2 - this.viewport_v / 2;
    //this.viewport_upper_left = this.center - (this.w * this.focal_length) - 
    //    this.viewport_u / 2 - this.viewport_v / 2;
    this.viewport_upper_left = this.center - (this.w * this.focus_dist) -
        this.viewport_u / 2 - this.viewport_v / 2;
    this.pixel00_loc = this.viewport_upper_left + (this.pixel_delta_u + this.pixel_delta_v) * 0.5;

    var defocus_radius = this.focus_dist * Math.tan(degrees_to_radians(this.defocus_angle / 2));
    this.defocus_disk_u = this.u * defocus_radius;
    this.defocus_disk_v = this.v * defocus_radius;
  }

  render(out, world) { // Hittable
    this.setup();

    var err = File.stderr();

    this.out.write("P3\n${this.image_width} ${this.image_height}\n255\n");
    var pixel_color = black;

    for (var j = 0; j < this.image_height; j = j + 1) {
      var start = clock();
      err.write("\rScanlines remaining: ${this.image_height - j}   ");
      err.flush();
      System.gc();
      print " ";
      print System.mem();
      for (var i = 0; i < this.image_width; i = i + 1) {
        //var pixel_center = this.pixel00_loc + (this.pixel_delta_u * i) + (this.pixel_delta_v * j);
        //var ray_direction = pixel_center - this.center;
        //var r = Ray(this.center, ray_direction);
        //r.set(this.center, ray_direction);
        //pixel_color = this.ray_color(r, world);
        pixel_color = black;
        for (var sample = 0; sample < this.samples_per_pixel; sample = sample + 1) {
          var r = this.get_ray(i, j);
          pixel_color = pixel_color + this.ray_color(r, this.max_depth, world);
        }
        write_color(out, pixel_color * this.pixel_samples_scale);
      }
      var end = clock();
      this.stats.push(end - start);
      err.write("\rScanlines remaining: ${this.image_height -j}  took " + str((end - start)) + "s   ");
    }
    err.write("\rDone.                                \n");
  }

  sample_square() {
    var rx = Math.random();
    var ry = Math.random();
    return Vec3(0, 0, 0);
    return Vec3(rx - 0.5, ry - 0.5, 0);
  }

  get_ray(i, j) {
    var offset = this.sample_square();
    var pixel_sample = this.pixel00_loc + (this.pixel_delta_u * (i + offset.x)) + (this.pixel_delta_v * (j + offset.y));

    var ray_origin = this.center;
    if (this.defocus_angle > 0) {
      ray_origin = this.defocus_disk_sample();
    }

    var ray_direction = pixel_sample - ray_origin;
    var ray_time = Math.random();

    return Ray(ray_origin, ray_direction, ray_time);
  }

  defocus_disk_sample() {
    var p = random_in_unit_disk();
    return this.center + (this.defocus_disk_u * p[0]) + (this.defocus_disk_v * p[1]);
  }

  ray_color(r, depth, world) { // Ray, Hittable
    if (depth <= 0) {
      return this.black;
    }

    var rec = world.hit(r, 0.01, infinity);
    if (!rec)
      return this.background;

    var emission_color = rec.mat.emitted(rec.u, rec.v, rec.p);

    var res = rec.mat.scatter(r, rec);
    if (!res) {
      //return this.ray_color(res[0], depth - 1, world) * res[1];
      return emission_color;
    }

    var scatter_color;
    scatter_color = res[1] * this.ray_color(res[0], depth - 1, world);

    return emission_color + scatter_color;
  }
}

fun bouncing_spheres(out) {
  var world = Hittable();
  var world3 = Hittable();

  var checker = Checker(0.32, dark_square, light_square);
  //checker.set_colors(dark_square, light_square);
  var ground = Lambertian(Vec3(0.5, 0.5, 0.5));
  ground.set_texture(checker);
  world.add(Sphere(Vec3(0, -1000, 0), 1000, ground));
  world3.add(Sphere(Vec3(0, -1000, 0), 1000, ground));

  print System.mem();
  var vec420 = Vec3(4, 0.2, 0);

  for (var a = -11; a < 11; a = a + 1) {
    for (var b  = -11; b < 11; b = b + 1) {
      var choose_mat = Math.random();
      var center = Vec3(a + 0.9 * Math.random(), 0.2, b + 0.9 * Math.random());

      if ((center - vec420).length() > 0.9) {
        var sphere_mat = nil;


        if (choose_mat < 0.8) {
          var albedo = Vec3(Math.random(), Math.random(), Math.random()) *
              Vec3(Math.random(), Math.random(), Math.random());
          sphere_mat = Lambertian(albedo);
          var center2 = center + Vec3(0, rmm(0, 0.5), 0);
          var sp = Sphere(center, 0.2, sphere_mat);
          sp.set_motion(center2);
          world.add(Sphere(center, 0.2, sphere_mat));
          world.add(sp);
        } else if (choose_mat < 0.95) {
          var albedo = Vec3(rmm(0.5,1), rmm(0.5, 1), rmm(0.5,1));
          var fuzz = rmm(0, 0.5);
          sphere_mat = Metal(albedo, fuzz);
          world.add(Sphere(center, 0.2, sphere_mat));
        } else {
          sphere_mat = Dielectric(1.5);
          world.add(Sphere(center, 0.2, sphere_mat));
        }
      }
    }
  }

  print System.mem();
  var mat1 = Dielectric(1.5);
  world.add(Sphere(Vec3(0, 1, 0), 1.0, mat1));
  //world3.add(Sphere(Vec3(0, 1, 0), 1.0, mat1));

  var mat2 = Lambertian(Vec3(0.4, 0.2, 0.1));
  world.add(Sphere(Vec3(-4, 1, 0), 1.0, mat2));
  //world3.add(Sphere(Vec3(-4, 1, 0), 1.0, mat2));

  var mat3 = Metal(Vec3(0.7, 0.6, 0.5), 0.0);
  world.add(Sphere(Vec3(4, 1, 0), 1.0, mat3));
  //world3.add(Sphere(Vec3(4, 1, 0), 1.0, mat3));

  var world2 = BVHNode(world.objects, 0, world.objects.len());

  var cam = Camera(out);

  print System.mem();
  cam.aspect_ratio = 16.0 / 9.0;
  cam.image_width = 1200;
  cam.samples_per_pixel = 500;
  cam.max_depth = 50;
  cam.background = Vec3(0.70, 0.80, 1.00);

  cam.vfov = 20;
  cam.lookfrom = Vec3(13, 2, 3);
  cam.lookat = Vec3(0, 0, 0);
  cam.vup = Vec3(0,1,0);

  cam.defocus_angle = 0.6;
  cam.focus_dist = 10.0;

  cam.render(out, world2);

  print cam.stats;
}

