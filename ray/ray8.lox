import "image";

var infinity = 1.0 / 0.0;
var neg_infinity = -1.0 / 0.0;


fun checker1(u, v, p) {
  var sines = Math.sin(10 * p.x) * Math.sin(10 * p.y) * Math.sin(10 * p.z);
  if (sines < 0) {
    return dark_square;
  }
  return light_square;
}

fun Interval(min, max) {
  return [min, max];
}

var interval_universe = Interval(neg_infinity, infinity);
var interval_empty = Interval(infinity, neg_infinity);

var err = File.stderr();

fun rmm(min, max) {
  return min + (max - min) * Math.random();
}

//fun random_vec() {
//  return Vec3(Math.random(), Math.random(), Math.random());
//}

fun random_vec_m(min, max) {
  return Vec3(rmm(min, max), rmm(min, max), rmm(min, max));
}

fun cross(u, v) {
  return Vec3(u.y * v.z - u.z * v.y,
              u.z * v.x - u.x * v.z,
              u.x * v.y - u.y * v.x);
}

fun unit_vector(v) {
  return v / v.length();
}

fun random_in_unit_disk() {
  while (true) {
    var p = Vec3(rmm(-1,1), rmm(-1,1), 0);
    if (p.length_squared() < 1) {
      return p;
    }
  }
}

// Vec3, Vec3
fun reflect(v, n) {
  //return v - n * dot(v, n) * 2;
  return v - n * v.dot(n) * 2;
}

// Vec3, Vec3, Number
fun refract(uv, n, etai) {
  //var uvn = uv * -1;
  //var cos_theta = dot(uv * -1.0, n);
  var cos_theta = (-uv).dot(n);
  if (cos_theta > 1.0) {
    cos_theta = 1.0;
  } 

  var r_out_perp = (uv + (n * cos_theta)) * etai;
  var r_out_parallel = n * (-Math.sqrt(Math.abs(1.0 - r_out_perp.length_squared())));
  return r_out_perp + r_out_parallel;
}

var epsilon = 1e-160;

fun random_unit_vector() {
  while (true) {
    var p = random_vec_m(-1, 1);
    var lensq = p.length_squared();
    if (epsilon < lensq and lensq <= 1) {
      return p / Math.sqrt(lensq);
    }
  }
}

fun random_on_hemisphere(normal) { // Vec3
  var on_unit_sphere = random_unit_vector();
  if (on_unit_sphere.dot(normal) > 0.0) {
    return on_unit_sphere;
  } else {
    return Vec3(-on_unit_sphere.x, -on_unit_sphere.y, -on_unit_sphere.z);
  }
}

var intensity = Interval(0.000, 0.999);
var intensity_low = 0.000;
var intensity_high = 0.999;

fun linear_to_gamma(d) {
  if (d > 0) {
    return Math.sqrt(d);
  }

  return 0;
}

fun write_color(out, color) {
  var r = linear_to_gamma(color.x);
  var g = linear_to_gamma(color.y);
  var b = linear_to_gamma(color.z);

  var rbyte = Math.floor(256 * interval_clamp_var(intensity_low, intensity_high, r));
  var gbyte = Math.floor(256 * interval_clamp_var(intensity_low, intensity_high, g));
  var bbyte = Math.floor(256 * interval_clamp_var(intensity_low, intensity_high, b));

  out.write(str(rbyte) + " " + str(gbyte) + " " + str(bbyte) + "\n");
}

fun dot(u, v) {
  return u.x * v.x + u.y * v.y + u.z * v.z;
}

fun overlaps_var(t1_min, t1_max, t2_min, t2_max) {
}

fun expand(tmin, tmax, delta) {
  var padding = delta / 2;
  return [tmin - padding, tmax + padding];
}

// Takes: Interval [min, max], Interval [min, max]
// Returns: Interval [min, max]
fun interval_mm(a, b) {
  var min = a[0];
  if (b[0] < a[0]) min = b[0];

  var max = a[1];
  if (b[1] > a[1]) max = b[1];

  return [min, max];
}

fun near_zero(v) {
  var s = 1e-8;
  return (Math.abs(v.x) < s) and (Math.abs(v.y) < s) and (Math.abs(v.z) < s);
}

class Perlin {
  init() {
    this.point_count = 256;
    this.randvec = [0; 256];
    this.perm_x = [0; 256];
    this.perm_y = [0; 256];
    this.perm_z = [0; 256];

    for (var i = 0; i < this.point_count; i = i + 1) {
      this.randvec[i] = unit_vector(random_vec_m(-1,1));
    }

    this.perlin_generate_perm(this.perm_x);
    this.perlin_generate_perm(this.perm_y);
    this.perlin_generate_perm(this.perm_z);
  }

  noise(p) {
    var u = p.x - Math.floor(p.x);
    var v = p.y - Math.floor(p.y);
    var w = p.z - Math.floor(p.z);
    //print "p: ", p;
    //print "u: ", u, " v: ", v, " w: ", w;
    //u = u*u*(3-2*u);
    //v = v*v*(3-2*v);
    //w = w*w*(3-2*w);

    //var i = Math.floor(4*p.x) & 255;
    //var j = Math.floor(4*p.y) & 255;
    //var k = Math.floor(4*p.z) & 255;
    //print "NOISE: i: ", i, " j: ", j, " k: ", k;
    //print "NOISE: perm_x[i]: ", this.perm_x[i], " perm_y[j]: ", this.perm_y[j],
    //  " perm_z[k]: ", this.perm_z[k];

    var i = Math.floor(p.x);
    var j = Math.floor(p.y);
    var k = Math.floor(p.z);

    var c = [0; 8];
    //for (var di = 0; di < 2; di = di + 1) {
    //  for (var dj = 0; dj < 2; dj = dj + 1) {
    //    for (var dk = 0; dk < 2; dk = dk + 1) {
    //      c[4*di + 2*dj + dk] = this.randf[
    //        this.perm_x[(i + di) & 255] ^
    //          this.perm_y[(j + dj) & 255] ^
    //          this.perm_z[(k + dk) & 255]
    //      ];
    //    }
    //  }
    //}
    //return this.randf[this.perm_x[i] ^ this.perm_y[j] ^ this.perm_z[k]];
    c = [
      this.randvec[this.perm_x[(i+0)&255] ^ this.perm_y[(j+0)&255] ^ this.perm_z[(k+0)&255]], // c[0][0][0]
      this.randvec[this.perm_x[(i+0)&255] ^ this.perm_y[(j+0)&255] ^ this.perm_z[(k+1)&255]], // c[0][0][1]
      this.randvec[this.perm_x[(i+0)&255] ^ this.perm_y[(j+1)&255] ^ this.perm_z[(k+0)&255]], // c[0][1][0]
      this.randvec[this.perm_x[(i+0)&255] ^ this.perm_y[(j+1)&255] ^ this.perm_z[(k+1)&255]], // c[0][1][1]
      this.randvec[this.perm_x[(i+1)&255] ^ this.perm_y[(j+0)&255] ^ this.perm_z[(k+0)&255]], // c[1][0][0]
      this.randvec[this.perm_x[(i+1)&255] ^ this.perm_y[(j+0)&255] ^ this.perm_z[(k+1)&255]], // c[1][0][1]
      this.randvec[this.perm_x[(i+1)&255] ^ this.perm_y[(j+1)&255] ^ this.perm_z[(k+0)&255]], // c[1][1][0]
      this.randvec[this.perm_x[(i+1)&255] ^ this.perm_y[(j+1)&255] ^ this.perm_z[(k+1)&255]]  // c[1][1][1]
    ];

    return this.perlin_interp(c, u, v, w);
  }

  // Takes: Vec3, Number
  // Returns: Number
  turb(p, depth) {
    var accum = 0.0;
    var temp_p = p;
    var weight = 1.0;

    for (var i = 0; i < depth; i = i + 1) {
      accum = accum + weight * this.noise(temp_p);
      weight = weight * 0.5;
      temp_p = temp_p * 2;
    }
    return Math.abs(accum);
  }

  perlin_generate_perm(p) {
    for (var i = 0; i < this.point_count; i = i + 1) {
      p[i] = i;
    }

    this.permute(p, this.point_count);
  }

  permute(p, n) {
    for (var i = n - 1; i > 0; i = i - 1) {
      var target = Math.floor(rmm(0, i));
      var tmp = p[i];
      p[i] = p[target];
      p[target] = tmp;
    }
  }

  perlin_interp(c, u, v, w) {
    var uu = u*u*(3-2*u);
    var vv = v*v*(3-2*v);
    var ww = w*w*(3-2*w);
    var accum = 0.0;

    for (var i = 0; i < 2; i = i + 1) {
      for (var j = 0; j < 2; j = j + 1) {
        for (var k = 0; k < 2; k = k + 1) {
          var weight_v = Vec3(u-i, v-j, w-k);
          accum = accum + (i*uu + (1-i)*(1.0-uu)) *
            (j*vv + (1-j)*(1.0-vv)) *
            (k*ww + (1-k)*(1.0-ww)) * c[i*4 + j*2 + k].dot(weight_v);
        }
      }
    }
    return accum;
  }
}

class Material {
  emitted(u, v, p) {
    return Vec3(0,0,0);
  }

  scatter(r_in, rec) {
    return false;
  }
}

class Noise_Texture < Material {
  init(scale) {
    this.scale = scale;
    this.noise = Perlin();
    this.white = Vec3(1,1,1);
    this.gray = Vec3(0.5, 0.5, 0.5);
  }

  value(u, v, p) {
    //return this.white * this.noise.noise(p);
    //return this.white * this.noise.noise(this.scale * p);
    //return this.white * 0.5 * (1.0 + this.noise.noise(this.scale*p));
    //return this.white * this.noise.turb(p, 7);
    return this.gray * (1 + Math.sin(this.scale * p.z + 10 * this.noise.turb(p, 7)));
  }
}

class Hittable {
  init() {
    this.objects = [];
    this.bbox = nil;
  }

  clear()  {
    this.objects = [];
  }

  add(object) {
    this.objects.push(object);
    var bbox = Aabb();
    if (this.bbox == nil) {
      bbox = object.bbox;
    } else {
      bbox.set_box_aabb(this.bbox, object.bbox);
    }
    this.bbox = bbox;
  }

  // Takes: Ray, Number, Number
  hit(r, ray_t_min, ray_t_max) {
    var hit_anything = false;
    var closest_so_far = ray_t_max;
    var final_record = nil;

    for (var i = 0; i < this.objects.len(); i = i + 1) {
      var object = this.objects[i];
      //if (has_method(object, "hit")) {
          //print object;
          var rec = object.hit(r, ray_t_min, closest_so_far);
          //print rec;
          if (rec != nil and rec != false) {
            hit_anything = true;
            closest_so_far = rec.t;
            final_record = rec;
          }
       //}
    }

    return final_record;
  }
}

fun degrees_to_radians(degrees) {
  return degrees * Math.pi() / 180.0;
}

class Translate < Hittable {
  // Takes: Hittable, Vec3
  init(object, offset) {
    super.init();
    this.object = object;
    this.offset = offset;
    //this.bbox = object.bounding_box().add(offset);
    this.bbox = object.bounding_box() + offset;
  }

  hit(r, ray_t_min, ray_t_max) {
    var offset_r = Ray(r.origin - offset, r.direction, r.time());
    var rec = object.hit(offset_r, ray_t_min, ray_t_max);
    if (!rec)
      return false;

    rec.p = rec.p + offset;

    return rec;
  }

  bounding_box() {
    return this.bbox;
  }
}

class BVHNode < Hittable {
  init(objects, start, end) {
    super.init();
    
    //for (var i = start; i < end; i = i + 1) {
    //  this.bbox.set_box_aabb(this.bbox, objects[i].bbox);
    //}

    var axis = Math.floor(rmm(0, 3));

    var object_span = end - start;


    if (object_span == 1) {
      this.left = objects[start];
      this.right = objects[start];
    } else if (object_span == 2) {
      this.left = objects[start];
      this.right = objects[start + 1];
    } else {
      var comparator = fun(a, b) {
        var a_val;
        var b_val;
        if (axis == 0) {
          a_val = a.bbox.x[0];
          b_val = b.bbox.x[0];
        } else if (axis == 1) {
          a_val = a.bbox.y[0];
          b_val = b.bbox.y[0];
        } else {
          a_val = a.bbox.z[0];
          b_val = b.bbox.z[0];
        }

        if (a_val < b_val) {
          return -1;
        }
        if (a_val > b_val) {
          return 1;
        }
        return 0;
      };

      objects.sort(comparator);
      var mid = start + Math.floor(object_span / 2);
      this.left = BVHNode(objects, start, mid);
      this.right = BVHNode(objects, mid, end);
      this.bbox = Aabb();
      this.bbox.set_box_aabb(this.left.bbox, this.right.bbox);
    }

    //this.bbox.set_box_aabb(this.left.bbox, this.right.bbox);
    //this.bbox.set_box_aabb(this.left.bbox, this.right.bbox);
    this.bbox = Aabb();
    this.bbox.x = [this.left.bbox.x[0], this.left.bbox.x[1]];
    this.bbox.y = [this.left.bbox.y[0], this.left.bbox.y[1]];
    this.bbox.z = [this.left.bbox.z[0], this.left.bbox.z[1]];

    this.bbox.set_box_aabb(this.bbox, this.right.bbox);
  }

  hit(r, ray_t_min, ray_t_max) {
    if (!this.bbox.hit(r, ray_t_min, ray_t_max)) {
      return false;
    }

    var hit_left = this.left.hit(r, ray_t_min, ray_t_max);
    var current_max = ray_t_max;
    if (hit_left) current_max = hit_left.t;

    var hit_right = this.right.hit(r, ray_t_min, current_max);

    if (hit_right) return hit_right;
    return hit_left;
  }
}

class Aabb {
  init() {
    this.x = [infinity, neg_infinity];
    this.y = [infinity, neg_infinity];
    this.z = [infinity, neg_infinity];
    this.pad_to_minimums();
  }

  // Takes: 3 interval arrays, [min, max]
  set_box_interval(x, y, z) {
    if (typeof(x) == "ARRAY" and x.len() == 2) this.x = x;
    if (typeof(y) == "ARRAY" and y.len() == 2) this.y = y;
    if (typeof(z) == "ARRAY" and z.len() == 2) this.z = z;
    this.pad_to_minimums();
  }

  // Takes: Vec3, Vec3
  set_box_vec(a, b) {
    // set x
    if (a.x <= b.x) {
      this.x = [a.x, b.x];
    } else {
      this.x = [b.x, a.x];
    }
    // set y
    if (a.y <= b.y) {
      this.y = [a.y, b.y];
    } else {
      this.y = [b.y, a.y];
    }
    // set z
    if (a.z <= b.z) {
      this.z = [a.z, b.z];
    } else  {
      this.z = [b.z, a.z];
    }
    this.pad_to_minimums();
  }

  set_box_aabb(box0, box1) {
    this.x = interval_mm(box0.x, box1.x);
    this.y = interval_mm(box0.y, box1.y);
    this.z = interval_mm(box0.z, box1.z);
  }

  // Takes: Number
  // Returns: Array[min, max]
  axis_interval(n) {
    if (n == 1)
      return this.y;
    if (n == 2)
      return this.z;
    return this.x;
  }

  __add__(v) {
    var ab = Aabb();
    ab.x = [this.bbox.x[0] + v.x, this.bbox.x[1] + v.x];
    ab.y = [this.bbox.y[0] + v.y, this.bbox.y[1] + v.y];
    ab.z = [this.bbox.z[0] + v.z, this.bbox.z[1] + v.z];
    return ab;
  }

  // Takes: Vec3
  add(v) {
    var ab = Aabb();
    ab.x = [this.bbox.x[0] + v.x, this.bbox.x[1] + v.x];
    ab.y = [this.bbox.y[0] + v.y, this.bbox.y[1] + v.y];
    ab.z = [this.bbox.z[0] + v.z, this.bbox.z[1] + v.z];
    return ab;
  }

  longest_axis() {
    if ((this.x[1] - this.x[0]) > (this.y[1] - this.y[0])) {
      if ((this.x[1] - this.x[0]) > (this.z[1] - this.z[0]))
        return 0;
      else
        return 2;
    } else {
      if ((this.y[1] - this.y[0]) > (this.z[1] - this.z[0]))
        return 1;
      else
        return 2;
    }
  }

  pad_to_minimums() {
    var delta = 0.0001;
    if (interval_size(this.x) < delta)
      this.x = expand(this.x[0], this.x[1], delta);
    if (interval_size(this.y) < delta)
      this.y = expand(this.y[0], this.y[1], delta);
    if (interval_size(this.z) < delta)
      this.z = expand(this.z[0], this.z[1], delta);
  }

  hit(r, ray_t_min, ray_t_max) {
    var ray_orig = r.origin;
    var ray_dir = r.direction;
    var tmin = ray_t_min;
    var tmax = ray_t_max;

    for (var axis = 0; axis < 3; axis = axis + 1) {
      var ax = this.axis_interval(axis);
      //var adinv = 1.0 / (ray_dir[axis] + 0.001);
      var d = ray_dir[axis];

      if (Math.abs(d) < 0.0000001) {
        if (ray_orig[axis] < ax[0] or ray_orig[axis] > ax[1]) return false;
      } else {
        var adinv = 1.0 / d;
        var t0 = (ax[0] - ray_orig[axis]) * adinv;
        var t1 = (ax[1] - ray_orig[axis]) * adinv;

        //var t_near = Math.min(t0, t1);
        //var t_far = Math.max(t0, t1);
        if (t0 < t1) {
          if (t0 > tmin) tmin = t0;
          if (t1 < tmax) tmax = t1;
        } else {
          if (t1 > tmin) tmin = t1;
          if (t0 < tmax) tmax = t0;
        }

        if (tmax <= tmin) return false;
      }
    }
    return true;
  }
}

class Ray {
  init(origin, direction, tm) { 
    this.origin = origin;
    this.direction = direction;
    this.tm = tm;
  }

  set(origin, direction) {
    this.origin = origin;
    this.direction = direction;
  }

  time() {
    return this.tm;
  }

  at(t) {
    return this.origin + this.direction * t;
  }

  to_string() {
    //return "Ray(${this.origin}, ${this.direction})";
    return "Ray()";
  }
}

