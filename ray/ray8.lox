// Takes: Vec3, Vec3, Material
// Returns: Hittable
fun box(a, b, mat) {
  var sides = Hittable();

  var min = Vec3(Math.min(a.x, b.x), Math.min(a.y, b.y), Math.min(a.z, b.z));
  var max = Vec3(Math.max(a.x, b.x), Math.max(a.y, b.y), Math.max(a.z, b.z));

  var dx = Vec3(max.x - min.x, 0, 0);
  var dy = Vec3(0, max.y - min.y, 0);
  var dz = Vec3(0, 0, max.z - min.z);

  sides.add(Quad(Vec3(min.x, min.y, max.z),  dx,  dy, mat));    // front
  sides.add(Quad(Vec3(max.x, min.y, max.z), -dz,  dy, mat));    // right
  sides.add(Quad(Vec3(max.x, min.y, min.z), -dx,  dy, mat));    // back
  sides.add(Quad(Vec3(min.x, min.y, min.z),  dz,  dy, mat));    // left
  //sides.add(Quad(Vec3(min.x, max.y, max.z),  dx, -dz, mat));    // top
  sides.add(Quad(Vec3(min.x, max.y, min.z),  dx,  dz, mat));    // top
  //sides.add(Quad(Vec3(min.x, min.y, min.z),  dx,  dz, mat));    // bottom
  sides.add(Quad(Vec3(min.x, min.y, max.z),  dx, -dz, mat));    // bottom

  return sides;
}

