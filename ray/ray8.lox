fun quads(out) {
  var world = Hittable();

  var left_red = Lambertian(Vec3(1.0, 0.2, 0.2));
  var back_green = Lambertian(Vec3(0.2, 1.0, 0.2));
  var right_blue = Lambertian(Vec3(0.2, 0.2, 1.0));
  var upper_orange = Lambertian(Vec3(1.0, 0.5, 0.0));
  var lower_teal = Lambertian(Vec3(0.2, 0.8, 0.8));

  world.add(Quad(Vec3(-3,-2, 5), Vec3(0, 0,-4), Vec3(0, 4, 0), left_red));
  world.add(Quad(Vec3(-2,-2, 0), Vec3(4, 0, 0), Vec3(0, 4, 0), back_green));
  world.add(Quad(Vec3( 3,-2, 1), Vec3(0, 0, 4), Vec3(0, 4, 0), right_blue));
  world.add(Quad(Vec3(-2, 3, 1), Vec3(4, 0, 0), Vec3(0, 0, 4), upper_orange));
  world.add(Quad(Vec3(-2,-3, 5), Vec3(4, 0, 0), Vec3(0, 0,-4), lower_teal));

  var cam = Camera(out);
  print System.mem();

  cam.aspect_ratio = 1.0;
  cam.image_width = 400;
  cam.samples_per_pixel = 100;
  cam.max_depth = 50;
  cam.background = Vec3(0.70, 0.80, 1.00);

  cam.vfov = 80;
  cam.lookfrom = Vec3(0,0,9);
  cam.lookat = Vec3(0,0,0);
  cam.vup = Vec3(0,1,0);

  cam.defocus_angle = 0;

  cam.render(out, world);

  print cam.stats;
}

fun simple_light(out) {
  var world = Hittable();

  var pertext = Noise_Texture(4);
  var t1 = Lambertian(Vec3(0,0,0));
  t1.set_texture(pertext);
  world.add(Sphere(Vec3(0, -1000, 0), 1000, t1));
  world.add(Sphere(Vec3(0,2,0), 2, t1));

  var difflight = Diffuse_Light(Vec3(4,4,4));
  world.add(Sphere(Vec3(0,7,0), 2, difflight));
  world.add(Quad(Vec3(3,1,-2), Vec3(2, 0, 0), Vec3(0, 2, 0), difflight));

  var cam = Camera(out);
  print System.mem();

  cam.aspect_ratio = 1.0;
  cam.image_width = 400;
  cam.samples_per_pixel = 100;
  cam.max_depth = 50;
  cam.background = Vec3(0,0,0);
  //cam.background = Vec3(0.20, 0.20, 0.20);

  cam.vfov = 20;
  cam.lookfrom = Vec3(26,3,6);
  cam.lookat = Vec3(0,2,0);
  cam.vup = Vec3(0,1,0);

  cam.defocus_angle = 0;

  cam.render(out, world);

  print cam.stats;
}

fun cornell_box(out) {
  var world = Hittable();

  var red = Lambertian(Vec3(0.65, 0.5, 0.5));
  var white = Lambertian(Vec3(0.73, 0.73, 0.73));
  var green = Lambertian(Vec3(0.12, 0.45, 0.15));
  var light = Diffuse_Light(Vec3(15,15,15));
  var glow = Diffuse_Light(Vec3(20,0,0));

  var b1 = box(Vec3(130, 0, 65), Vec3(295, 165, 230), glow);
  var bv1 = BVHNode(b1.objects, 0, b1.objects.len());
  var b2 = box(Vec3(265, 0, 295), Vec3(430, 330, 460), glow);
  var bv2 = BVHNode(b2.objects, 0, b2.objects.len());

  world.add(bv1);
  //for (var i = 0; i < b1.objects.len(); i = i + 1)
  //  world.add(b1.objects[i]);
  world.add(bv2);
  //for (var i = 0; i < b2.objects.len(); i = i + 1)
  //  world.add(b1.objects[i]);

  //world.add(Quad(Vec3(200, 0, 200), Vec3(100, 0, 0), Vec3(0, 300, 0), white));

  world.add(Quad(Vec3(0, 0, 0), Vec3(0, 555, 0), Vec3(0, 0, 555), red)); // right

  world.add(Quad(Vec3(555, 0, 0), Vec3(0, 0, 555), Vec3(0, 555, 0), green)); // left
  //world.add(Quad(Vec3(0, 0, 0), Vec3(0, 555, 0), Vec3(0, 0, 555), green)); // left

  world.add(Quad(Vec3(343, 554, 332), Vec3(-130, 0, 0), Vec3(0, 0, -105), light)); // light

  world.add(Quad(Vec3(0, 0, 555), Vec3(0, 555, 0), Vec3(555, 0, 0), white)); // back

  world.add(Quad(Vec3(0, 555, 0), Vec3(555, 0, 0), Vec3(0, 0, 555), white)); // ceiling

  //world.add(Quad(Vec3(555, 555, 555), Vec3(-555, 0, 0), Vec3(0, 0, -555), white)); // 
  //world.add(Quad(Vec3(555, 555, 555), Vec3(555, 0, 0), Vec3(0, 0, 555), white)); // 
  world.add(Quad(Vec3(0, 0, 0), Vec3(0, 0, 555), Vec3(555, 0, 0), white)); // floor


  print "Creating bounding boxes";
  var world2 = BVHNode(world.objects, 0, world.objects.len());
  print "Done.";

  var cam = Camera(out);
  print System.mem();

  cam.aspect_ratio = 1.0;
  cam.image_width = 400;
  cam.samples_per_pixel = 100;
  cam.max_depth = 50;
  cam.background = Vec3(0,0,0);

  cam.vfov = 40;
  cam.lookfrom = Vec3(278, 278, -800);
  cam.lookat = Vec3(278, 278, 0);
  cam.vup = Vec3(0,1,0);

  cam.defocus_angle = 0;

  cam.render(out, world);

  print cam.stats;
}

