@var infinity = 1.0 / 0.0;
var neg_infinity = -1.0 / 0.0;

fun Interval(min, max) {
  return [min, max];
}

var interval_universe = Interval(neg_infinity, infinity);
var interval_empty = Interval(infinity, neg_infinity);

var err = File.stderr();

fun rmm(min, max) {
  return min + (max - min) * Math.random();
}

class Vec3 {
  init(x, y, z) {
    this.x = x;
    this.y = y;
    this.z = z;
  }

  add(v) {
    return Vec3(this.x + v.x, this.y + v.y, this.z + v.z);
  }
  
  __add__(v) {
    if (isnumber(v)) {
      return Vec3(this.x + v, this.y + v, this.z + v);
    }
    return Vec3(this.x + v.x, this.y + v.y, this.z + v.z);
  }

  __sub__(v) {
    if (isnumber(v)) {
      return Vec3(this.x - v, this.y - v, this.z - v);
    }
    return Vec3(this.x - v.x, this.y - v.y, this.z - v.z);
  }

  minus(v) {
    return Vec3(this.x - v.x, this.y - v.y, this.z - v.z);
  }

  mult(d) {
    return Vec3(this.x * d, this.y * d, this.z * d);
  }

  __mul__(d) {
    if (isnumber(d)) {
      return Vec3(this.x * d, this.y * d, this.z * d);
    }
    return Vec3(this.x * d.x, this.y * d.y, this.z * d.z);
    //return this;
  }

  dot(v) {
    return this.x * v.x + this.y * v.y + this.z * v.z;
  }

  neg() {
    return Vec3(-this.x, -this.y, -this.z);
  }

  __neg__() {
    return Vec3(-this.x, -this.y, -this.z);
  }

  div(d) {
    return Vec3(this.x / d, this.y / d, this.z / d);
  }

  __div__(d) {
    //return this * 1/d;
    return Vec3(this.x / d, this.y / d, this.z / d);
  }

  set(x, y, z) {
    this.x = x;
    this.y = y;
    this.z = z;
    return this;
  }

  length() {
    return Math.sqrt(this.length_squared());
  }

  length_squared() {
    return this.x * this.x + this.y * this.y + this.z * this.z;
  }

  random() {
    this.x = Math.random();
    this.y = Math.random();
    this.z = Math.random();
    return this;
  }

  random_m(min, max) {
    this.x = rmm(min, max);
    this.y = rmm(min, max);
    this.z = rmm(min, max);
    return this;
  }

  display() {
    return "Vec3(${this.x}, ${this.y}, ${this.z})";
  }

  near_zero() {
    var s = 1e-5;
    return (Math.abs(this.x) < s) and (Math.abs(this.y) < s) and (Math.abs(this.z) < s);
  }
}

fun random_vec() {
  return Vec3(Math.random(), Math.random(), Math.random());
}

fun random_vec_m(min, max) {
  return Vec3(rmm(min, max), rmm(min, max), rmm(min, max));
}

fun cross(u, v) {
  return Vec3(u.y * v.z - u.z * v.y,
              u.z * v.x - u.x * v.z,
              u.x * v.y - u.y * v.x);
}

fun unit_vector(v) {
  return v / v.length();
}

fun random_in_unit_disk() {
  while (true) {
    var p = Vec3(rmm(-1,1), rmm(-1,1), 0);
    if (p.length_squared() < 1) {
      return p;
    }
  }
}

// Vec3, Vec3
fun reflect(v, n) {
  return v - n * dot(v, n) * 2;
}

// Vec3, Vec3, Number
fun refract(uv, n, etai) {
  //var uvn = uv * -1;
  var cos_theta = dot(uv * -1.0, n);
  if (cos_theta > 1.0) {
    cos_theta = 1.0;
  } 

  var r_out_perp = (uv + (n * cos_theta)) * etai;
  var r_out_parallel = n * (-Math.sqrt(Math.abs(1.0 - r_out_perp.length_squared())));
  //print "square: ", (r_out_perp + r_out_parallel).length_squared();
  return r_out_perp + r_out_parallel;
}

var epsilon = 1e-160;

fun random_unit_vector() {
  while (true) {
    var p = random_vec_m(-1, 1);
    var lensq = p.length_squared();
    if (epsilon < lensq and lensq <= 1) {
      return p / Math.sqrt(lensq);
    }
  }
}

fun random_on_hemisphere(normal) { // Vec3
  var on_unit_sphere = random_unit_vector();
  if (dot(on_unit_sphere, normal) > 0.0) {
    return on_unit_sphere;
  } else {
    return Vec3(-on_unit_sphere.x, -on_unit_sphere.y, -on_unit_sphere.z);
  }
}

