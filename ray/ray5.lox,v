class Lambertian {
  init(albedo) {
    this.albedo = albedo;
  }

  // Takes: Ray, HitRecord
  // Returns: [Ray (scattered), Vec3 (attenuation)] | nil
  scatter(r_in, rec) {
    var scatter_direction = rec.normal + random_unit_vector();
    if (scatter_direction.near_zero()) {
      scatter_direction = rec.normal;
    }
    var scattered = Ray(rec.p, scatter_direction);
    return [scattered, this.albedo];
  }

  display() {
    return "Lambertian(" + this.albedo.display() + ")";
  }
}

class Metal {
  init(albedo) {
    this.albedo = albedo;
  }

  // Takes: Ray, HitRecord
  // Returns: [Ray (scattered), Vec3 (attenuation)] | nil
  scatter(r_in, rec) {
    var reflected = reflect(r_in.direction, rec.normal);
    var scattered = Ray(rec.p, reflected);

    return [scattered, this.albedo];
  }

  display() {
    return "Metal()";
  }
}

