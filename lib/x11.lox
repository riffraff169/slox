import "ffi";
require("multiffi.lox");

class X11 {
  init() {
    this.ffi = MultiFFI([
        "libX11.so.6",
        "libX11.so"
    ]);

    this.fnOpenDisplay = this.ffi.bind("XOpenDisplay", "pointer", ["string"]);
    this.fnCloseDisplay = this.ffi.bind("XCloseDisplay", "int32", ["pointer"]);
    this.fnDefaultScreen = this.ffi.bind("XDefaultScreen", "int32", ["pointer"]);
    //this.fnDefaultRootWindow = this.ffi.bind("XDefaultRootWindow", "uint64", ["pointer"]);
    this.fnDefaultVisual = this.ffi.bind("XDefaultVisual", "pointer", ["pointer", "int32"]);

    this.fnScreenOfDisplay = this.ffi.bind("XScreenOfDisplay", "pointer", ["pointer", "int32"]);
    this.fnRootWindowOfScreen = this.ffi.bind("XRootWindowOfScreen", "uint64", ["pointer"]);
    this.fnFlush = this.ffi.bind("XFlush", "int32", ["pointer"]);

    this.fnCreateSimpleWindow = this.ffi.bind(
        "XCreateSimpleWindow",
        "uint64",
        [
        "pointer",  // Display* dpy
        "uint64", // Window parent (root)
        "int32", // int x
        "int32", // int y
        "uint32", // unsigned int width
        "uint32", // unsigned int height
        "uint32", // unsigned int border_width
        "uint64", // unsigned long border
        "uint64" // unsigned long background
        ]
        );

    this.fnMapWindow = this.ffi.bind("XMapWindow", "int32", ["pointer", "uint64"]);
    this.fnUnmapWindow = this.ffi.bind("XUnmapWindow", "int32", ["pointer", "uint64"]);
    this.fnDestroyWindow = this.ffi.bind("XDestroyWindow", "int32", ["pointer", "uint64"]);

    this.fnSelectInput = this.ffi.bind("XSelectInput", "int32", ["pointer", "uint64", "int64"]);
    this.fnNextEvent = this.ffi.bind("XNextEvent", "int32", ["pointer", "pointer"]);
    this.fnPending = this.ffi.bind("XPending", "int32", ["pointer"]);

    this.fnInternAtom = this.ffi.bind("XInternAtom", "uint64", ["pointer", "string", "int32"]);
    this.fnSetWMProtocols = this.ffi.bind("XSetWMProtocols", "int32", ["pointer", "pointer", "pointer", "int32"]);

    // Common Event Masks
    this.KeyPressMask        = 1;          // 1L << 0
    this.KeyReleaseMask      = 2;          // 1L << 1
    this.ButtonPressMask     = 4;          // 1L << 2
    this.ButtonReleaseMask   = 8;          // 1L << 3
    this.ExposureMask        = 32768;      // 1L << 15
    this.StructureNotifyMask = 131072;     // 1L << 17

    // Common Event Types
    this.KeyPress         = 2;
    this.KeyRelease       = 3;
    this.ButtonPress      = 4;
    this.ButtonRelease    = 5;
    this.Expose           = 12;
    this.DestroyNotify    = 17;
    this.ClientMessage    = 33;

    this.dpy = nil;
  }

  openDisplay(name) {
    this.dpy = this.fnOpenDisplay(name);
    return this.dpy;
  }

  closeDisplay(dpy) {
    return this.fnCloseDisplay(dpy);
  }

  defaultScreen(dpy) {
    return this.fnDefaultScreen(dpy);
  }

  screenOfDisplay(dpy, screenNum) {
    return this.fnScreenOfDisplay(dpy, screenNum);
  }

  rootWindowOfScreen(screenPtr) {
    return this.fnRootWindowOfScreen(screenPtr);
  }

  rootWindow(dpy, screenNum) {
    var scrPtr = this.screenOfDisplay(dpy, screenNum);
    if (scrPtr == nil) return 0;
    return this.rootWindowOfScreen(scrPtr);
  }

  flush(dpy = nil) {
    if (dpy != nil) {
      this.fnFlush(dpy);
    } else if (this.dpy != nil) {
      this.fnFlush(this.dpy);
    }
  }
  /*

  defaultRootWindow(dpy) {
    return this.fnDefaultRootWindow(dpy);
  }
  */

  defaultVisual(dpy, screen) {
    return this.fnDefaultVisual(dpy, screen);
  }

  createSimpleWindow(dpy, parent, x, y, width, height, borderWidth, border, background) {
    return this.fnCreateSimpleWindow(dpy, parent, x, y, width, height, borderWidth, border, background);
  }

  selectInput(dpy, win, mask) {
    return this.fnSelectInput(dpy, win, mask);
  }

  mapWindow(dpy, win) {
    return this.fnMapWindow(dpy, win);
  }

  nextEvent(dpy, eventBuffer) {
    return this.fnNextEvent(dpy, eventBuffer);
  }

  internAtom(dpy, name, onlyIfExists = true) {
    return this.fnInternAtom(dpy, name, onlyIfExists ? 1 : 0);
  }

  setWMProtocols(dpy, win, protocolsArrayPtr, count) {
    return this.fnSetWMProtocols(dpy, win, protocolsArrayPtr, count);
  }
}


