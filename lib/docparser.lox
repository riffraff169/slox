class MethodDoc {
  init(name) {
    this.name = name;
    this.description = [];
    this.requiredArgs = [];
    this.optionalArgs = [];
    this.returns = [];
  }
}

class ClassDoc {
  init(name) {
    this.name = name;
    this.description = [];
    this.requiredArgs = [];
    this.optionalArgs = [];
    this.methods = [];
    this.returns = [];
  }
}

class FunctionDoc {
  init(name) {
    this.name = name;
    this.description = [];
    this.requiredArgs = [];
    this.optionalArgs = [];
    this.returns = [];
  }
}

class DocParser {
  init() {
    this.classes = [];
    this.globalFunctions = [];

    this.currentClass = nil;
    this.currentTarget = nil; // ClassDoc, MethodDoc, or FunctionDoc
    this.section = "NONE";    // "DESC", "REQUIRED", "OPTIONAL", "RETURNS"
  }

  findClass(name) {
    for (var i = 0; i < this.classes.length(); i += 1) {
      if (this.classes[i].name == name) {
        return this.classes[i];
      }
    }
    return nil;
  }

  parseLines(lines) {
    for (var i = 0; i < lines.length(); i = i + 1) {
      this.processLine(lines[i]);
    }
    this.closeTarget();
    return this;
  }

  processLine(line) {
    // 1. Class Header: //@ ClassName
    if (line.slice(0, 3) == "//@") {
      this.closeTarget();
      var className = line.slice(3).trim();

      var existing = this.findClass(className);
      if (existing) {
        this.currentClass = existing;
      } else {
        this.currentClass = ClassDoc(className);
        this.classes.push(this.currentClass);
      }

      this.currentTarget = this.currentClass;
      this.section = "DESC";
      return;
    }

    // 2. Method Header: //: methodName or //: Class.methodName
    if (line.slice(0, 3) == "//:") {
      this.closeTarget();
      var methodName = line.slice(3).trim();

      // Strip class prefix if written as Class.method
      var parts = methodName.split(".");
      if (parts.length() > 1) {
        methodName = parts[1];
      }

      var method = MethodDoc(methodName);
      if (this.currentClass != nil) {
        this.currentClass.methods.push(method);
      }
      this.currentTarget = method;
      this.section = "DESC";
      return;
    }

    // 3. Global Function Header: //= functionName(args)
    if (line.slice(0, 3) == "//=") {
      this.closeTarget();
      var funcName = line.slice(3).trim();
      var func = FunctionDoc(funcName);
      this.globalFunctions.push(func);
      this.currentTarget = func;
      this.section = "DESC";
      return;
    }

    // 4. Content Line: // Content
    if (line.slice(0, 2) == "//") {
      if (this.currentTarget == nil) return;

      var content = line.slice(2).trim();

      // Section transitions
      if (content == "Required args:" or content == "Required args" or
          content == "Requires:" or content == "Requires") {
        this.section = "REQUIRED";
        return;
      }

      if (content.slice(0, 9) == "Requires:") {
        this.section = "REQUIRED";
        var val = content.slice(9).trim();
        if (val.length() > 0) {
          this.currentTarget.requiredArgs.push(val);
        }
        return;
      }

      if (content == "Optional args:" or content == "Option args:" or
          content == "Optional args" or content == "Optional:" or content == "Optional") {
        this.section = "OPTIONAL";
        return;
      }

      if (content.slice(0, 9) == "Optional:") {
        this.section = "OPTIONAL";
        var val = content.slice(9).trim();
        if (val.length() > 0) {
          this.currentTarget.optionalArgs.push(val);
        }
        return;
      }

      // Exact match section header: // Returns:
      if (content == "Returns:" or content == "Returns" or content == "Return:" or
          content == "Return") {
        this.section = "RETURNS";
        return;
      }

      // Inline match: // Returns: Type
      if (content.slice(0, 8) == "Returns:") {
        this.section = "RETURNS";
        var retVal = content.slice(8).trim();
        if (retVal.length() > 0) {
          this.currentTarget.returns.push(retVal);
        }
        return;
      }

      // Append content to active section
      if (content.length() > 0) {
        if (this.section == "DESC") {
          this.currentTarget.description.push(content);
        } else if (this.section == "REQUIRED") {
          this.currentTarget.requiredArgs.push(content);
        } else if (this.section == "OPTIONAL") {
          this.currentTarget.optionalArgs.push(content);
        } else if (this.section == "RETURNS") {
          this.currentTarget.returns.push(content);
        }
      }
      return;
    }

    // 5. Code line or blank line -> close current target block
    this.closeTarget();
  }

  closeTarget() {
    this.currentTarget = nil;
    this.section = "NONE";
  }

  generateMarkdown() {
    var lines = [];

    if (this.classes.length() > 0) {
      lines.push("# Classes");
      lines.push("");
      for (var i = 0; i < this.classes.length(); i = i + 1) {
        var cls = this.classes[i];
        lines.push("## Class: " + cls.name);
        this.appendDocBodyLines(cls, lines);

        if (cls.methods.length() > 0) {
          lines.push("### Methods");
          lines.push("");
          for (var j = 0; j < cls.methods.length(); j = j + 1) {
            var m = cls.methods[j];
            lines.push("#### `" + cls.name + "." + m.name + "`");
            this.appendDocBodyLines(m, lines);
          }
        }
        lines.push("---");
        lines.push("");
      }
    }

    if (this.globalFunctions.length() > 0) {
      lines.push("# Global Functions");
      lines.push("");
      for (var i = 0; i < this.globalFunctions.length(); i = i + 1) {
        var fn = this.globalFunctions[i];
        lines.push("## `" + fn.name + "`");
        this.appendDocBodyLines(fn, lines);
        lines.push("---");
        lines.push("");
      }
    }
    return lines.join("\n");
  }

  appendDocBodyLines(target, lines) {
    if (target.description.length() > 0) {
      for (var i = 0; i < target.description.length(); i = i + 1) {
        lines.push(target.description[i]);
      }
      lines.push("");
    }

    if (target.requiredArgs.length() > 0) {
      lines.push("**Required Arguments:**");
      for (var i = 0; i < target.requiredArgs.length(); i = i + 1) {
        lines.push("  - `" + target.requiredArgs[i] + "`");
      }
      lines.push("");
    }

    if (target.optionalArgs.length() > 0) {
      lines.push("**Optional Arguments:**");
      for (var i = 0; i < target.optionalArgs.length(); i = i + 1) {
        lines.push("  - `" + target.optionalArgs[i] + "`");
      }
      lines.push("");
    }

    if (target.returns.length() > 0) {
      lines.push("**Returns:**");
      for (var i = 0; i < target.returns.length(); i += 1) {
        lines.push("  - `" + target.returns[i] + "`");
      }
      lines.push("");
    }
  }
}
