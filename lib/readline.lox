import "ffi";
require("multiffi.lox");

//@ Readline
// Readline class for adding readline support. Uses FFI.
class Readline {
  init() {
    this.ffi = MultiFFI([
        "libreadline.so"
    ]);

    this.fnReadline = this.ffi.bind("readline", "string", ["string"]);
    this.fnAddHistory = this.ffi.bind("add_history", "void", ["string"]);
  }

  //: prompt
  // Read a line with a prompt
  // Requires:
  //   String: p
  // Returns:
  //   String
  prompt(p) {
    var line = this.fnReadline(p);
    if (line == nil) return nil;

    if (line.length() > 0) {
      this.fnAddHistory(line);
    }
    return line;
  }
}
