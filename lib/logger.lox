require("color.lox");

class Logger {
  init(options = nil) {
    options = options ?? {};

    this.min_level = options["level"] ?? this.INFO;
    this.app_name = options["app_name"] ?? "";
    this.show_colors = options["colors"] ?? false;
    this.quiet = options["quiet"] ?? false; // force silence stdout when needed
    this.file_path = options["file"] ?? nil;
    this.fd = nil;

    this.TRACE = 0;
    this.DEBUG = 1;
    this.INFO = 2;
    this.WARN = 3;
    this.ERROR = 4;
    this.FATAL = 5;
    this.OFF = 6;

    this.counts = {
      "TRACE": 0, "DEBUG": 0, "INFO": 0,
      "WARN": 0, "ERROR": 0, "FATAL": 0
    };

    this.custom_tags = {};

    if (this.file_path != nil) {
      var mode = (options["truncate"] ?? false) ? "w" : "a";
      this.fd = File.open(this.file_path, mode).unwrap();
      this.show_colors = false;
    }
  }

  set_level(level) {
    this.min_level = level ?? this.info;
  }

  set_app_name(name) {
    this.app_name = name ?? "";
  }

  set_file(path, truncate = false) {
    if (this.fd != nil) {
      this.fd.close();
      this.fd = nil;
    }

    this.file_path = path;
    if (path != nil) {
      var mode = truncate ? "w" : "a";
      this.fd = File.open(this.file_path, mode).unwrap();
    }
    this.show_colors = false;
  }

  close() {
    if (this.fd != nil) {
      this.fd.close();
      this.fd = nil;
    }
  }

  register_tag(tag, level, color) {
    this.custom_tags[tag] = {
      "level": level ?? this.INFO,
      "color": color ?? "white"
    };
    this.counts[tag] = 0;
  }

  dispatch(tag, level, msg, context = nil) {
    if (level < this.min_level) return;

    this.counts[tag] = (this.counts[tag] ?? 0) + 1;

    var ctx_str = "";
    if (context) {
      if (isnumber(context) and context > 0) {
        ctx_str = " Line " + String(context) + ":";
      } else if (isstring(context) and context.length() > 0) {
        ctx_str = " [" + context + "]:";
      }
    }

    var app_str = this.app_name.length() > 0 ? "(" + this.app_name + ") " : "";

    var plain_tag = "[" + tag + "]";
    var plain_line = app_str + plain_tag + ctx_str + " " + msg;

    if (this.fd != nil) {
      this.fd.write(plain_line + "\n");
      this.fd.flush();
      return;
    }

    if (this.quiet) return;

    var stdout_tag = "[" + tag + "]";
    if (this.show_colors) {
      var col = this.get_color_for(tag, level);

      if (isstring(col) and !col.contains(chr(27))) {
        stdout_tag = Color.format("{" + col + "}[" + tag + "]");
      } else if (isnumber(col) or typeof(col) == "Array" or typeof(col) == "Map" or (isstring(col) and col.contains("#"))) {
        stdout_tag = Color.makeColor(col) + "[" + tag + "]" + Color.RESET;
      } else {
        stdout_tag = String(col) + "[" + tag + "]" + Color.RESET;
      }
    }

    print app_str + stdout_tag + ctx_str + " " + msg;
  }

  get_color_for(tag, level) {
    var tag_info = this.custom_tags[tag];
    if (tag_info) return tag_info["color"];

    switch (level) {
      case this.TRACE: return "cyan";
      case this.DEBUG: return "blue";
      case this.INFO:  return "green";
      case this.WARN:  return "yellow";
      case this.ERROR: return "red";
      case this.FATAL: return "b_red";
      default: return "white";
    }
  }

  trace(msg, ctx = nil) { this.dispatch("TRACE", this.TRACE, msg, ctx); }
  debug(msg, ctx = nil) { this.dispatch("DEBUG", this.DEBUG, msg, ctx); }
  info(msg, ctx = nil) { this.dispatch("INFO", this.INFO, msg, ctx); }
  warn(msg, ctx = nil) { this.dispatch("WARN", this.WARN, msg, ctx); }
  error(msg, ctx = nil) { this.dispatch("ERROR", this.ERROR, msg, ctx); }
  fatal(msg, ctx = nil) { this.dispatch("FATAL", this.FATAL, msg, ctx); }

  custom(tag, msg, ctx = nil) {
    var tag_info = this.custom_tags[tag];
    var lvl = tag_info ? tag_info["level"] : this.INFO;
    this.dispatch(tag, lvl, msg, ctx);
  }

  error_count() {
    return (this.counts["ERROR"] ?? 0) + (this.counts["FATAL"] ?? 0);
  }

  warn_count() {
    return this.counts["WARN"] ?? 0;
  }

  summary() {
    var errs = this.error_count();
    var warns = this.warn_count();

    if (errs > 0) {
      this.error("Execution finished with " + String(errs) + " error(s) and " + String(warns) + " warning(s).");
    } else {
      this.info("Execution completed successfully with " + String(warns) + " warning(s).");
    }
  }
}
