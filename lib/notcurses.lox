import "ffi";

require("multiffi.lox");

class PixelBuffer {
  init(width, height) {
    this.width = width;
    this.height = height;
    // 4 bytes per pixel (rgba)
    var totalBytes = width * height * 4;
    this.pixels = [0; totalBytes];
    //this.clear(0x1e1e1eff); // dark grey canvas
  }

  clear(rgba) {
    var totalBytes = this.width * this.height + 4;

    if (rgba <= 255) {
      // 1. single bytes value (0 - 255); set every byte index directly
      for (var i = 0; i < totalBytes; i += 1) {
        this.pixels[i] = rgba;
      }
    } else {
      // 2. packed 32-bit rgba integer (eg 0x1e1e1eff)
      var r = (rgba >> 24) & 0xff;
      var g = (rgba >> 16) & 0xff;
      var b = (rgba >> 8) & 0xff;
      var a = rgba & 0xff;

      for (var i = 0; i < totalBytes; i += 4) {
        this.pixels[i] = r;
        this.pixels[i + 1] = g;
        this.pixels[i + 2] = b;
        this.pixels[i + 3] = a;
      }
    }
  }

  setPixel(x, y, rgba) {
    if (x < 0 or x >= this.width or y < 0 or y >= this.height) return;

    var offset = (y * this.width + x) * 4;

    var r;
    var g;
    var b;
    var a;

    if (typeof(rgba) == "Array") {
      r, g, b, a = rgba;
    } else {
      r = (rgba >> 24) & 0xff;
      g = (rgba >> 16) & 0xff;
      b = (rgba >> 8) & 0xff;
      a = rgba & 0xff;
    }

    this.pixels[offset] = r;
    this.pixels[offset + 1] = g;
    this.pixels[offset + 2] = b;
    this.pixels[offset + 3] = a;
    /*
    this.buf.write_uint8(idx, r);
    this.buf.write_uint8(idx + 1, g);
    this.buf.write_uint8(idx + 2, b);
    this.buf.write_uint8(idx + 3, a);
    */
  }

  getBuffer() {
    return this.pixels.to_string();
  }
}

class Visual {
  const BLIT_DEFAULT = 0;
  const BLIT_1x1 = 1;
  const BLIT_2x1 = 2; // half-blocks (2 vertical pixels per char cell)
  const BLIT_2x2 = 3;
  const BLIT_3x2 = 4;
  const BLIT_4x2 = 5;
  const BLIT_BRAILLE = 6;
  const BLIT_PIXEL = 7; // sixel / kitty graphics
  const BLIT_4x1 = 8;
  const BLIT_8x1 = 9;

  const SCALE_NONE = 0;
  const SCALE_SCALE = 1;
  const SCALE_STRETCH = 2;
  const SCALE_NONE_HIRES = 3;

  init(pixelBuffer, nc) {
    this.pixelBuffer = pixelBuffer;
    this.nc = nc;
    this.ffi = nc.ffi;

    this.fnFromRgba = this.ffi.bind("ncvisual_from_rgba", "pointer",
        ["pointer", "int32", "int32", "int32"]);
    this.fnBlit = this.ffi.bind("ncvisual_blit", "pointer",
        ["pointer", "pointer", "pointer"]);
    this.fnDestroy = this.ffi.bind("ncvisual_destroy", "void", ["pointer"]);
    this.fnResize = this.ffi.bind("ncvisual_resize", "int", ["pointer", "int", "int"]);

    var stride = pixelBuffer.width * 4;
    var rawBuf = pixelBuffer.getBuffer();

    this.ptr = this.fnFromRgba(rawBuf, pixelBuffer.height, stride, pixelBuffer.width);

    /*
    if (this.ptr == nil) {
      print ("ERROR: ncvisual_from_rgba returned NULL!");
    } else {
      print "SUCCESS: ncvisual created at handle: " + this.ptr;
    }
    */
  }

  resize(rows, cols) {
    return this.fnResize(this.ptr, rows, cols);
  }

  pixelGeom() {
    return this.nc.stdplane.pixelGeom();
  }

  resizeCells(plane, celLRows, cellCols) {
    var bufY = Buffer.alloc(4);
    var bufX = Buffer.alloc(4);

    this.nc.stdplane.fnPixelGeom(this.nc.stdplane, nil, nil, bufY, bufX, nil, nil);

    var cdimy = Struct.unpackNative("I", bufY)[0];
    var cdimx = Struct.unpackNative("I", bufX)[0];

    if (cdimy > 0 and cdimx > 0) {
      var pixelRows = cdimy * cellRows;
      var pixelCols = cdimx * cellCols;

      return this.ffi.fnResize(this.ptr, pixelRows, pixelCols);
    }
    return -1;
  }

  blit(plane, blitMode = 2, scale = 2, y = 0, x = 0, leny = 0, lenx = 0) {
    if (this.ptr == nil) return nil;

    var flags = 0;
    if (blitMode == 7 or blitMode == this.BLIT_PIXEL)
      flags = 32;

    // pack options struct for notcurses
    // ncplane*, scaling, y, x, beg_y, beg_x, len_y, len_x, blitmode
    // Q - n (ncplane*)               (0..7)
    // I - scaling (0 = NSCALE_NONE)  (8..11)
    // i - y (0)                      (12..15)
    // i - x (0)                      (16..19)
    // i - begy (0)                   (20..23)
    // i - begx (0)                   (24..27)
    // i - leny (0)                   (28..31)
    // i - lenx (0)                   (32..35)
    // I - blitter (blitMode)         (36..39)
    // Q - flags (0)                  (40..47)
    // I - transcolor (0)             (48..51)
    // i - pxoffy (0)                 (52..55)
    // i - pxoffx (0)                 (56..59)
    // 4x

    var opts = Struct.pack("Q I i i i i i i I Q I i i 4x", [
        plane.ptr,  // target plane
        scale,          // NCSCALE_NONE
        y, x,       // y, x
        0, 0,       // beg_y, beg_x
        leny, lenx,       // len_y, len_x
        blitMode,   // NCBLIT_PIXEL (or 2)
        flags,          // flags
        0,          // transcolor
        0, 0        // pxoff_y, pxoff_x
    ]);

    var pl = this.fnBlit(this.nc.ptr, this.ptr, opts);
    if (pl != nil and pl != 0) {
        return Plane(pl, this.ffi);
    }
    return nil;
  }

  destroy() {
    if (this.ptr != nil) {
      this.fnDestroy(this.ptr);
      this.ptr = nil;
    }
  }
}

class Plane {
  const NCALIGN_UNALIGNED = 0;
  const NCALIGN_LEFT = 1;
  const NCALIGN_CENTER = 2;
  const NCALIGN_RIGHT = 3;

  init(ptr, ffiLib) {
    this.ptr = ptr;
    this.ffi = ffiLib;

    this.fnCreate = ffiLib.bind("ncplane_create", "pointer", ["pointer", "string"]);
    this.fnPutStr = ffiLib.bind("ncplane_putstr", "int32", ["pointer", "string"]);
    this.fnPutStrAlign = ffiLib.bind("ncplane_putstr_aligned", "int32", ["pointer", "int32", "int32", "string"]);
    this.fnSetFgRgb = ffiLib.bind("ncplane_set_fg_rgb", "int32", ["pointer", "int32"]);
    this.fnSetBgRgb = ffiLib.bind("ncplane_set_bg_rgb", "int32", ["pointer", "int32"]);
    this.fnErase = ffiLib.bind("ncplane_erase", "void", ["pointer"]);
    this.fnDestroy = ffiLib.bind("ncplane_destroy", "int32", ["pointer"]);
    this.fnBox = ffiLib.bind("ncplane_box", "int32",
        ["pointer", // plane
        "string", // ul
        "string", // ur
        "string", // ll
        "string", // lr
        "string", // hl
        "string", // vl
        "int32", // ystop
        "int32", // xstop
        "int32" // edges / ctlflags
        ]);

    this.fnPutStrYx = ffiLib.bind("ncplane_putstr_yx", "int32", ["pointer", "int32", "int32", "string"]);
    this.fnDimY = ffiLib.bind("ncplane_dim_y", "int32", ["pointer"]);
    this.fnDimX = ffiLib.bind("ncplane_dim_x", "int32", ["pointer"]);
    this.fnYx = ffiLib.bind("ncplane_yx", "void", ["pointer", "pointer", "pointer"]);
    this.fnAtYxCell = ffiLib.bind("ncplane_at_yx_cell", "int32", ["pointer", "int32", "int32", "pointer"]);

    this.fnCellLoad = ffiLib.bind("nccell_load", "int32", ["pointer", "pointer", "string"]);

    this.fnCellRelease = ffiLib.bind("nccell_release", "void", ["pointer", "pointer"]);
    this.fnChannels = ffiLib.bind("ncplane_channels", "uint64", ["pointer"]);

    this.fnMoveYx = ffiLib.bind("ncplane_move_yx", "int32", ["pointer", "int32", "int32"]);
    this.fnMoveRelYx = ffiLib.bind("ncplane_move_rel", "int32", ["pointer", "int32", "int32"]);
    this.fnSetBgAlpha = ffiLib.bind("ncplane_set_bg_alpha", "int32", ["pointer", "int32"]);
    this.fnSetBase = ffiLib.bind("ncplane_set_base", "int32", ["pointer", "string", "int", "uint64"]);
    this.fnMoveTop = ffiLib.bind("ncplane_move_top", "void", ["pointer"]);
    this.fnMoveBottom = ffiLib.bind("ncplane_move_bottom", "void", ["pointer"]);

    this.fnPixelGeom = ffiLib.bind("ncplane_pixel_geom", "void",
        ["pointer", "pointer", "pointer",
        "pointer", "pointer",
        "pointer", "pointer"]);
  }

  pixelGeom() {
    var bufY = Buffer.alloc(4);
    var bufX = Buffer.alloc(4);

    this.fnPixelGeom(this.ptr, nil, nil, bufY, bufX, nil, nil);

    var cdimy = Struct.unpackNative("I", bufY)[0];
    var cdimx = Struct.unpackNative("I", bufX)[0];
    return [cdimy, cdimx];
  }

  erase() {
    this.fnErase(this.ptr);
  }

  move_top() {
    this.fnMoveTop(this.ptr);
  }

  move_bottom() {
    this.fnMoveBottom(this.ptr);
  }

  set_opaque(r, g, b) {
    this.set_bg(r, g, b);

    // 0 = NCALPHA_OPAQUE
    this.fnSetBgAlpha(this.ptr, 0);

    // set plane base cell to space using current colors
    // stylemask = 0, channels = 0
    this.fnSetBase(this.ptr, " ", 0, 0);

    this.erase();
  }

  move_yx(y, x) {
    this.fnMoveYx(this.ptr, y, x);
  }

  create_child(y, x, rows, cols, flags = 0) {
    //flags = flags ?? 0;
    //if (flags == nil) flags = 0;
    // pack 48-bytes ncplane_options struct
    var opts = Struct.pack("i i i i Q Q Q Q i i", [y, x, rows, cols, 0, 0, 0, flags, 0, 0]);
    var childPtr = this.fnCreate(this.ptr, opts);
    if (childPtr == nil) return nil;
    return Plane(childPtr, this.ffi);
  }

  // either put_str("hello") or put_str(y, x, "hello")
  put_str(a1, a2 = nil, a3 = nil) {
    if (a2 == nil and a3 == nil)
      return this.fnPutStr(this.ptr, a1);
    return this.fnPutStrYx(this.ptr, a1, a2, a3);
  }

  // either string name ("center") or integer alignment enum
  put_str_aligned(y, align, str) {
    if (align == "center") align = this.NCALIGN_CENTER;
    else if (align == "left") align = this.NCALIGN_LEFT;
    else if (align == "right") align = this.NCALIGN_RIGHT;
    return this.fnPutStrAlign(this.ptr, y, align, str);
  }

  set_fg(r, g = nil, b = nil) {
    var rgb = r;
    if (g != nil and b != nil)
      rgb = (r << 16) | (g << 8) | b;
    return this.fnSetFgRgb(this.ptr, rgb);
  }
  set_fgrgb(rgb) { return this.set_fg(rgb); }

  set_bg(r, g = nil, b = nil) {
    var rgb = r;
    if (g != nil and b != nil)
      rgb = (r << 16) |  (g << 8) | b;
    return this.fnSetBgRgb(this.ptr, rgb);
  }
  set_bgrgb(rgb) { return this.set_bg(rgb); }

  destroy() {
    if (this.ptr != nil) {
      var res = this.fnDestroy(this.ptr);
      this.ptr = nil;
      return res;
    }
    return 0;
  }

  createCell(egc, channels) {
    var buf = Buffer.alloc(32);
    this.fnCellLoad(this.ptr, buf, egc);

    var fields = Struct.unpackNative("I B B H Q Q Q", buf);

    fields[4] = channels;

    var cellStr = Struct.packNative("I B B H Q Q Q", fields);

    return [cellStr, buf];
  }

  box(ystop = 0, xstop = 0, rounded = false, edges = 0) {
    var edgesStr = "┌┐└┘─│";

    if (ystop == 0 or xstop == 0) {
      var dim = this.get_dim();
      if (ystop == 0) ystop = dim[0] - 1;
      if (xstop == 0) xstop = dim[1] - 1;
    }

    var channels = this.fnChannels(this.ptr);
    var res = 0;

    var ulObj = rounded ? this.createCell("╭", channels) : this.createCell("┌", channels);
    var urObj = rounded ? this.createCell("╮", channels) : this.createCell("┐", channels);
    var llObj = rounded ? this.createCell("╰", channels) : this.createCell("└", channels);
    var lrObj = rounded ? this.createCell("╯", channels) : this.createCell("┘", channels);
    var hlObj = this.createCell("─", channels);
    var vlObj = this.createCell("│", channels);

    var ctlflags = edges;
    if (rounded)
      ctlflags = ctlflags | 1;
    res = this.fnBox(
        this.ptr,
        ulObj[0], urObj[0], llObj[0], lrObj[0], hlObj[0], vlObj[0],
        ystop, xstop, ctlflags
        );

    this.fnCellRelease(this.ptr, ulObj[1]);
    this.fnCellRelease(this.ptr, urObj[1]);
    this.fnCellRelease(this.ptr, llObj[1]);
    this.fnCellRelease(this.ptr, lrObj[1]);
    this.fnCellRelease(this.ptr, hlObj[1]);
    this.fnCellRelease(this.ptr, vlObj[1]);

    return res;
  }

  get_dim() {
    return [this.fnDimY(this.ptr), this.fnDimX(this.ptr)];
  }

  get_pos() {
    /*
    var yBuf = Struct.packNative("I", [0]);
    var xBuf = Struct.packNative("I", [0]);
    */
    var yBuf = Buffer.alloc(4);
    var xBuf = Buffer.alloc(4);

    this.fnYx(this.ptr, yBuf, xBuf);

    var y = Struct.unpackNative("I", yBuf)[0];
    var x = Struct.unpackNative("I", xBuf)[0];
    return [y, x];
  }

  contains_point(screenY, screenX) {
    var pos = this.get_pos();
    var dim = this.get_dim();
    return (screenY >= pos[0] and screenY < (pos[0] + dim[0]) and
        screenX >= pos[1] and screenX < (pos[1] + dim[1]));
  }

  to_local(screenY, screenX) {
    var pos = this.get_pos();
    return [screenY - pos[0], screenX - pos[1]];
  }
}

class DropdownMenu {
  init(std, cols, menuData) {
    this.std = std;
    this.cols = cols;
    this.menuData = menuData; // array of section maps

    this.activeSection = -1; // -1 = closed, 0..n = open section
    this.activeItem = -1; // active item index in open dropdown
    this.dropdownPlane = nil;

    // calculate section title x-offsets for mouse hit detection
    this.sectionOffsets = [];
    var currentX = 2;
    for (var i = 0; i < menuData.length(); i += 1) {
      this.sectionOffsets.push(currentX);
      // title width + padding spaces
      currentX += menuData[i]["title"].length() + 4;
    }

    // top menu bar
    this.barPlane = std.create_child(0, 0, 1, cols);
    this.draw_bar();
  }

  draw_text_with_hotkey(plane, y, x, text, hotkeyChar, defaultFg, hotkeyFg) {
    var hkLower = (hotkeyChar != nil) ? hotkeyChar.to_lower() : "";
    var hkFound = false;

    for (var i = 0; i < text.length(); i += 1) {
      var ch = chr(text[i]);
      if (!hkFound and hkLower != "" and ch.to_lower() == hkLower) {
        plane.set_fg(hotkeyFg[0], hotkeyFg[1], hotkeyFg[2]);
        plane.put_str(y, x + i, ch);
        hkFound = true;
      } else {
        plane.set_fg(defaultFg[0], defaultFg[1], defaultFg[2]);
        plane.put_str(y, x + i, ch);
      }
    }
  }

  draw_bar() {
    this.barPlane.erase();
    this.barPlane.set_bg(40, 40, 60);

    var currentX = 0;
    this.barPlane.set_fg(220, 220, 220);
    this.barPlane.put_str(0, currentX, " ");
    currentX += 1;

    for (var i = 0; i < this.menuData.length(); i += 1) {
      var sec = this.menuData[i];
      var isSelected = (i == this.activeSection);
      var title = sec["title"];
      var hotkey = sec["hotkey"];

      if (isSelected) {
        this.barPlane.set_bg(70, 70, 110);
        this.barPlane.put_str(0, currentX, " [");
        this.draw_text_with_hotkey(this.barPlane, 0, currentX + 2, title, hotkey, [255, 255, 255], [255, 220, 100]);
        this.barPlane.set_fg(255, 255, 255);
        this.barPlane.put_str(0, currentX + 2 + title.length(), "] ");
      } else {
        this.barPlane.set_bg(40, 40, 60);
        this.barPlane.put_str(0, currentX, "  ");
        this.draw_text_with_hotkey(this.barPlane, 0, currentX + 2, title, hotkey, [220, 220, 220], [255, 220, 100]);
        this.barPlane.set_fg(220, 220, 220);
        this.barPlane.put_str(0, currentX + 2 + title.length(), "  ");
      }
      currentX += title.length() + 4;
    }

    // file
    this.barPlane.set_bg(40, 40, 60);
    if (currentX < this.cols) {
      this.barPlane.put_str(0, currentX, " " * (this.cols - currentX));
    }

    return;
  }

  open_dropdown(sectionIdx) {
    this.close_dropdown();

    if (sectionIdx < 0 or sectionIdx >= this.menuData.length()) return;

    this.activeSection = sectionIdx;
    this.activeItem = 0;

    var sec = this.menuData[sectionIdx];
    var items = sec["items"];

    // compute max width required
    var maxW = 16;
    for (var i = 0; i < items.length(); i += 1) {
      var len = items[i]["label"].length();
      if (len + 6 > maxW) maxW = len + 6;
    }

    var px = this.sectionOffsets[sectionIdx];
    var py = 1; // immediately below the 1-row top bar
    var pRows = items.length() + 2;

    this.dropdownPlane = this.std.create_child(py, px, pRows, maxW);
    this.dropdownPlane.set_opaque(25, 25, 35);

    this.draw_bar();
    this.draw_dropdown();
  }

  draw_dropdown() {
    if (this.dropdownPlane == nil) return;

    this.dropdownPlane.erase();
    this.dropdownPlane.set_opaque(25, 25, 35);
    this.dropdownPlane.set_fg(220, 220, 220);
    this.dropdownPlane.box();

    var items = this.menuData[this.activeSection]["items"];
    var planeWidth = this.dropdownPlane.get_dim()[1];
    var pad = " " * (planeWidth - 2);

    for (var i = 0; i < items.length(); i += 1) {
      var isSelected = (i == this.activeItem);
      var item = items[i];

      if (isSelected) {
        this.dropdownPlane.set_bg(60, 60, 100);
        this.dropdownPlane.put_str(i + 1, 1, pad);
        this.draw_text_with_hotkey(this.dropdownPlane, i + 1, 2, item["label"], item["hotkey"], [255, 255, 255], [255, 220, 100]);
      } else {
        this.dropdownPlane.set_bg(25, 25, 35);
        this.dropdownPlane.put_str(i + 1, 1, pad);
        this.draw_text_with_hotkey(this.dropdownPlane, i + 1, 2, item["label"], item["hotkey"], [200, 200, 200], [255, 220, 100]);
      }
    }
  }

  close_dropdown() {
    if (this.dropdownPlane != nil) {
      this.dropdownPlane.destroy();
      this.dropdownPlane = nil;
    }
    this.activeSection = -1;
    this.activeItem = -1;
    this.draw_bar();
  }

  handle_event(ev) {
    if (ev == nil) return nil;

    // mouse input
    if (ev["is_mouse"]) {
      var mx = ev["x"];
      var my = ev["y"];
      var type = ev["type"];

      // 1. mouse interaction on top bar (row 0)
      if (my == 0 and type == "press") {
        for (var i = 0; i < this.menuData.length(); i += 1) {
          var startX = this.sectionOffsets[i];
          var endX = startX + this.menuData[i]["title"].length() + 4;

          if (mx >= startX and mx < endX) {
            if (this.activeSection == i) {
              this.close_dropdown();
            } else {
              this.open_dropdown(i);
            }
            return nil;
          }
        }
        this.close_dropdown();
        return nil;
      }

      // 2. mouse interaction inside open dropdown window
      if (this.activeSection != -1 and this.dropdownPlane != nil) {
        var px = this.sectionOffsets[this.activeSection];
        var items = this.menuData[this.activeSection]["items"];
        var pRows = items.length() + 2;
        var pCols = this.dropdownPlane.get_dim()[1];

        // check bounds
        if (mx >= px and mx < px + pCols and my >= 1 and my < 1 + pRows) {
          var itemIdx = my - 2;
          if (itemIdx >= 0 and itemIdx < items.length()) {
            this.activeItem = itemIdx;
            this.draw_dropdown();

            if (type == "press") {
              var action = items[itemIdx]["action"];
              this.close_dropdown();
              return action;
            }
          }
          return nil;
        }

        // clicked outside dropdown
        if (type == "press") {
          this.close_dropdown();
        }
      }
      return nil;
    }

    // 3. keyboard shortcuts
    if (ev["type"] == "press") {
      var key = ev["key"];
      var isAlt = ev["alt"];

      if (key == "Esc") {
        if (this.activeSection != -1) {
          this.close_dropdown();
          return nil;
        }
      }

      // 1. f1 activates/toggles menu starting at section 0
      if (key == "F1") {
        if (this.activeSection == -1) {
          this.open_dropdown(0);
        } else {
          this.close_dropdown();
        }
        return nil;
      }

      // 2. alt + section hotey (eg Alt+f, Alt+m)
      if (isAlt or (key != nil and key.length() >= 4 and key.slice(0, 4) == "Alt+")) {
        var cleanKey = key;
        if (isAlt) {
          cleanKey = key;
        } else if (key.length() >= 5) {
          cleanKey = key.slice(4,5);
        }
        //var cleanKey = isAlt ? key : key.slice(4, 5);
        cleanKey = cleanKey.to_lower();

        for (var i = 0; i < this.menuData.length(); i += 1) {
          var secHotkey = this.menuData[i]["hotkey"];
          if (secHotkey != nil and secHotkey.to_lower() == cleanKey) {
            this.open_dropdown(i);
            return nil;
          }
        }
      }
      
      // 3. navigation inside open menu
      if (this.activeSection != -1) {
        var items = this.menuData[this.activeSection]["items"];

        if (key == "Esc") {
          this.close_dropdown();
          return nil;
        }

        if (key == "Down") {
          this.activeItem = (this.activeItem + 1) % items.length();
          this.draw_dropdown();
          return nil;
        }

        if (key == "Up") {
          this.activeItem = (this.activeItem - 1 + items.length()) % items.length();
          this.draw_dropdown();
          return nil;
        }

        if (key == "Right") {
          var nextSec = (this.activeSection + 1) % this.menuData.length();
          this.open_dropdown(nextSec);
          return nil;
        }

        if (key == "Left") {
          var prevSec = (this.activeSection - 1 + this.menuData.length()) % this.menuData.length();
          this.open_dropdown(prevSec);
          return nil;
        }

        if (key == "Enter") {
          if (this.activeItem >= 0 and this.activeItem < items.length()) {
            var action = items[this.activeItem]["action"];
            this.close_dropdown();
            return action;
          }
        }
        // direct single-key shortcut match
        if (key != nil and key.length() == 1) {
          var pressedChar = key.to_lower();
          for (var i = 0; i < items.length(); i += 1) {
            var itemHotkey = items[i]["hotkey"];
            if (itemHotkey != nil and itemHotkey.to_lower() == pressedChar) {
              var action = items[i]["action"];
              this.close_dropdown();
              return action;
            }
          }
        }
      }
    }
    //foo;
    return nil;
  }
}

class Notcurses {
  const NCOPTION_INHIBIT_SETLOCALE    = 0x0001;
  const NCOPTION_NO_CLEAR_BITMAPS     = 0x0002;
  const NCOPTION_NO_WINCH_SIGHANDLER  = 0x0004;
  const NCOPTION_NO_QUIT_SIGHANDLERS  = 0x0008;
  const NCOPTION_SUPPRESS_BANNERS     = 0x0010;
  const NCOPTION_NO_ALTERNATE_SCREEN  = 0x0020;
  const NCOPTION_NO_FONT_CHANGES      = 0x0040;
  const PRETERUNICODEBASE = 1115000;

  const NCMICE_NO_EVENTS = 0;
  const NCMICE_BUTTON_EVENT = 1;
  const NCMICE_MOVE_EVENT = 2;
  const NCMICE_ALL_EVENTS = 3; // NCMICE_BUTTON_EVENT | NCMICE_MOVE_EVENT

  init(flags = nil) {
    if (flags == nil) {
      flags = this.NCOPTION_SUPPRESS_BANNERS | this.NCOPTION_NO_ALTERNATE_SCREEN;
    }

    this.ffi = MultiFFI([
        "libnotcurses-ffi.so",
        "libnotcurses-core.so",
        "libnotcurses.so"]);

    this.fnInit = this.ffi.bind("notcurses_init", "pointer", ["string", "pointer"]);
    this.fnStop = this.ffi.bind("notcurses_stop", "int32", ["pointer"]);
    this.fnRender = this.ffi.bind("notcurses_render", "int32", ["pointer"]);
    this.fnStdPlane = this.ffi.bind("notcurses_stdplane", "pointer", ["pointer"]);
    this.fnGet = this.ffi.bind("notcurses_get", "int32", ["pointer", "pointer", "pointer"]);
    this.fnMiceEnable = this.ffi.bind("notcurses_mice_enable", "int32", ["pointer", "int32"]);
    this.fnMiceDisable = this.ffi.bind("notcurses_mice_disable", "int32", ["pointer"]);

    // pack struct notcurses_options:
    // termtype (NULL), renderfp(NULL), flags, margin_t, margin_r, margin_b, margin_l
    // Q = termtype (null/0)
    // I = loglevel (0) (7 is trace)
    // I I I I = 4 margins (0, 0, 0, 0)
    // I = 4-byte padding for uint64 alignment
    // Q = flags
    var opts = Struct.pack("Q I I I I I I Q", [0, 0, 0, 0, 0, 0, 0, flags]);

    this.ptr = this.fnInit(opts, nil);
    if (this.ptr == nil) {
      print "Failed to initialize Notcurses.";
      return;
    }

    // cache stdplane wrapper
    this.stdplane = Plane(this.fnStdPlane(this.ptr), this.ffi);
    this.inputBuf = nil;
  }

  enable_mouse(enable = true, allow_motion = false) {
    if (!enable) {
      return this.fnMiceDisable(this.ptr) == 0;
    }
    var mode = allow_motion ? this.NCMICE_ALL_EVENTS : this.NCMICE_BUTTON_EVENT;
    if (this.ptr == nil) return false;

    return this.fnMiceEnable(this.ptr, mode) == 0;
  }

  translate_key(k) {
    if (k == nil or k <= 0 or k == this.PRETERUNICODEBASE) return nil;

    if (k == 9) return "Tab";
    if (k == 27) return "Esc";
    if (k == 10 or k == 13) return "Enter";

    // notcurses special keys (PRETERUNICODEBASE offset mapping)
    if (k >= this.PRETERUNICODEBASE) {
      var offset = k - this.PRETERUNICODEBASE;

      if (offset == 1) return "Resize";
      if (offset == 2) return "Up";
      if (offset == 3) return "Right";
      if (offset == 4) return "Down";
      if (offset == 5) return "Left";
      if (offset == 6) return "Insert";
      if (offset == 7) return "Delete";
      if (offset == 8) return "Backspace";
      if (offset == 9) return "PageDown";
      if (offset == 10) return "PageUp";
      if (offset == 11) return "Home";
      if (offset == 12) return "End";
      if (offset == 121) return "Enter";

      // function keys (f00 - f19)
      if (offset >= 20 and offset <= 39) {
        return "F" + String(offset - 20);
      }

      // mouse / scroll wheel
      if (offset >= 200 and offset <= 211) {
        if (offset == 204) return "ScrollUp";
        if (offset == 205) return "ScrollDown";

        if (offset == 200) return "Motion";
        if (offset == 201) return "Button1";
        if (offset == 202) return "Button2";
        if (offset == 203) return "Button3";
        return "Button" + String(offset - 200);
      }
      return nil;
    }

    // standard printable ascii
    if (k >= 32 and k <= 127) {
      return chr(k);
    }

    return nil;
  }

  get_event() {
    if (this.inputBuf == nil) {
      this.inputBuf = Buffer.alloc(64);
    }

    var k = this.fnGet(this.ptr, nil, this.inputBuf);
    if (k <= 0 or k == this.PRETERUNICODEBASE) return nil;

    //var fields = Struct.unpackNative("I I I I I B B B B I", this.inputBuf);
    var fields = Struct.unpackNative("I I I B B B B B B B B I I I I", this.inputBuf);
    
    var id = fields[0];
    var y = fields[1];
    var x = fields[2];
    var alt = fields[8] != 0;
    var shift = fields[9] != 0;
    var ctrl = fields[10] != 0;
    var typeNum = fields[11];
    var modifiers = fields[12];
    var ypx = fields[13];
    var xpx = fields[14];

    if (modifiers != 0) {
      if ((modifiers & 1) != 0) shift = true;
      if ((modifiers & 2) != 0) alt = true;
      if ((modifiers & 4) != 0) ctrl = true;
    }

    var evtype = "press";
    if (typeNum == 2) evtype = "repeat";
    if (typeNum == 3) evtype = "release";

    var isMouse = (id >= this.PRETERUNICODEBASE + 200 and id <= this.PRETERUNICODEBASE + 211);

    return {
      "id": id,
      "key": this.translate_key(id),
      "x": x,
      "y": y,
      "ypx": ypx,
      "xpx": xpx,
      "ctrl": ctrl,
      "alt": alt,
      "shift": shift,
      "type": evtype,
      "modifiers": modifiers,
      "is_mouse": isMouse
    };
  }

  render() {
    return this.fnRender(this.ptr);
  }

  get_stdplane() {
    return this.stdplane;
  }

  get_key_code() {
    return this.fnGet(this.ptr, nil, nil);
  }

  get_key() {
    var ev = this.get_event();
    if (ev == nil) return nil;

    if (ev["type"] == "release") return nil;

    return ev["key"];
  }

  stop() {
    if (this.ptr != nil) {
      this.fnStop(this.ptr);
      this.ptr = nil;
    }
  }
}

if (System.ARGS.length() >= 1 and System.ARGS[0] == "test") {
  var lib = FFI("libnotcurses.so");
  var nc = Notcurses(lib);

  nc.stop();
}
