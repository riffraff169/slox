import "ffi";

require("multiffi.lox");

class Plane {
  const NCALIGN_UNALIGNED = 0;
  const NCALIGN_LEFT = 1;
  const NCALIGN_CENTER = 2;
  const NCALIGN_RIGHT = 3;


  init(ptr, ffiLib) {
    this.ptr = ptr;
    this.ffi = ffiLib;

    this.fnCreate = ffiLib.bind("ncplane_create", "pointer", ["pointer", "string"]);
    this.fnPutStr = ffiLib.bind("ncplane_putstr", "int32", ["pointer", "string"]);
    this.fnPutStrAlign = ffiLib.bind("ncplane_putstr_aligned", "int32", ["pointer", "int32", "int32", "string"]);
    this.fnSetFgRgb = ffiLib.bind("ncplane_set_fg_rgb", "int32", ["pointer", "int32"]);
    this.fnSetBgRgb = ffiLib.bind("ncplane_set_bg_rgb", "int32", ["pointer", "int32"]);
    this.fnErase = ffiLib.bind("ncplane_erase", "void", ["pointer"]);
    this.fnDestroy = ffiLib.bind("ncplane_destroy", "int32", ["pointer"]);
    this.fnBox = ffiLib.bind("ncplane_box", "int32",
        ["pointer", // plane
        "string", // ul
        "string", // ur
        "string", // ll
        "string", // lr
        "string", // hl
        "string", // vl
        "int32", // ystop
        "int32", // xstop
        "int32" // edges / ctlflags
        ]);

    this.fnPutStrYx = ffiLib.bind("ncplane_putstr_yx", "int32", ["pointer", "int32", "int32", "string"]);
    this.fnDimY = ffiLib.bind("ncplane_dim_y", "int32", ["pointer"]);
    this.fnDimX = ffiLib.bind("ncplane_dim_x", "int32", ["pointer"]);
    this.fnYx = ffiLib.bind("ncplane_yx", "void", ["pointer", "pointer", "pointer"]);
    this.fnAtYxCell = ffiLib.bind("ncplane_at_yx_cell", "int32", ["pointer", "int32", "int32", "pointer"]);

    this.fnCellLoad = ffiLib.bind("nccell_load", "int32", ["pointer", "pointer", "string"]);

    this.fnCellRelease = ffiLib.bind("nccell_release", "void", ["pointer", "pointer"]);
    this.fnChannels = ffiLib.bind("ncplane_channels", "uint64", ["pointer"]);
  }

  erase() {
    this.fnErase(this.ptr);
  }

  create_child(y, x, rows, cols, flags = 0) {
    //flags = flags ?? 0;
    //if (flags == nil) flags = 0;
    // pack 48-bytes ncplane_options struct
    var opts = Struct.pack("I I I I Q Q Q Q Q Q", [y, x, rows, cols, 0, 0, 0, flags, 0, 0]);
    var childPtr = this.fnCreate(this.ptr, opts);
    if (childPtr == nil) return nil;
    return Plane(childPtr, this.ffi);
  }

  // either put_str("hello") or put_str(y, x, "hello")
  put_str(a1, a2 = nil, a3 = nil) {
    if (a2 == nil and a3 == nil)
      return this.fnPutStr(this.ptr, a1);
    return this.fnPutStrYx(this.ptr, a1 ,a2, a3);
  }

  // either string name ("center") or integer alignment enum
  put_str_aligned(y, align, str) {
    if (align == "center") align = this.NCALIGN_CENTER;
    else if (align == "left") align = this.NCALIGN_LEFT;
    else if (align == "right") align = this.NCALIGN_RIGHT;
    return this.fnPutStrAlign(this.ptr, y, align, str);
  }

  set_fg(r, g = nil, b = nil) {
    var rgb = r;
    if (g != nil and b != nil)
      rgb = (r << 16) | (g << 8) | b;
    return this.fnSetFgRgb(this.ptr, rgb);
  }
  set_fgrgb(rgb) { return this.set_fg(rgb); }

  set_bg(r, g = nil, b = nil) {
    var rgb = r;
    if (g != nil and b != nil)
      rgb = (r << 16) |  (g << 8) | b;
    return this.fnSetBgRgb(this.ptr, rgb);
  }
  set_bgrgb(rgb) { return this.set_bg(rgb); }

  destroy() {
    if (this.ptr != nil) {
      var res = this.fnDestroy(this.ptr);
      this.ptr = nil;
      return res;
    }
    return 0;
  }

  createCell(egc, channels) {
    var buf = Buffer.alloc(32);
    this.fnCellLoad(this.ptr, buf, egc);

    var fields = Struct.unpackNative("I B B H Q Q Q", buf);

    fields[4] = channels;

    var cellStr = Struct.packNative("I B B H Q Q Q", fields);

    return [cellStr, buf];
  }

  box(ystop = 0, xstop = 0, rounded = false, edges = 0) {
    var edgesStr = "┌┐└┘─│";

    if (ystop == 0 or xstop == 0) {
      var dim = this.get_dim();
      if (ystop == 0) ystop = dim[0] - 1;
      if (xstop == 0) xstop = dim[1] - 1;
    }

    var channels = this.fnChannels(this.ptr);
    var res = 0;

    var ulObj = rounded ? this.createCell("╭", channels) : this.createCell("┌", channels);
    var urObj = rounded ? this.createCell("╮", channels) : this.createCell("┐", channels);
    var llObj = rounded ? this.createCell("╰", channels) : this.createCell("└", channels);
    var lrObj = rounded ? this.createCell("╯", channels) : this.createCell("┘", channels);
    var hlObj = this.createCell("─", channels);
    var vlObj = this.createCell("│", channels);

    var ctlflags = edges;
    if (rounded)
      ctlflags = ctlflags | 1;
    res = this.fnBox(
        this.ptr,
        ulObj[0], urObj[0], llObj[0], lrObj[0], hlObj[0], vlObj[0],
        ystop, xstop, ctlflags
        );

    this.fnCellRelease(this.ptr, ulObj[1]);
    this.fnCellRelease(this.ptr, urObj[1]);
    this.fnCellRelease(this.ptr, llObj[1]);
    this.fnCellRelease(this.ptr, lrObj[1]);
    this.fnCellRelease(this.ptr, hlObj[1]);
    this.fnCellRelease(this.ptr, vlObj[1]);

    return res;
  }

  get_dim() {
    return [this.fnDimY(this.ptr), this.fnDimX(this.ptr)];
  }

  get_pos() {
    /*
    var yBuf = Struct.packNative("I", [0]);
    var xBuf = Struct.packNative("I", [0]);
    */
    var yBuf = Buffer.alloc(4);
    var xBuf = Buffer.alloc(4);

    this.fnYx(this.ptr, yBuf, xBuf);

    var y = Struct.unpackNative("I", yBuf)[0];
    var x = Struct.unpackNative("I", xBuf)[0];
    return [y, x];
  }

  contains_point(screenY, screenX) {
    var pos = this.get_pos();
    var dim = this.get_dim();
    return (screenY >= pos[0] and screenY < (pos[0] + dim[0]) and
        screenX >= pos[1] and screenX < (pos[1] + dim[1]));
  }

  to_local(screenY, screenX) {
    var pos = this.get_pos();
    return [screenY - pos[0], screenX - pos[1]];
  }
}

class Notcurses {
  const NCOPTION_INHIBIT_SETLOCALE    = 0x0001;
  const NCOPTION_NO_CLEAR_BITMAPS     = 0x0002;
  const NCOPTION_NO_WINCH_SIGHANDLER  = 0x0004;
  const NCOPTION_NO_QUIT_SIGHANDLERS  = 0x0008;
  const NCOPTION_SUPPRESS_BANNERS     = 0x0010;
  const NCOPTION_NO_ALTERNATE_SCREEN  = 0x0020;
  const NCOPTION_NO_FONT_CHANGES      = 0x0040;
  const PRETERUNICODEBASE = 1115000;

  const NCMICE_NO_EVENTS = 0;
  const NCMICE_BUTTON_EVENT = 1;
  const NCMICE_MOVE_EVENT = 2;
  const NCMICE_ALL_EVENTS = 3; // NCMICE_BUTTON_EVENT | NCMICE_MOVE_EVENT

  init(flags = nil) {
    if (flags == nil) {
      flags = this.NCOPTION_SUPPRESS_BANNERS | this.NCOPTION_NO_ALTERNATE_SCREEN;
    }

    this.ffi = MultiFFI([
        "libnotcurses-ffi.so",
        "libnotcurses-core.so",
        "libnotcurses.so"]);

    this.fnInit = this.ffi.bind("notcurses_init", "pointer", ["string", "pointer"]);
    this.fnStop = this.ffi.bind("notcurses_stop", "int32", ["pointer"]);
    this.fnRender = this.ffi.bind("notcurses_render", "int32", ["pointer"]);
    this.fnStdPlane = this.ffi.bind("notcurses_stdplane", "pointer", ["pointer"]);
    this.fnGet = this.ffi.bind("notcurses_get", "int32", ["pointer", "pointer", "pointer"]);
    this.fnMiceEnable = this.ffi.bind("notcurses_mice_enable", "int32", ["pointer", "int32"]);
    this.fnMiceDisable = this.ffi.bind("notcurses_mice_disable", "int32", ["pointer"]);

    // pack struct notcurses_options:
    // termtype (NULL), renderfp(NULL), flags, margin_t, margin_r, margin_b, margin_l
    // Q = termtype (null/0)
    // I = loglevel (0)
    // I I I I = 4 margins (0, 0, 0, 0)
    // I = 4-byte padding for uint64 alignment
    // Q = flags
    var opts = Struct.pack("Q I I I I I I Q", [0, 0, 0, 0, 0, 0, 0, flags]);

    this.ptr = this.fnInit(opts, nil);
    if (this.ptr == nil) {
      print "Failed to initialize Notcurses.";
      return;
    }

    // cache stdplane wrapper
    this.stdplane = Plane(this.fnStdPlane(this.ptr), this.ffi);
    this.inputBuf = nil;
  }

  enable_mouse(enable = true, allow_motion = false) {
    if (!enable) {
      return this.fnMiceDisable(this.ptr) == 0;
    }
    var mode = allow_motion ? this.NCMICE_ALL_EVENTS : this.NCMICE_BUTTON_EVENT;
    if (this.ptr == nil) return false;

    return this.fnMiceEnable(this.ptr, mode) == 0;
  }

  translate_key(k) {
    if (k == nil or k <= 0 or k == this.PRETERUNICODEBASE) return nil;

    if (k == 9) return "Tab";
    if (k == 27) return "Esc";
    if (k == 10 or k == 13) return "Enter";

    // notcurses special keys (PRETERUNICODEBASE offset mapping)
    if (k >= this.PRETERUNICODEBASE) {
      var offset = k - this.PRETERUNICODEBASE;

      if (offset == 1) return "Resize";
      if (offset == 2) return "Up";
      if (offset == 3) return "Right";
      if (offset == 4) return "Down";
      if (offset == 5) return "Left";
      if (offset == 6) return "Insert";
      if (offset == 7) return "Delete";
      if (offset == 8) return "Backspace";
      if (offset == 9) return "PageDown";
      if (offset == 10) return "PageUp";
      if (offset == 11) return "Home";
      if (offset == 12) return "End";
      if (offset == 121) return "Enter";

      // function keys (f00 - f19)
      if (offset >= 20 and offset <= 39) {
        return "F" + String(offset - 20);
      }

      // mouse / scroll wheel
      if (offset >= 200 and offset <= 211) {
        if (offset == 204) return "ScrollUp";
        if (offset == 205) return "ScrollDown";

        if (offset == 200) return "Motion";
        if (offset == 201) return "Button1";
        if (offset == 202) return "Button2";
        if (offset == 203) return "Button3";
        return "Button" + String(offset - 200);
      }
      return nil;
    }

    // standard printable ascii
    if (k >= 32 and k <= 127) {
      return chr(k);
    }

    return nil;
  }

  get_event() {
    if (this.inputBuf == nil) {
      this.inputBuf = Buffer.alloc(64);
    }

    var k = this.fnGet(this.ptr, nil, this.inputBuf);
    if (k <= 0 or k == this.PRETERUNICODEBASE) return nil;

    //var fields = Struct.unpackNative("I I I I I B B B B I", this.inputBuf);
    var fields = Struct.unpackNative("I I I B B B B B B B B I I I I", this.inputBuf);
    
    var id = fields[0];
    var y = fields[1];
    var x = fields[2];
    var alt = fields[8] != 0;
    var shift = fields[9] != 0;
    var ctrl = fields[10] != 0;
    var typeNum = fields[11];
    var modifiers = fields[12];
    var ypx = fields[13];
    var xpx = fields[14];

    if (modifiers != 0) {
      if ((modifiers & 1) != 0) shift = true;
      if ((modifiers & 2) != 0) alt = true;
      if ((modifiers & 4) != 0) ctrl = true;
    }

    var evtype = "press";
    if (typeNum == 2) evtype = "repeat";
    if (typeNum == 3) evtype = "release";

    var isMouse = (id >= this.PRETERUNICODEBASE + 200 and id <= this.PRETERUNICODEBASE + 211);

    return {
      "id": id,
      "key": this.translate_key(id),
      "x": x,
      "y": y,
      "ypx": ypx,
      "xpx": xpx,
      "ctrl": ctrl,
      "alt": alt,
      "shift": shift,
      "type": evtype,
      "modifiers": modifiers,
      "is_mouse": isMouse
    };
  }

  render() {
    return this.fnRender(this.ptr);
  }

  get_stdplane() {
    return this.stdplane;
  }

  get_key_code() {
    return this.fnGet(this.ptr, nil, nil);
  }

  get_key() {
    var ev = this.get_event();
    if (ev == nil) return nil;

    if (ev["type"] == "release") return nil;

    return ev["key"];
  }

  stop() {
    if (this.ptr != nil) {
      this.fnStop(this.ptr);
      this.ptr = nil;
    }
  }
}

if (System.ARGS.length() >= 1 and System.ARGS[0] == "test") {
  var lib = FFI("libnotcurses.so");
  var nc = Notcurses(lib);

  nc.stop();
}
