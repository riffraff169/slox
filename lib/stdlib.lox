//@ System
// Part of main core libraries
class System {
  //: stats
  // Get system statistics
  // Returns:
  //   Map
  static stats() {
    return System.sysstats();
  }

  //: get_times
  // Get timings like from time command
  // Returns:
  //   Map
  static get_times() {
    var s = System.sysstats();
    return {
      "real": s["real"],
      "user": s["user"],
      "sys":  s["sys"]
    };
  }

  //: get_memory_mb
  // Get memory usage.
  // Returns:
  //   Float
  static get_memory_mb() {
    var s = System.sysstats();
    return s["maxrss"] / 1024.0;
  }
}

//@ Error
// Error class. Used for throwing errors from so that `catch` can deal with it.
class Error {
  init(msg = "Error") {
    this.message = msg;
  }
}

//@ Iterable
// Mixin class for implementing iterators. Classes include this mixin, then return an iterator.
// This class uses the Iterator class to provide the map and each methods.
// ```
//class Settings {
//  include Iterable;
//
//  init() {
//    this.config = {};
//  }
//
//  set(key, value) {
//    this.config[key] = value;
//  }
//
//  iter() {
//    return MapIterator(this.config);
//  }
//}
//
// Full example in examples/settings.lox
class Iterable {
  //: each
  // Implements each for the iterator.
  // Returns:
  //   Value
  each(fn) {
    var it = this.iter();
    while (!it.done()) {
      fn(it.next());
    }
  }

  //: map
  // Implements map for the iterator.
  // Returns:
  //   Value
  map(fn) {
    var result = [];
    this.each(fun(item) {
        result.push(fn(item));
    });
    return result;
  }
}

//@ ArrayIterator
// The actual iterator for arrays. The class will implement iter(), which will return
// ArrayIterator with the array. 
class ArrayIterator {
  init(array) {
    this.array = array;
    this.index = 0;
    this.current = nil;
  }

  //: done
  // Signifies that there is no more data for the iterator.
  // Returns:
  //   Bool
  done() {
    return this.index >= this.array.length();
  }

  //: next
  // Gets next item.
  // Returns:
  //   Value
  next()  {
    this.current = this.array[this.index];
    this.index += 1;
    return this.current;
  }

  //: key
  // Gets the key, in this case, the index.
  // Returns:
  //   Integer
  key() {
    return this.index - 1;
  }

  //: val
  // Gets the value
  // Returns:
  //   Value
  val() {
    return this.current;
  }
}

//@ MapIterator
// Iterator class for maps.
class MapIterator {
  init(map) {
    this.map = map;
    this.keys = map.keys();
    this.index = 0;
    this.currentKey = nil;
    this.currentVal = nil;
  }

  //: done
  // Signifies that there is no more data for the iterator.
  // Returns:
  //   Bool
  done() {
    return this.index >= this.keys.length();
  }

  //: next
  // Gets next item.
  // Returns:
  //   Array: key, value
  next() {
    this.currentKey = this.keys[this.index];
    this.currentVal = this.map[this.currentKey];
    this.index = this.index + 1;
    return [this.currentKey, this.currentVal];
  }

  //: key
  // Gets the key of the current entry.
  // Returns:
  //   Value
  key() {
    return this.currentKey;
  }

  //: val
  // Gets the value of the current entry.
  // Returns:
  //   Value
  val() {
    return this.currentVal;
  }
}

//@ Map
// Extends the native Map class with an iterator so foreach can traverse it.
class Map {
  iter() {
    return MapIterator(this);
  }
}

//@ FieldIndex
// Mixin (include) that adds custom __geti__ and __seti__ implementations.
// With this, you can access fields of an instance with [], and set with []=.
// Example:
// ```
// class User {
//   include FieldIndex;
//
//   init(name, role) {
//     this.name = name;
//     this.role = role;
//   }
// }
// var u = User("Fred", "Architect");
// print u.name;
// print u["role"];
// u["role"] = "Principal Architect";
// print u["role"];
// ```
class FieldIndex {
  //: __geti__
  // Get value of field
  // Requires:
  //   String: key
  // Returns:
  //   Value
  __geti__(key) {
    return this.get_field(key);
  }

  //: __seti__
  // Set field to value
  // Requires:
  //   String: key
  //   Value: val
  // Returns:
  //   Value
  __seti__(key, value) {
    this.set_field(key, value);
    return this;
  }
}

//@ Serializable
// Add serializing features to a class, with .serialize().
// deserialize() is a separate external function. Used as a mixin.
// Currently broken, needs to be updated to split Integer/Float
class Serializable {
  //: serialize
  // Recursively convert a Value to a String, so it can be written somewhere.
  serialize() {
    fun writeValue(val) {
      if (isstring(val)) {
        return "S" + val.len().to_string() + ":" + val;
      }

      if (isnumber(val)) {
        var numStr = val.to_string();
        return "N" + numStr.len().to_string() + ":" + numStr;
      }

      if (isbool(val)) {
        if (val) return "B1";
        return "B0";
      }

      if (isarray(val)) {
        var res = "A" + val.len.to_string() + ":";
        for (var i = 0; i < val.len(); i += 1) {
          res = res + writeValue(val[i]);
        }
        return res;
      }

      if (ismap(val)) {
        var keys = val.keys();
        var res = "M" + keys.len().to_string() + ":";
        for (var i = 0; i < keys.len(); i += 1) {
          var k = keys[i];
          res = res + writeValue(k) + writeValue(val[k]);
        }
        return res;
      }

      return "Z";
    }

    var className = this.class_name();
    var result = className.len().to_string() + ":" + className;
    
    var fieldList = this.fields();
    result = result + fieldList.len().to_string() + ":";

    for (var i = 0; i < fieldList.len(); i += 1) {
      var name = fieldList[i];
      var val = this.get_field(name);

      result = result + name.len().to_string() + ":" + name;

      result = result + writeValue(val);
    }
    return result;
  }
}

//= deserialize
// Convert a string to its original Value recursively.
// Currently broken.
fun deserialize(data) {
  var offset = 0;

  fun readChunk() {
    var remaining = data.slice(offset, data.len());
    var colonPos = Number(remaining.find(":"));
    var lenStr = remaining.slice(0, colonPos);
    var chunkLen = Number(lenStr);

    var startPos = colonPos + 1;
    var endPos = startPos + chunkLen;
    var chunkData = remaining.slice(startPos, endPos);

    offset = offset + colonPos + 1 + chunkLen;
    return chunkData;
  }

  fun readValue() {
    var typeRemaining = data.slice(offset, data.len());
    var typeMarker = typeRemaining.slice(0, 1);
    offset += 1;

    if (typeMarker == "Z") {
      return nil;
    }

    if (typeMarker == "S") {
      return readChunk();
    }

    if (typeMarker == "N") {
      return Number(readChunk());
    }

    if (typeMarker == "b") {
      var boolVal = data.slice(offset, offset + 1);
      offset += 1;

      return boolVal == "1";
    }

    if (typeMarker == "A") {
      var remaining = data.slice(offset, data.len());
      var colonPos = Number(remaining.find(":"));
      var elementCount = Number(remaining.slice(0, colonPos));
      offset = offset + colonPos + 1;

      var arr = [];

      for (var i = 0; i < elementCount; i += 1) {
        arr.push(readValue());
      }

      return arr;
    }

    if (typeMarker == "M") {
      var remaining = data.slice(offset, data.len());
      var colonPos = Number(remaining.find(":"));
      var pairCount = Number(remaining.slice(0, colonPos));
      offset = offset + colonPos + 1;

      var map = {};

      for (var i = 0; i < pairCount; i += 1) {
        var key = readValue();
        var val = readValue();
        map[key] = val;
      }
      return map;
    }

    print "Deserialization Error: Unknown type marker '", typeMarker, "'";
    return nil;
  }

  // 1. parse class name
  var className = readChunk();
  var instance = create_instance(className);
  if (instance == nil) {
    print "Deserialization Error: Class '", className, "' not registered in globals.";
    return nil;
  }

  // 2. parse field count
  var remaining = data.slice(offset, data.len());
  var colonPos = Number(remaining.find(":"));
  //var fieldCount = Number(readChunk());
  var fieldCount = Number(remaining.slice(0, colonPos));

  offset = offset + colonPos + 1;

  // 3. loop through fields
  for (var i = 0; i < fieldCount; i += 1) {
    var fieldName = readChunk();
    var finalVal = readValue();
    instance.set_field(fieldName, finalVal);
  }

  return instance;
}

//@ PP
// Pretty printer class. Recursively creates a pretty printed version of the data and returns it
// as a string.
class PP {
  init() {
    this.indentValue = 0;
    this.visited = Set();
  }

  //: pp
  // Main entrypoint. Called with PP.pp(obj)
  // Requires:
  //   Value: obj
  // Returns:
  //   String
  static pp(obj) {
    var printer = PP();
    return printer.format(obj);
  }

  //: format
  // The actual format method
  // Requires:
  //   Value: obj
  // Returns:
  //   String
  format(obj) {
    if (obj == nil) return "nil";

    var klass = obj.class();

    if (klass == Bool) return obj ? "true" : "false";
    if (klass == Integer or klass == Float or klass == Number) return String(obj);
    if (klass == String) return "\"" + obj + "\"";

    // O(1) circular check
    if (this.visited.has(obj)) {
      return "[Circular ...]";
    }
    this.visited.add(obj);

    var res = nil;
    if (klass == Array) {
      res = this.formatArray(obj);
    } else if (klass == Set) {
      res = this.formatSet(obj);
    } else if (klass == Map) {
      res = this.formatMap(obj);
    } else if (klass == Vec3) {
      res = this.formatVec3(obj);
    } else {
      res = this.formatInstance(obj);
    }

    this.visited.remove(obj);
    return res;
  }

  //: formatArray
  // Pretty prints an array
  // Requires:
  //   Array: arr
  // Returns:
  //   String
  formatArray(arr) {
    var len = arr.len();
    if (len == 0) return "[]";
    this.indentValue += 2;
    var pad = " " * this.indentValue;
    var lines = ["[\n"];
    
    for (var i = 0; i < len; i += 1) {
      lines.push(pad);
      lines.push(this.format(arr[i]));
      lines.push(i < len - 1 ? ",\n" : "\n");
    }

    this.indentValue -= 2;
    lines.push(" " * this.indentValue);
    lines.push("]");
    return lines.join("");
  }

  //: formatArray
  // Pretty prints a map
  // Requires:
  //   Map: map
  // Returns:
  //   String
  formatMap(map) {
    var keys = map.keys();
    var len = keys.len();
    if (len == 0) return "{}";

    this.indentValue += 2;
    var pad = " " * this.indentValue;
    var lines = ["{\n"];

    for (var i = 0; i < len; i += 1) {
      var key = keys[i];
      var addstrings = [pad, "\"", key, "\": ", this.format(map[key])];
      lines = lines + addstrings;

      if (i < len - 1) {
        lines.push(",\n");
      } else {
        lines.push("\n");
      }
    }

    this.indentValue -= 2;
    lines.push(" " * this.indentValue);
    lines.push("}");

    return lines.join("");
  }

  //: formatSet
  // Pretty prints a set
  // Requires:
  //   Set: set
  // Returns:
  //   STring
  formatSet(set) {
    var items = set.keys();
    var len = items.len();
    if (len == 0) return "Set {}";

    this.indentValue += 2;
    var pad = " " * this.indentValue;
    var lines = ["Set {\n"];

    for (var i = 0; i < len; i += 1) {
      liens.push(pad);
      lines.push(this.format(items[i]));
      if (i < len - 1) {
        lines.push(",\n");
      } else {
        lines.push("\n");
      }
    }

    this.indentValue -= 2;
    lines.push(" " * this.indentValue);
    lines.push("}");

    return lines.join("");
  }

  //: formatInstance
  // Pretty prints an instance
  // Requires:
  //   Instance: instance
  // Returns:
  //   String
  formatInstance(instance) {
    var className = instance.class().name();
    var keys = instance.fields();
    var len = keys.len();

    if (len == 0) return className + " {}";

    this.indentValue += 2;
    var pad = " " * this.indentValue;
    var lines = [className + " {\n"];

    for (var i = 0; i < len; i += 1) {
      var fieldName = keys[i];
      var addstrings = [pad, fieldName, ": ", this.format(instance.get_field(fieldName))];
      lines = lines + addstrings;

      if (i < len - 1) {
        lines.push(",\n");
      } else {
        lines.push("\n");
      }
    }

    this.indentValue -= 2;
    lines.push(" " * this.indentValue);
    lines.push("}");

    return lines.join("");
  }

  //: formatVec3
  // Pretty prints a vec3
  // Requires:
  //   Vec3: vec
  // Returns:
  //   String
  formatVec3(vec) {
    return "Vec3(" + String(vec.x) + ", " + String(vec.y) + ", " + String(vec.z) + ")";
  }
}

//= pp
// Simple function that calls PP.pp() and prints the result. Calling PP.pp() directly
// Gets the output as a string but doesn't print it.
// Requires:
//   Value: obj
fun pp(obj) {
  print PP.pp(obj);
}

const STDOUT = File.open("STDOUT").unwrap();
const STDERR = File.stderr();
const STDIN = File.open("STDIN").unwrap();

//= sendAll
// Send all bytes in a string, perhaps with multiple send calls
// if not all were sent at first.
fun sendAll(socket, data) {
  var totalBytes = data.length();
  var bytesSent = 0;

  while (bytesSent < totalBytes) {
    var unsentData = data.substring(bytesSent);
    var result = socket.send(unsentData);

    if (!result) {
      return false;
    }

    var written = result.unwrap();

    if (written > 0) {
      bytesSent = bytesSent + written;
    } else {
      socket.poll(IO.PollOut, 100);
    }
  }

  return true;
}

//= readExact
// read
fun readExact(socket, targetLength) {
  var dataReceived = "";

  while (dataReceived.length() < targetLength) {
    var pollResult = IO.poll([socket], 500, IO.PollIn);
    if (pollResult.unwrap().length() == 0) {
      continue;
    }

    var remaining = targetLength - dataReceived.length();
    var result = socket.recv(remaining);

    if (!result) {
      print "Connection lost: " + result.err;
      return nil;
    }

    var chunk = result.wrap();
    dataReceived = dataReceived + chunk;
  }

  return dataReceived;
}

//@ AssertionError
// Error class for assertions
class AssertionError < Error {}

//= assert
// Test expr, and if false, throw an AssertionError
// Requires:
//   Value: expr
fun assert(expr, msg = "failed assertion") {
  if (!expr) {
    throw AssertionError(msg);
  }
}

//= stringReplaceAll
// Replace all occurrances of target in str with replacement
// Requires:
//   String: str
//   String: target
//   String: replacement
// Returns:
//   String
fun stringReplaceAll(str, target, replacement) {
  if (target == "" or target == nil) return str;

  var result  = "";
  var current = str;
  var targetLen = target.length();

  while (true) {
    var idx = current.find(target);
    if (idx == -1 or idx == nil) {
      result = result + current;
      break;
    }

    result = result + current.slice(0, idx) + replacement;
    current = current.slice(idx + targetLen, current.length());
  }

  return result;
}

//= isHexDigit
// Test if character is a hex digit. Character must be the ascii code for the character. 5 is false, '5' is true.
// Requires:
//   Integer: c
fun isHexDigit(c) {
  return (c >= '0' and c <= '9') or
    (c >= 'a' and c <= 'f') or
    (c >= 'A' and c <= 'F');
}

//= isOctDigit
// Test if character is a octal digit. Character must be the ascii code for the character. 5 is false, '5' is true.
// Requires:
//   Integer: c
fun isOctDigit(c) {
  return c >= '0' and c <= '7';
}

//= isDigit
// Test if character is a decimal digit. Character must be the ascii code for the character. 5 is false, '5' is true.
// Requires:
//   Integer: c
fun isDigit(c) {
  return c >= '0' and c <= '9';
}

//= isAlpha
// Test if character is an alpha character. Includes '_' for identifiers.
// Requires:
//   Integer: c
fun isAlpha(c) {
  return (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_';
}

//= isAlphaNumeric
// Test if character is an alpha character or digit. Includes '_' for identifiers.
// Requires:
//   Integer: c
fun isAlphaNumeric(c) {
  return isAlpha(c) or isDigit(c);
}

//= parseBinary
// Parse a string as binary.  Skips leading '%', and stops at first character that isn't '0' or '1'.
// Returns:
//   Integer
fun parseBinary(str) {
  var val = 0;
  var len = str.length() ?? 0;
  if (len == 0) return 0;
  var start = 0;

  if (str[0] == '%') start = 1;

  for (var i = start; i < str.length(); i += 1) {
    var c = str[i];
    if (c == '0') {
      val = val * 2;
    } else if (c == '1') {
      val = (val * 2) + 1;
    } else {
      break;
    }
  }
  return val;
}

//@ Struct
class Struct {
  //: packNative
  // Assume native ordering for pack
  packNative(fmt, values) { return this.pack(fmt, values, false); }
  //: unpackNative
  // Assume native ordering for unpack
  unpackNative(fmt, buf) { return this.unpack(fmt, buf, false); }

  //: packNet
  // Assume network ordering for pack
  packNet(fmt, values) { return this.pack(fmt, values, true); }
  //: unpackNet
  // Assume network ordering for pack
  unpackNet(fmt, buf) { return this.unpack(fmt, buf, true); }
}

// Shortcut for System.exit()
var exit = System.exit;

//@ Array
class Array {
  //: iter
  // Returns an iterator so foreach can traverse the array.
  // Returns:
  //   ArrayIterator
  iter() {
    return ArrayIterator(this);
  }

  //: zipWith
  // Combines 2 arrays, transformed by a function like f(array1[i], array2[i]).
  // Requires:
  //   Array: other
  //   Value: transformFn
  // Returns:
  //   Array
  zipWith(other, transformFn) {
    var result = [];
    var limit = this.length();
    if (other.length() < limit) limit = other.length();

    for (var i = 0; i < limit; i += 1) {
      result.push(transformFn(this[i], other[i]));
    }

    return result;
  }

  //: zip
  // zipWIth with no transform function.
  // Requires:
  //   Array: o ther
  // Returns:
  //   Array
  zip(other) {
    return this.zipWith(other, fun(x, y) {
        return [x, y];
    });
  }
  //: chunk
  // Create an array of chunks of an array. Takes a chunk size, and returns a new array
  // split by the chunk size. The last element will be the remainder.
  // Requires:
  //   Integer: size
  // Returns:
  //   Array
  chunk(size) {
    if (size <= 0) return [];
    var result = [];
    var current = [];
    var len = this.length();

    for (var i = 0; i < len; i += 1) {
      current.push(this[i]);
      if (current.length() == size) {
        result.push(current);
        current = [];
      }
    }

    if (current.length() > 0) {
      result.push(current);
    }

    return result;
  }

  //: partition
  // Companion to filter/select. Items that resolve true end up in the first set, false in the second. Creates
  // new array containing true and false sets.
  // Requires:
  //   Value: predicateFn
  // Returns:
  //   Array
  partition(predicate) {
    var pass = [];
    var fail = [];
    var len = this.length();

    for (var i = 0; i < len; i += 1) {
      var item = this[i];
      if (predicate(item)) {
        pass.push(item);
      } else {
        fail.push(item);
      }
    }

    return [pass, fail];
  }
}

//@ Set
class Set {
  //: iter
  // Returns an iterator over the set's keys so foreach can traverse it.
  // Returns:
  //   ArrayIterator
  iter() {
    return ArrayIterator(this.keys());
  }

  //: multiset
  // Create a new Set as a multiset. Use as an initializer like: var s = Set.multiset().
  // Optional:
  //   Array
  // Returns:
  //   Set
  static multiset(arr = nil) {
    var s = Set();
    s.set_multiset();
    if (arr != nil) {
      for (var i = 0; i < arr.length(); i += 1) {
        s.add(arr[i]);
      }
    }
    return s;
  }
}
