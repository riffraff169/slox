import "ffi";

//@ MultiFFI
// Load multiple ffi libraries. Doesn't present skip libraries that aren't found.
// Requires:
//   Array: paths
class MultiFFI {
  init(paths) {
    this.handles = [];
    for (var i = 0; i < paths.length(); i += 1) {
      try {
        this.handles.push(FFI(paths[i]));
        //print "MultiFFI: Added " + paths[i];
      } catch (e) {
        print "MultiFFI: Skipped " + paths[i];
        // skip libraries that fail to load
      } 
    }
  }

  //: bind
  // Binds a symbol. Searches through all loaded libraries to find the first one that matches.
  bind(symbolName, returnType, argTypes) {
    for (var i = 0; i < this.handles.length(); i += 1) {
      var sym = nil;
      try {
        sym = this.handles[i].bind(symbolName, returnType, argTypes);
        //print "Found symbol " + symbolName + ": " + i;
      } catch (Error e) {
        sym = nil;
        print "MultiFFI: Not found " + symbolName + ": " + i + " - " + e.message;
        // try next library
      } catch (e) {
        sym = nil;
        print "MultiFFI: Not found " + symbolName + ": " + i + " - " + e;
      }
      return sym;
    }
    throw("MultiFFI: Symbol '" + symbolName + "' not found in any loaded libraries.");
  }
}
