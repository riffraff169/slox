import "ffi";

//@ MultiFFI
// Loads FFI libraries from a list of platform-specific names, skipping any
// name that cannot be opened. This allows the same binding code to work on
// systems that ship the library under a different name.
// Requires:
//   Array: paths
class MultiFFI {
  init(paths) {
    this.handles = [];
    for (var i = 0; i < paths.length(); i += 1) {
      try {
        this.handles.push(FFI(paths[i]));
      } catch (e) {
        // This name is not available on this platform; try the next one.
      }
    }
  }

  //: bind
  // Binds a symbol from the first loaded library that exports it.
  // Requires:
  //   String: symbolName
  //   String: returnType
  //   Array: argTypes
  // Returns:
  //   Native: bound function
  bind(symbolName, returnType, argTypes) {
    if (this.handles.length() == 0) {
      throw Error("MultiFFI: No FFI libraries could be loaded.");
    }

    var lastError = nil;
    for (var i = 0; i < this.handles.length(); i += 1) {
      try {
        return this.handles[i].bind(symbolName, returnType, argTypes);
      } catch (Error e) {
        lastError = e.message;
      } catch (e) {
        lastError = "" + e;
      }
    }

    var message = "MultiFFI: Symbol '" + symbolName + "' not found in any loaded library.";
    if (lastError != nil) {
      message = "MultiFFI: Could not bind '" + symbolName + "': " + lastError;
    }
    throw Error(message);
  }
}
