class Template {
  init(filepath) {
    this.filepath = filepath;
    this.content = "";
    if (filepath != nil) {
      this.loadfile(filepath);
    }
  }

  loadfile(path) {
    this.filepath = path;
    this.content = File.load(path);
    return this;
  }

  from_string(rawStr) {
    this.content = rawStr;
    return this;
  }

  render(context) {
    var output = this.content;
    var keys = context.keys();

    for (var i = 0; i < keys.length(); i += 1) {
      var key = keys[i];
      var val = context[key];

      var strval = val;

      output = this.replaceTag(output, "{{" + key + "}}", strval);
      output = this.replaceTag(output, "{{" + key + " }}", strval);
      output = this.replaceTag(output, "{{ " + key + " }}", strval);
      output = this.replaceTag(output, "<%=" + key + "%>", strval);
      output = this.replaceTag(output, "<%= " + key + " %>", strval);
    }

    return output;
  }

  replaceTag(source, tag, value) {
    var parts = source.split(tag);
    return parts.join(value);
  }
}
