//@ PriorityQueue
// Implementation of a priority queue. Defaults to standard (a < b) check if comparator callback
// not provided.
// Optional:
//   Value: comparator
class PriorityQueue {
  init(comparator = nil) {
    this.heap = [];
    this.comparator = comparator;
    if (this.comparator == nil) {
      this.comparator = fun(a, b) { return a < b; };
    }
  }

  _floor(n) {
    return n - (n % 1);
  }

  _parent(i) { return this._floor((i - 1) / 2); }
  _leftChild(i) { return 2 * i + 1; }
  _rightChild(i) { return 2 * i + 2; }

  //: isEmpty
  // Checks if heap is empty.
  // Returns:
  //   Bool
  isEmpty() {
    return this.heap.length() == 0;
  }

  //: size
  // Returns size of heap
  // Returns:
  //   Integer
  size() {
    return this.heap.length();
  }

  //: peek
  // Get top of heap, or nil
  // Returns:
  //   Value
  peek() {
    if (this.isEmpty()) return nil;
    return this.heap[0];
  }

  //: push
  // Adds value to heap, then restores heap order..
  // Requires:
  //   Value: val
  push(val) {
    this.heap.push(val);
    this._siftUp(this.heap.length() - 1);
  }

  //: pop
  // Removes top entry nd restores heap order.
  pop() {
    if (this.isEmpty()) return nil;

    var len = this.heap.length();
    var root = this.heap[0];
    var last = this.heap[len - 1];

    this.heap.delete_at(len - 1);

    if (!this.isEmpty()) {
      this.heap[0] = last;
      this._siftDown(0);
    }

    return root;
  }

  _siftUp(i) {
    while (i > 0) {
      var p = this._parent(i);
      // use comparator: returns true if child higher priority than parent
      if ((this.comparator)(this.heap[i], this.heap[p])) {
        var temp = this.heap[i];
        this.heap[i] = this.heap[p];
        this.heap[p] = temp;
        i = p;
      } else {
        break;
      }
    }
  }

  _siftDown(i) {
    var size = this.heap.length();
    while (true) {
      var target = i;
      var left = this._leftChild(i);
      var right = this._rightChild(i);

      if (left < size and (this.comparator)(this.heap[left], this.heap[target])) {
        target = left;
      }
      if (right < size and (this.comparator)(this.heap[right], this.heap[target])) {
        target = right;
      }

      if (i != target) {
        var temp = this.heap[i];
        this.heap[i] = this.heap[target];
        this.heap[target] = temp;
        i = target;
      } else {
        break;
      }
    }
  }
}

//@ AVLNode
// Node of AVL tree
// Requires:
//   Value: val
class AVLNode {
  init(val) {
    this.val = val;
    this.height = 1;
    this.left = nil;
    this.right = nil;
  }
}

//@ AVLTree
// AVL Tree implementation. Uses AVLnode as nodes.
// Optional:
//   Value: comparator
class AVLTree {
  init(comparator = nil) {
    this.root = nil;
    this.comparator = comparator;
    if (this.comparator == nil) {
      this.comparator = fun(a, b) { return a < b; };
    }
  }

  _isLessThan(a, b) {
    return this.comparator(a, b);
  }

  _isGreaterThan(a, b) {
    return this.comparator(b, a);
  }

  _isEqual(a, b) {
    return !this._isLessThan(a, b) and !this._isGreaterThan(a, b);
  }

  _height(node) {
    if (node == nil) return 0;
    return node.height;
  }

  _max(a, b) {
    if (a > b) return a;
    return b;
  }

  _getBalance(node) {
    if (node == nil) return 0;
    return this._height(node.left) - this._height(node.right);
  }

  _rotateRight(y) {
    var x = y.left;
    var T2 = x.right;

    x.right = y;
    y.left = T2;

    y.height = this._max(this._height(y.left), this._height(y.right)) + 1;
    x.height = this._max(this._height(x.left), this._height(x.right)) + 1;

    return x;
  }

  _rotateLeft(x) {
    var y = x.right;
    var t2 = y.left;

    y.left = x;
    x.right = t2;

    x.height = this._max(this._height(x.left), this._height(x.right)) + 1;
    y.height = this._max(this._height(y.left), this._height(y.right)) + 1;
    
    return y;
  }

  //: insert
  // Add item to tree.
  // Requires:
  //   Value: val
  insert(val) {
    this.root = this._insertNode(this.root, val);
  }

  _insertNode(node, val) {
    if (node == nil) return AVLNode(val);

    if (this._isLessThan(val, node.val)) {
      node.left = this._insertNode(node.left, val);
    } else if (this._isGreaterThan(val, node.val)) {
      node.right = this._insertNode(node.right, val);
    } else {
      return node; // duplicate values not allowed
    }

    node.height = 1 + this._max(this._height(node.left), this._height(node.right));
    var balance = this._getBalance(node);

    // left left case
    if (balance > 1 and this._isLessThan(val, node.left.val)) {
      return this._rotateRight(node);
    }

    // right right case
    if (balance < -1 and this._isGreaterThan(val, node.right.val)) {
      return this._rotateLeft(node);
    }

    // left right case
    if (balance > 1 and this._isGreaterThan(val, node.left.val)) {
      node.left = this._rotateLeft(node.left);
      return this._rotateRight(node);
    }

    // right left case
    if (balance < -1 and this._isLessThan(val, node.right.val)) {
      node.right = this._rotateRight(node.right);
      return this._rotateLeft(node);
    }

    return node;
  }

  //: contains
  // Checks if this branch contains the item
  // Requires:
  //   Value: val
  // Returns:
  //   Bool
  contains(val) {
    var curr = this.root;
    while (curr != nil) {
      if (this._isEqual(val, curr.val)) return true;
      if (this._isLessThan(val, curr.val)) curr = curr.left;
      else curr = curr.right;
    }
    return false;
  }

  //: inOrder
  // Visit tree in order
  // Requires:
  //   Value: callback
  inOrder(cb) {
    this._inOrderNode(this.root, cb);
  }

  _inOrderNode(node, cb) {
    if (node != nil) {
      this._inOrderNode(node.left, cb);
      cb(node.val);
      this._inOrderNode(node.right, cb);
    }
  }

  //: preOrder
  // Visit tree pre-order
  // Requires:
  //   Value: callback
  preOrder(cb) {
    this._preOrderNode(this.root, cb);
  }

  _preOrderNode(node, cb) {
    if (node != nil) {
      cb(node.val);
      this._preOrderNode(node.left, cb);
      this._preOrderNode(node.right, cb);
    }
  }

  //: postOrder
  // Visit tree post-order
  // Requires:
  //   Value: callback
  postOrder(cb) {
    this._postOrderNode(this.root, cb);
  }

  _postOrderNode(node, cb) {
    if (node != nil) {
      this._postOrderNode(node.left, cb);
      this._postOrderNode(node.right, cb);
      cb(node.val);
    }
  }
}
