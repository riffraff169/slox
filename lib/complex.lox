//@ Complex
// Complex class and associated methods.
// Supports overloads of relational operators, basic math.
// Complex vars are immutable. Every operator returns a new instance, and trying
// to modify individual parts fails.
// Requires:
//   Number: real
//   Number: imag
class Complex {
  init(real, imag) {
    this.real = real;
    this.imag = imag;
    this.freeze();
  }

  //: fromReal
  // Create a Complex value from a real
  // Requires:
  //   Number: r
  // Returns:
  //   Complex
  static fromReal(r) {
    return Complex(r, 0);
  }

  //: fromPolar
  // Create a Complex value from a polar r, theta
  // Requires:
  //   Number: r
  //   Number: theta
  // Returns:
  //   Complex
  static fromPolar(r, theta) {
    return Complex(r * Math.cos(theta), r * Math.sin(theta));
  }

  //: abs
  // Get magnitude/abs
  // Returns:
  //   Number
  abs() {
    // magnitude |z| = sqrt(a^2 + b^2)
    return (this.real * this.real + this.imag * this.imag).sqrt();
  }

  //: arg
  // Get atan2 of imag and real
  // Returns:
  //   Number
  arg() {
    // phase / argument angle
    return Math.atan2(this.imag, this.real);
  }

  //: conj
  // Get complex conjugate
  // Returns:
  //   Complex
  conj() {
    // complex conjugate: a - bi
    return Complex(this.real, -this.imag);
  }

  //: neg
  // Get negative -a - bi
  // Returns:
  //   Complex
  neg() {
    // negation: -a - bi
    return Complex(-this.real, -this.imag);
  }

  __neg__() {
    return this.neg();
  }

  __lt__(other) {
    if (isnumber(other)) {
      return this.abs() < other;
    } else {
      return this.abs() < other.abs();
    }
  }

  __gt__(other) {
    if (isnumber(other)) {
      return this.abs() > other;
    } else {
      return this.abs() > other.abs();
    }
  }

  __ge__(other) {
    return !this.__lt__(other);
  }

  __le__(other) {
    return !this.__gt__(other);
  }

  __eq__(other) {
    if (typeof(other) != "Complex") return false;
    return this.real == other.real and this.imag == other.imag;
  }

  // math ops
  //: add
  // Add a value to this, either another Complex, or a Number
  // Requires:
  //   Number: other
  // Returns:
  //   Complex
  add(other) {
    if (isnumber(other)) {
      return Complex(this.real + other, this.imag);
    }
    return Complex(this.real + other.real, this.imag + other.imag);
  }

  __add__(other) {
    return this.add(other);
  }

  //: sub
  // Subtract a value
  // Requires:
  //   Number: other
  // Returns:
  //   Complex
  sub(other) {
    if (isnumber(other)) {
      return Complex(this.real - other, this.imag);
    }
    return Complex(this.real - other.real, this.imag - other.imag);
  }

  __sub__(other) {
    return this.sub(other);
  }

  //: mul
  // Multiply
  // Requires:
  //   Number: other
  // Returns:
  //   Complex
  mul(other) {
    if (isnumber(other)) {
      return Complex(this.real * other, this.imag * other);
    }
    // (a + bi)(c + di) = (ac - bd) + (ad + bc)i
    var a = this.real;
    var b = this.imag;
    var c = other.real;
    var d = other.imag;
    return Complex(a * c - b * d, a * d + b * c);
  }

  __mul__(other) {
    return this.mul(other);
  }

  //: div
  // Divide
  // Requires:
  //   Number: other
  // Returns:
  //   Complex
  div(other) {
    if (isnumber(other)) {
      return Complex(this.real / other, this.imag / other);
    }

    // (a * bi) / (c + di) = [(ac + bd) + (bc - ad)i] / (c^2 + d^2)
    var a = this.real;
    var b = this.imag;
    var c = other.real;
    var d = other.imag;
    var denom = c * c + d * d;

    return Complex(
        (a * c + b * d) / denom,
        (b * c - a * d) / denom
        );
  }

  __div__(other) {
    return this.div(other);
  }

  // advanced functions
  //: exp
  // Get e^this
  // Returns:
  //   Complex
  exp() {
    // e^(a + bi) = e^a * (cos(b) + i * sin(b))
    var expReal = Math.exp(this.real);
    return Complex(
        expReal * Math.cos(this.imag),
        expReal * Math.sin(this.imag)
        );
  }

  // formatting
  //: to_string
  // Format as a string
  // Returns:
  //   String
  to_string() {
    if (this.imag == 0) return String(this.real);
    if (this.real == 0) return String.imag + "i";

    var sign = " + ";
    var absImag = this.imag;
    if (this.imag < 0) {
      sign = " - ";
      absImag = -this.imag;
    }
    return String(this.real) + sign + absImag + "i";
  }
}
