require("complex.lox");
require("matrix.lox");

class Polynomial {
  init(coeffs) {
    // coefficients ordered from highest degree to lowest
    // eg [1, -5, 6] represents x^2 - 5x + 6
    this.coeffs = coeffs;
    this.degree = coeffs.length() - 1;
  }

  // evaluate P(x) using horner's method
  eval(x) {
    var result = this.coeffs[0];
    for (var i = 1; i <= this.degree; i += 1) {
      if (typeof(x) == "Complex") {
        // result = x * result + this.coeffs[i];
        result = x.mul(result).add(this.coeffs[i]);
      } else {
        result = result * x + this.coeffs[i];
      }
    }
    return result;
  }

  // construct the companion matrix
  companionMatrix() {
    var n = this.degree;
    var leading = this.coeffs[0];

    // normalize coefficients to leading coefficient = 1
    var norm = [0; n];
    for (var i = 0; i < n; i += 1) {
      norm[i] = this.coeffs[i + 1] / leading;
    }

    var C =  Matrix.zeros(n, n);

    // fill sub diagonal with 1s
    for (var i = 1; i < n; i += 1) {
      C.data[i * n + (i - 1)] = 1;
    }

    // fill last column with negated normalized coefficients
    for (var i = 0; i < n; i += 1) {
      C.data[i * n + (n - 1)] = -norm[n - 1 - i];
    }

    return C;
  }

  // solve roots via companion matrix eigenvalues
  roots() {
    var C = this.companionMatrix();

    if (this.degree == 2) {
      var eigen = C.eigen2x2();
      return eigen["values"];
    }

    // for n > 2, call general qr decomposition / power iteration on c
    return nil;
  }
}
