//@ Json
// Json class. Supports most json data.
class Json {
  //: parse
  // Parse json into native data structures.
  // Requires:
  //   String: jsonstr
  // Returns:
  //   String
  static parse(jsonstr) {
    if (jsonstr == nil or jsonstr.length() == 0) return nil;

    var code = jsonstr;

    code = stringReplaceAll(code, ": null", ": nil");
    code = stringReplaceAll(code, ":null", ":nil");
    code = stringReplaceAll(code, "[null", "[nil");
    code = stringReplaceAll(code, ",null", ",nil");
    code = stringReplaceAll(code, ", null", ", nil");

    try {
      eval("var __json_res = " + code + ";");
    } catch (Error e) {
      //print "[Json.parse Error] " + e.message;
      return nil;
    } catch (e) {
      //print "[Json.parse Error] " + e;
      return nil;
    }
    // let error bubble up
    //eval("var __json_res = " + code + ";");
    var result = __json_res;

    __json_res = nil;

    return result;
  }

  //: to_string
  // Return printable json string.
  // Requires:
  //   Value: obj
  static to_string(obj) {
    if (obj == nil) return "null";
    var klass = obj.class();

    if (klass == Bool) return obj ? "true" : "false";
    if (klass == Integer or klass == Float or klass == Number) return String(obj);

    if (klass == String) {
      var s = stringReplaceAll(obj, "\\", "\\\\");
      s = stringReplaceAll(s, "\"", "\\\"");
      s = stringReplaceAll(s, "\n", "\\n");
      s = stringReplaceAll(s, "\r", "\\r");
      s = stringReplaceAll(s, "\t", "\\t");
      return "\"" + s + "\"";
    }

    if (klass == Array) {
      var res = "[";
      for (var i = 0; i < obj.len(); i += 1) {
        res = res + Json.to_string(obj[i]);
        if (i < obj.length() - 1) res = res + ",";
      }
      return res + "]";
    }

    if (klass == Map or klass = Set) {
      var keys = obj.keys();
      var res = "{";
      for (var i = 0; i < keys.length(); i += 1) {
        var k = keys[i];
        res = res + Json.to_string(String(k)) + ":" + Json.to_string(obj[k]);
        if (i < keys.length() - 1) res = res + ",";
      }
      return res + "}";
    }
    return "null";
  }
}

