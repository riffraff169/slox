require("notcurses.lox");

// Scrollbox class
// Creates a box for scrolling lists
class Scrollbox {
  init(nc, parentPlane, y, x, width, height, items) {
    this.nc = nc;
    this.parentPlane = parentPlane;
    this.y = y;
    this.x = x;
    this.width = width;
    this.height = height;

    this.plane = this.parentPlane.create_child(y, x, height, width);

    this.items = items;
    this.selections = {};

    this.cursor = 0;
    this.scrollOffset = 0;
    this.focused = true;
    this.enableCheckboxes = true;
    this.showSelected = false;
    this.keyCallbacks = {};
  }

  // Set callback for specific keys
  onKey(key, fn) {
    this.keyCallbacks[key] = fn;
    return this;
  }

  // Destroy scrollbox
  destroy() {
    if (this.plane != nil) {
      this.plane.destroy();
      this.plane = nil;
    }
  }

  // Get list of items that have been selected
  getVisibleItems() {
    if (this.showSelected) {
      return this.items;
    }
    return this.items.filter(fun(item) {
        return !this.selections.has(item);
    });
  }

  // Select an item
  selectItem(item) {
    this.selections[item] = true;
  }

  // Unselect an item
  deselectItem(item) {
    //this.selected.delete(item);
    this.selections[item] = false;
  }

  // Clear selection list
  clearSelection() {
    this.selections = {};
  }

  // Change focus status of this scrollbox
  setFocus(isFocused) {
    this.focused = isFocused;
  }

  // Select all items
  selectAll(state) {
    this.items.each(fun(w) { this.selections[w] = state; });
  }

  // Get list of items that have been selected
  getSelectedItems() {
    getVisibleItems();
  }

  // Render this box
  render() {
    if (this.plane == nil) return;

    this.plane.erase();

    var totalItems = this.items.length();
    var visibleRows = this.height;

    for (var i = 0; i < visibleRows; i += 1) {
      var idx = this.scrollOffset + i;
      if (idx >= totalItems) break;

      var prefix = "  ";
      if (this.focused and idx == this.cursor) {
        prefix = "> ";
      }

      var mark = "";
      if (this.enableCheckboxes) {
        var item = this.items[idx];
        mark = this.selections[item] ? "[X] " : "[ ] ";
      }

      var label = this.items[idx];
      var maxLabelLen = this.width - prefix.length() - mark.length();
      if (label.length() > maxLabelLen) {
        label = label.slice(0, maxLabelLen - 3) + "...";
      }

      this.plane.put_str(i, 0, prefix + mark + label);
    }
  }

  // Update scroll list
  update_scroll() {
    var visible_rows = this.height;
    if (this.items.length() == 0) return;

    if (this.cursor < this.scrollOffset) {
      this.scrollOffset = this.cursor;
    } else if (this.cursor >= this.scrollOffset + visible_rows) {
      this.scrollOffset = this.cursor - visible_rows + 1;
    }
  }

  // Handle input
  // Dispatch callbacks on keys
  handleInput(key) {
    if (!this.focused) return false;

    var totalItems = this.items.length();
    if (totalItems == 0) return false;

    if (this.keyCallbacks.has(key)) {
      var visible = this.getVisibleItems();
      var current = visible[this.cursor];

      var ctx = {
        "box": this,
        "key": key,
        "item": current,
        "index": this.cursor,
        "selections": this.getSelectedItems(),
        "visible": visible,
        "items": this.items
      };
          
      this.keyCallbacks[key](ctx);
      return true;
    }

    if (key == "Up" or key == "k") {
      if (this.cursor > 0) {
        this.cursor = this.cursor - 1;
        this.update_scroll();
      }
      return true;
    }

    if (key == "Down" or key == "j") {
      if (this.cursor < totalItems - 1) {
        this.cursor = this.cursor + 1;
        this.update_scroll();
      }
      return true;
    }

    if (key == "PageUp") {
      this.cursor = this.cursor - this.height;
      if (this.cursor < 0) this.cursor = 0;
      this.update_scroll();
      return true;
    }

    if (key == "PageDown") {
      this.cursor = this.cursor + this.height;
      if (this.cursor >= totalItems) this.cursor = totalItems - 1;
      this.update_scroll();
      return true;
    }

    if (key == "Home") {
      this.cursor = 0;
      this.update_scroll();
      return true;
    }

    if (key == "End") {
      this.cursor = totalItems - 1;
      this.update_scroll();
      return true;
    }

    if (key == " " or key == "Space") {
      if (this.enableCheckboxes) {
        var item = this.items[this.cursor];
        this.selections[item] = !this.selections[item];
      }
      return true;
    }

    if (key == "a" or key == "A") {
      var selectedCount = this.getSelectedItems().length();
      var allSelected = (selectedCount == totalItems);
      this.selectAll(!allSelected);
      return true;
    }

    return false;
  }
}
