require("notcurses.lox");

//@ Scrollbox
// Scrollbox class
// Creates a box for scrolling lists
//
// Selection display is controlled by two public fields:
//   showSelected: when true (the default), all items stay visible and selected
//     items can show a checkbox marker. When false, selected items are hidden
//     from the display but remain in the items list.
//   enableCheckboxes: when true and showSelected is true, draws [X]/[ ] markers.
// Requires:
//   Notcurses: nc
//   Plane: parentPlane
//   Integer: y
//   Integer: x
//   Integer: width
//   Integer: height
//   Array: items
class Scrollbox {
  init(nc, parentPlane, y, x, width, height, items) {
    this.nc = nc;
    this.parentPlane = parentPlane;
    this.y = y.floor();
    this.x = x.floor();
    this.width = width.floor();
    this.height = height.floor();

    this.plane = this.parentPlane.create_child(y, x, height, width);

    this.items = items;
    this.selections = {};

    this.cursor = 0;
    this.scrollOffset = 0;
    this.focused = true;

    // When true, selected items stay visible and show [X]/[ ] markers.
    // Set to false to omit selected items from the display while keeping them
    // in this.items.
    this.showSelected = true;
    this.enableCheckboxes = true;
    this.keyCallbacks = {};
  }

  //: onKey
  // Set callback for specific keys
  // Requires:
  //   String: key
  //   Value: callback
  onKey(key, fn) {
    this.keyCallbacks[key] = fn;
    return this;
  }

  //: destroy
  // Destroy scrollbox
  destroy() {
    if (this.plane != nil) {
      this.plane.destroy();
      this.plane = nil;
    }
  }

  //: getVisibleItems
  // Get the items currently displayed. When showSelected is true all items
  // are returned; otherwise selected items are omitted (but remain in items).
  // Returns:
  //   Array
  getVisibleItems() {
    if (this.showSelected) {
      return this.items;
    }

    var visible = [];
    for (var i = 0; i < this.items.length(); i += 1) {
      var item = this.items[i];
      if (!this.selections[item]) visible.push(item);
    }
    return visible;
  }

  //: selectItem
  // Select an item
  // Requires:
  //   String: item
  selectItem(item) {
    this.selections[item] = true;
    this.update_scroll();
  }

  //: deselectItem
  // Unselect an item
  // Requires:
  //   String: item
  deselectItem(item) {
    this.selections[item] = false;
    this.update_scroll();
  }

  //: clearSelection
  // Clear selection list
  clearSelection() {
    this.selections = {};
    this.update_scroll();
  }

  //: setFocus
  // Change focus status of this scrollbox
  // Required:
  //   Bool: isFocused
  setFocus(isFocused) {
    this.focused = isFocused;
  }

  //: selectAll
  // Select all items. Change state of all items.
  // Requires:
  //   Bool: state
  selectAll(state) {
    this.items.each(fun(w) { this.selections[w] = state; });
    this.update_scroll();
  }

  //: getSelectedItems
  // Get list of items that have been selected
  // Returns:
  //   Array
  getSelectedItems() {
    var selected = [];
    for (var i = 0; i < this.items.length(); i += 1) {
      var item = this.items[i];
      if (this.selections[item]) selected.push(item);
    }
    return selected;
  }

  //: render
  // Render this box
  render() {
    if (this.plane == nil) return;

    this.plane.erase();

    var visible = this.getVisibleItems();
    var totalItems = visible.length();
    var visibleRows = this.height;

    for (var i = 0; i < visibleRows; i += 1) {
      var idx = this.scrollOffset + i;
      if (idx >= totalItems) break;

      var item = visible[idx];
      var prefix = "  ";
      if (this.focused and idx == this.cursor) {
        prefix = "> ";
      }

      var mark = "";
      if (this.enableCheckboxes and this.showSelected) {
        mark = this.selections[item] ? "[X] " : "[ ] ";
      }

      var label = item;
      var maxLabelLen = (this.width - prefix.length() - mark.length()).floor();
      if (maxLabelLen > 3 and label.length() > maxLabelLen) {
        label = label.slice(0, maxLabelLen - 3) + "...";
      }

      this.plane.put_str(i, 0, prefix + mark + label);
    }
  }

  //: update_scroll
  // Keep the cursor and scroll offset inside the visible item list.
  update_scroll() {
    var visibleRows = this.height;
    if (visibleRows < 1) visibleRows = 1;

    var visibleItems = this.getVisibleItems();
    var totalItems = visibleItems.length();

    if (totalItems == 0) {
      this.cursor = 0;
      this.scrollOffset = 0;
      return;
    }

    if (this.cursor < 0) this.cursor = 0;
    if (this.cursor >= totalItems) this.cursor = totalItems - 1;

    if (this.cursor < this.scrollOffset) {
      this.scrollOffset = this.cursor;
    } else if (this.cursor >= this.scrollOffset + visibleRows) {
      this.scrollOffset = this.cursor - visibleRows + 1;
    }

    var maxOffset = totalItems - visibleRows;
    if (maxOffset < 0) maxOffset = 0;
    if (this.scrollOffset > maxOffset) this.scrollOffset = maxOffset;
    if (this.scrollOffset < 0) this.scrollOffset = 0;
  }

  //: handleInput
  // Handle input
  // Dispatch callbacks on keys
  // Requires:
  //   String: key
  // Returns:
  //   Bool
  handleInput(key) {
    if (!this.focused) return false;

    this.update_scroll();

    var visible = this.getVisibleItems();
    var totalItems = visible.length();

    if (this.keyCallbacks.has(key)) {
      var current = nil;
      if (this.cursor >= 0 and this.cursor < totalItems) {
        current = visible[this.cursor];
      }

      var ctx = {
        "box": this,
        "key": key,
        "item": current,
        "index": this.cursor,
        "selections": this.getSelectedItems(),
        "visible": visible,
        "items": this.items
      };
          
      this.keyCallbacks[key](ctx);
      return true;
    }

    if (totalItems == 0) return false;

    if (key == "Up" or key == "k") {
      if (this.cursor > 0) {
        this.cursor = this.cursor - 1;
        this.update_scroll();
      }
      return true;
    }

    if (key == "Down" or key == "j") {
      if (this.cursor < totalItems - 1) {
        this.cursor = this.cursor + 1;
        this.update_scroll();
      }
      return true;
    }

    if (key == "PageUp") {
      this.cursor = this.cursor - this.height;
      if (this.cursor < 0) this.cursor = 0;
      this.update_scroll();
      return true;
    }

    if (key == "PageDown") {
      this.cursor = this.cursor + this.height;
      if (this.cursor >= totalItems) this.cursor = totalItems - 1;
      this.update_scroll();
      return true;
    }

    if (key == "Home") {
      this.cursor = 0;
      this.update_scroll();
      return true;
    }

    if (key == "End") {
      this.cursor = totalItems - 1;
      this.update_scroll();
      return true;
    }

    if (key == " " or key == "Space") {
      var item = visible[this.cursor];
      this.selections[item] = !this.selections[item];
      this.update_scroll();
      return true;
    }

    if (key == "a" or key == "A") {
      var selectedCount = this.getSelectedItems().length();
      var allSelected = (selectedCount == this.items.length());
      this.selectAll(!allSelected);
      return true;
    }

    return false;
  }
}
