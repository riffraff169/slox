//@ Stats
// Statistics library
// Most functions do not modify the original array, but return a new one.
class Stats {
  //: sum
  // Get sum of array
  // Requires:
  //   Array: arr
  // Returns:
  //   Array
  static sum(arr) {
    return arr.reduce(0, fun(acc, val) { return acc + val; } );
  }

  //: mean
  // Get mean of array
  // Requires:
  //   Array: arr
  // Returns:
  //   Array
  static mean(arr) {
    if (arr.length() == 0) return 0;
    return Stats.sum(arr) / arr.length();
  }

  //: variance
  // Get variance of array
  // Requires:
  //   Array: arr
  // Optional:
  //   Bool: isSample
  // Returns:
  //   Number
  static variance(arr, isSample = true) {
    if (arr.length() < 2) return 0;
    var avg = Stats.mean(arr);

    var sqDiffSum = arr
      .map(fun(x) { var d = x - avg; return d * d; })
      .reduce(0, fun(acc, v) { return acc + v; });

    var divisor = isSample ? (arr.length() - 1) : arr.length();
    return sqDiffSum / divisor;
  }

  //: stdDev
  // Standard Deviation
  // Requires:
  //   Array: arr
  // Optional:
  //   Bool: isSample
  // Returns:
  //   Number
  static stdDev(arr, isSample = true) {
    return Math.sqrt(Stats.variance(arr, isSample));
  }

  //: min
  // Get smallest value of array
  // Requires:
  //   Array: arr
  // Returns:
  //   Number
  static min(arr) {
    if (arr.length() == 0) return nil;
    return arr.reduce(arr[0], fun(min, val) { return val < min ? val : min; });
  }

  //: max
  // Get largest value of array
  // Requires:
  //   Array: arr
  // Returns:
  //   Number
  static max(arr) {
    if (arr.length() == 0) return nil;
    return arr.reduce(arr[0], fun(max, val) { return val > max ? val : max; });
  }

  //: standardize
  // Z-score
  // Requires:
  //   Array: arr
  // Returns:
  //   Array
  static standardize(arr) {
    var avg = Stats.mean(arr);
    var sd = Stats.stdDev(arr, true);
    if (sd == 0) return arr;

    return arr.map(fun(x) { return (x - avg) / sd; });
  }

  //: dotProduct
  // Compute dot product of 2 arrays
  // Requires:
  //   Array: a
  //   Array: b
  // Returns:
  //   Number
  static dotProduct(a, b) {
    if (a.length() != b.length()) return nil;

    return a
      .zipWith(b, fun(x, y) { return x * y; })
      .reduce(0, fun(acc, v) { return acc + v; });
  }

  //: covariance
  // Covariance
  // Requires:
  //   Array: a
  //   Array: b
  // Returns:
  //   Number
  static covariance(a, b) {
    if (a.length() != b.length() or a.length() < 2) return 0;

    var meanA = Stats.mean(a);
    var meanB = Stats.mean(b);

    var diffProdSum = a
      .zipWith(b, fun(x, y) { return (x - meanA) * (y - meanB); })
      .reduce(0, fun(acc, v) { return acc + v; });

    return diffProdSum / (a.length() - 1);
  }

  //: correlation
  // Correlation of 2 arrays
  // Requires:
  //   Array: a
  //   Array: b
  // Returns:
  //   Number
  static correlation(a, b) {
    if (a.length() != b.length() or a.length() < 2) return 0;

    var sdA = Stats.stdDev(a, true);
    var sdB = Stats.stdDev(b, true);
    
    if (sdA == 0 or sdB == 0) return 0;

    return Stats.covariance(a, b) / (sdA * sdB);
  }

  //: slope
  // Linear Regression Slope (m in y = mx + b)
  // Requires:
  //   Array: x
  //   Array: y
  // Returns:
  //   Number
  static slope(x, y) {
    var varX = Stats.variance(x, true);
    if (varX == 0) return 0;

    return Stats.covariance(x, y) / varX;
  }

  //: intercept
  // Linear Regression Y-Intercept (b in y = mx + b)
  // Requires:
  //   Array: x
  //   Array: y
  // Returns:
  //   Number
  static intercept(x, y) {
    var m = Stats.slope(x, y);
    return Stats.mean(y) - (m * Stats.mean(x));
  }

  //: predict
  // Predicts y value for a given x using simple linear regression
  // Requires:
  //   Array: x
  //   Array: y
  //   Number: targetX
  // Returns:
  //   Number
  static predict(x, y, targetX) {
    var m = Stats.slope(x, y);
    var b = Stats.intercept(x, y);
    return (m * targetX) + b;
  }

  //: sma
  // Simple Moving Average with window size k
  // Requires:
  //   Array: arr
  //   Integer: k
  // Returns:
  //   Array
  static sma(arr, k) {
    if (k <= 0 or k > arr.length() or arr.length == 0) return [];
    var result = [];
    var windowSum = arr.slice(0, k).sum();
    result.push(windowSum / k);

    var len = arr.length();
    for (var i = k; i < len; i += 1) {
      windowSum = windowSum - arr[i - k] + arr[i];
      result.push(windowSum / k);
    }

    return result;
  }

  //: ema
  // Exponential Moving Average with smooting multiplier alpha (0 < alpha <= 1)
  // If alpha is nil/omitted, defaults to standard formula: 2 / (k + 1)
  // Requires:
  //   Array: arr
  //   Number: k
  // Optional:
  //   Number: alpha
  // Returns:
  //   Array
  static ema(arr, k, alpha = nil) {
    if (k <= 0 or k > arr.length() or arr.length() == 0) return [];
    if (alpha == nil) alpha = 2.0 / (k + 1.0);

    // Initial seed is the sma of the first k elements
    var seedSMA = Stats.mean(arr.slice(0, k));
    var result = [seedSMA];

    var currentEMA = seedSMA;
    var len = arr.length();
    for (var i = k; i < len; i += 1) {
      currentEMA = (arr[i] * alpha) + (currentEMA * (1.0 - alpha));
      result.push(currentEMA);
    }

    return result;
  }

  //: percentile
  // Linear interpolation percentile (p from 0 to 100)
  // Requires:
  //   Array: arr
  // Optional:
  //   Number: p
  // Returns:
  //   Number
  static percentile(arr, p = 50) {
    if (arr.length() == 0) return nil;
    if (p <= 0) return Stats.min(arr);
    if (p >= 100) return Stats.max(arr);

    var sorted = arr.dup().sort();
    var rank = (p / 100.0) * (sorted.length() - 1);
    var index = Math.floor(rank);
    var fraction = rank - index;

    if (index >= sorted.length() - 1) return sorted[sorted.length() - 1];

    return sorted[index] + fraction * (sorted[index + 1] - sorted[index]);
  }

  //: p90
  // 90th percentil
  // Requires:
  //   Array: arr
  // Returns:
  //   Array
  static p90(arr) { return Stats.percentile(arr, 90); }
  //: p95
  // 95th percentil
  // Requires:
  //   Array: arr
  // Returns:
  //   Array
  static p95(arr) { return Stats.percentile(arr, 95); }
  //: p99
  // 99th percentil
  // Requires:
  //   Array: arr
  // Returns:
  //   Array
  static p99(arr) { return Stats.percentile(arr, 99); }

  //: iqr
  // Interquartile Range (Q3 - Q1)
  // Requires:
  //   Array: arr
  // Returns:
  //   Number
  static iqr(arr) {
    if (arr.length() < 2) return 0;
    var q1 = Stats.percentile(arr, 25);
    var q3 = Stats.percentile(arr, 75);
    return q3 - q1;
  }

  //: outliers
  // Detect outliers using IQR (Tukey's Fences)
  // Returns array of outlier values. k defaults to 1.5
  // Requires:
  //   Array: arr
  // Optional:
  //   Number: k
  // Returns:
  //   Array
  static outliersIQR(arr, k = 1.5) {
    if (arr.length() < 4) return [];

    var q1 = Stats.percentile(arr, 25);
    var q3 = Stats.percentile(arr, 75);
    var iqr = q3 - q1;

    var lowerBound = q1 - (k * iqr);
    var upperBound = q3 + (k * iqr);

    return arr.filter(fun(val) {
        return val < lowerBound or val > upperBound;
        });
  }

  //: outliersZScore
  // Detect outliers using Z-Score threshold
  // Returns array of outlier values. threshold defaults to 3.0
  // Requires:
  //   Array: arr
  // Optional:
  //   Number: threshold
  // Returns:
  //   Array
  static outliersZScore(arr, threshold = 3.0) {
    if (arr.length() < 2) return [];

    var avg = Stats.mean(arr);
    var sd = Stats.stdDev(arr, true);
    if (sd == 0) return [];

    //var outliers = [];
    //var len = arr.length();
    return arr.filter(fun(val) {
        var z = (val - avg) / sd;
        if (z < 0) z = -z;
        return z > threshold;
        });
  }

  //: isOutlier
  // Returns array of booleans [true, false, ...] matching input array indices
  // Requires:
  //   Array: arr
  // Optional:
  //   Number: k
  // Returns:
  //   Array
  static isOutlier(arr, k = 1.5) {
    if (arr.length() < 4) return [];
    
    var q1 = Stats.percentile(arr, 25);
    var q3 = Stats.percentile(arr, 75);
    var iqr = q3 - q1;

    var lowerBound = q1 - (k * iqr);
    var upperBound = q3 + (k * iqr);

    return arr.map(fun(val) {
        return val < lowerBound or val > upperBound;
        });
  }

  //: frequency
  // Counts occurrences of each distinct element
  // Requires:
  //   Array: arr
  // Returns:
  //   Set
  static frequency(arr) {
    var freqs = Set.multiset();
    var len = arr.length();

    for (var i = 0; i < len; i += 1) {
      freqs.add(arr[i]);
    }
    return freqs;
  }

  //: mode
  // Returns array of modes (handles unimodal, multimodal, or no mode)
  // Requires:
  //   Array: arr
  // Returns:
  //   Array
  static mode(arr) {
    if (arr.length() == 0) return [];

    var maxCount = 0;
    var counts = Set.multiset();
    var len = arr.length();

    // 1. Caluclate frequencies and trax max count
    for (var i = 0; i < len; i += 1) {
      counts.add(arr[i]);

      if (counts[arr[i]] > maxCount)
        maxCount = counts[arr[i]];
    }

    // If max count is 1, no value repeats (no mode)
    if (maxCount == 1) return [];

    // 2. Extract keys that hit max frequency
    var modes = [];
    var keys = counts.keys();
    var numKeys = keys.length();

    for (var i = 0; i < numKeys; i += 1) {
      var k = keys[i];
      if (counts[k] == maxCount) {
        modes.push(k);
      }
    }

    return modes;
  }

  //: linearRegression
  // Calculate linearRegression of two arrays
  // Requires:
  //   Array: xArr
  //   Array: yArr
  // Returns:
  //   Map
  static linearRegression(xArr, yArr) {
    if (xArr.length() != yArr.length() or xArr.length() < 2) return nil;

    var cov =  Stats.covariance(xArr, yArr);
    var varX = Stats.variance(xArr, true);

    // Vertical line or no variance in X
    if (varX == 0) return nil;

    var slope = cov / varX;
    var intercept = Stats.mean(yArr) - (slope * Stats.mean(xArr));

    // Pearson r and R-squared
    var r = 0;
    var stdX = Stats.stdDev(xArr, true);
    var stdY = Stats.stdDev(yArr, true);
    if (stdX > 0 and stdY > 0) {
      r = cov / (stdX * stdY);
    }

    var res = {};
    res["slope"] = slope;
    res["intercept"] = intercept;
    res["r"] = r;
    res["r2"] = r * r;

    return res;
  }

  //: predict
  // Takes result of linearRegression to predict y intercept
  // Requires:
  //   Array: x
  //   Map: regResult
  // Returns:
  //   Number
  static predictY(x, regResult) {
    if (regResult == nil) return nil;
    return (regResult["slope"] * x) + regResult["intercept"];
  }

  // Private helper to convert an array of numbers to an array of ranks
  // Handles tied ranks by averaging them
  static _rankArray(arr) {
    var len = arr.length();
    var indexed = [];
    for (var i = 0; i < len; i += 1) {
      var item = {};
      item["val"] = arr[i];
      item["idx"] = i;
      indexed.push(item);
    }

    indexed.sort(fun(a, b) { return a["val"] - b["val"]; });

    var ranks = [0; len];

    var i = 0;
    while (i < len) {
      var j = i;
      var sumRanks = 0;

      while (j < len and indexed[j]["val"] == indexed[i]["val"]) {
        sumRanks += (j + 1);
        j += 1;
      }

      var avgRank = sumRanks / (j - i);
      for (var k = i; k < j; k += 1) {
        ranks[indexed[k]["idx"]] = avgRank;
      }

      i = j;
    }

    return ranks;
  }


  //: spearman
  // Spearman
  // Requires:
  //   Array: xArr
  //   Array: yArr
  // Returns:
  //   Number
  static spearman(xArr, yArr) {
    if (xArr.length() != yArr.length() or xArr.length() <  2) return 0;

    var xRanks = Stats._rankArray(xArr);
    var yRanks = Stats._rankArray(yArr);

    return Stats.correlation(xRanks, yRanks);
  }
}

//@ Array
// Most Stats methods can be used on an array as in arra.sum().
class Array {
  sum()                   { return Stats.sum(this); }
  mean()                  { return Stats.mean(this); }
  variance(sample)        { return Stats.variance(this, sample); }
  stdDev(sample)          { return Stats.stdDev(this, sample); }
  standardize()           { return Stats.standardize(this); }
  dotProduct(other)       { return Stats.dotProduct(this, other); }
  correlation(other)      { return Stats.correlation(this, other); }
  covariance(other)       { return Stats.covariance(this, other); }
  slope(other)            { return Stats.slope(this, other); }
  intercept(other)        { return Stats.intercept(this, other); }
  predict(other, targetX) { return Stats.predict(this, other, targetX); }
  sma(k)                  { return Stats.sma(this, k); }
  ema(k, alpha = nil)     { return Stats.ema(this, k, alpha); }
  percentile(p)           { return Stats.percentile(this, p); }
  p90()                   { return Stats.p90(this); }
  p95()                   { return Stats.p95(this); }
  p99()                   { return Stats.p99(this); }
  iqr()                   { return Stats.iqr(this); }
  outliersIQR(k = 1.5)    { return Stats.outliersIQR(this, k); }
  outliersZScore(thresh = 3.0) { return Stats.outliersZScore(this, thresh); }
  isOutlier(k = 1.5)      { return Stats.isOutlier(this, k); }
  frequency()             { return Stats.frequency(this); }
  mode()                  { return Stats.mode(this); }
  linearRegression(yArr)  { return Stats.linearRegression(this, yArr); }
  spearman(other)         { return Stats.spearman(this, other); }
}
