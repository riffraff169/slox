require("argparser.lox");
require("docparser.lox");

// example data
var sourceLines = [
  "//@ Buffer",
  "// Byte buffer for reading and writing raw memory.",
  "// Required args:",
  "//   None",
  "class Buffer {",
  "",
  "  //: alloc",
  "  // Allocates a raw buffer of specified size.",
  "  // Required args:",
  "  //   size: Number",
  "  static alloc(size) {}",
  "",
  "  //: Buffer.write",
  "  // Writes bytes into the buffer.",
  "  // Required args:",
  "  //   data: String or Buffer",
  "  // Option args:",
  "  //   offset: Number",
  "  write(data, offset) {}",
  "}",
  "",
  "//= Math.floor(x)",
  "// Returns the largest integer less than or equal to x.",
  "// Required args:",
  "//   x: Number",
  "fun floor(x) {}"
];

var ap = ArgParser("docparser.lox", "Process document comments from files");
ap.addOption("output", "o", "output_doc.md", "Outputfile");

var args = ap.parse(System.ARGS);

var parser = DocParser();
args.args.each(fun(s) {
    var source = File.load(s).split("\n");
    parser.parseLines(source);
    });
var markdown = parser.generateMarkdown();

File.save(args["output"], markdown);
