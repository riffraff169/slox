require("json.lox");
require("logger.lox");

class LSPServer {
  init(logFilePath = "/tmp/slox_lsp.log") {
    this.running = true;
    this.documents = {};

    this.log = Logger({
        "app_name": "slox-lsp",
        "level": 0, // 0 = trace (logs everything) 3 = warn
        "file": logFilePath,
        "truncate": true
        });
    
    this.log.info("LSP Server initialized");

    this.keywords = [
      "var", "const", "and", "or", "class", "else", "false",
      "true", "fun", "for", "if", "nil", "print", "return",
      "super", "this", "true", "while", "try", "catch",
      "finally", "break", "continue", "switch", "case",
      "default", "throw", "static", "include", "import"
    ];
  }

  findSymbolDefinition(symbolName, currentUri) {
    this.log.debug("findSymbolDefinition looking for: '" + symbolName + "' in " + currentUri);
    var sourceText = this.documents[currentUri];
    if (sourceText == nil) {
      this.log.warn("findSymbolDefinition: Document text is nil for " + currentUri);
      return nil;
    }

    var visitedFiles = {};
    visitedFiles[currentUri] = true;

    return this.searchSymbolInFile(symbolName, sourceText, currentUri, visitedFiles);
  }

  searchSymbolInFile(symbolName, text, fileUri, visitedFiles) {
    if (text == nil) {
      this.log.warn("searchSymbolInFile received nil text for " + fileUri);
      return nil;
    }

    var lines = text.split("\n");
    this.log.trace("Searching " + lines.length() + " lines in " + fileUri);

    for (var i = 0; i < lines.length(); i += 1) {
      var line = lines[i].trim();
      var lineNum = i; // lsp used 0-based indexing for lines and characters

      // 1. check for class definition: class KittyCanvas
      if (line.slice(0, 6) == "class ") {
        var name = line.slice(6, line.length()).trim().split(" ")[0].split("{")[0].trim();
        if (name == symbolName) {
          var col = line.find(symbolName);
          this.log.info("Found class match at line " + lineNum);
          return this.makeLocation(fileUri, lineNum, col, symbolName.length());
        }
      }

      // 2. check for function definition: fun draw()
      if (line.slice(0, 4) == "fun ") {
        var name = line.slice(4, line.length()).trim().split("(")[0].trim();
        if (name == symbolName) {
          var col = line.find(symbolName);
          this.log.info("Found fun match at line " + lineNum);
          return this.makeLocation(fileUri, lineNum, col, symbolName.length());
        }
      }

      // 3. check for variable definition: var canvas = ...
      if (line.slice(0, 4) == "var ") {
        var name = line.slice(4, line.length()).trim().split("=")[0].trim();
        if (name == symbolName) {
          var col = line.find(symbolName);
          this.log.info("Found var match at line " + lineNum);
          return this.makeLocation(fileUri, lineNum, col, symbolName.length());
        }
      }

      // 4. follow require("...") dependencies recursively
      if (line.slice(0, 8) == "require(") {
        var reqPath = this.extractRequirePath(line);
        this.log.trace("Found require: " + reqPath);

        if (reqPath != nil) {
          this.log.trace("Calling this.resolvePath()");
          var targetPath = this.resolvePath(fileUri, reqPath);
          this.log.trace("Resolved path: " + targetPath);

          if (targetPath != nil) {
            var targetUri = "file://" + targetPath;

            if (visitedFiles[targetUri] != true) {
              visitedFiles[targetUri] = true;
              this.log.debug("Recursing into require: " + targetPath);

              var depContent = File.load(targetPath);

              var match = this.searchSymbolInFile(symbolName, depContent, targetUri, visitedFiles);
              if (match != nil) return match;
            }
          } else {
            this.log.warn("Could not resolve require path: " + reqPath);
          }
        }
      }
    }
    return nil;
  }

  // construct standard lsp location json response
  makeLocation(uri, line, character, length) {
    return {
      "uri": uri,
      "range": {
        "start": { "line": line, "character": character },
        "end":   { "line": line, "character": character + length }
      }
    };
  }

  resolvePath(currentUri, reqPath) {
    this.log.trace("resolvePath called with currentUri='" + currentUri + "', reqPath='" + reqPath + "'");

    if (currentUri == nil or reqPath == nil) {
      this.log.trace("resolvePath: currentUri or reqPath is nil");
      return nil;
    }

    var baseFilePath = currentUri;
    if (baseFilePath.slice(0, 7) == "file://") {
      baseFilePath = baseFilePath.slice(7);
    }
    this.log.trace("resolvePath: baseFilePath='" + baseFilePath + "'");

    this.log.trace("resolvePath: callingDir.dirname('" + baseFilePath + "')");
    var currentDir = Dir.dirname(baseFilePath);
    this.log.trace("resolvePath: currentDir='" + currentDir + "'");

    var paths = [
      currentDir + "/" + reqPath,
      "./lib/" + reqPath,
      "/usr/lib64/slox/lib/" + reqPath
    ];

    for (var i = 0; i < paths.length(); i += 1) {
      var path = paths[i];
      this.log.trace("resolvePath: checking path[" + i + "]='" + path + "'");

      this.log.trace("resolvePath: calling File.exists('" + path + "')");
      var exists = File.exists(path);
      this.log.trace("resolvePath: File.exists result=" + exists);

      if (exists) {
        this.log.trace("resolvePath: calling Dir.realPath('" + path + "')");
        var real = Dir.realpath(path);
        this.log.trace("resolvePath: Dir.realPath result='" + real + "'");

        if (real != nil) return real;
      }
    }

    this.log.trace("resolvePath: no path resolved successfully");
    return nil;
  }

  // helper to extract word under cursor from line text and character index
  getWordAtPosition(text, lineNum, charNum) {
    //this.log.trace("getWordAtPosition called: line=" + lineNum + ", char=" + charNum);

    if (text == nil) {
      this.log.trace("getWordAtPosition: text is nil");
      return "";
    }
    var lines = text.split("\n");
    //this.log.trace("getWordAtPosition: total lines=" + lines.length());

    if (lineNum >= lines.length()) {
      this.log.trace("getWordAtPosition: total lines=" + lineNum + " out of bounds");
      return "";
    }

    var line = lines[lineNum];
    //this.log.trace("getWordAtPosition: target line len=" + line.length() + " contents: '" + line + "'");

    if (charNum >= line.length()) {
      this.log.trace("getWordAtPosition: charNum" + charNum + " >= line len " + line.length());
      return "";
    }

    // scan left to start of identifier
    var start = charNum;
    //this.log.trace("getWordAtPosition: starting left scan from start=" + start);

    while (start > 0) { // and this.isIdentChar(line[start - 1])) {
      var prevChar = line[start - 1];

      //this.log.trace("left scan: idx=" + String(start - 1) + " charCode=" + chr(prevChar));
      var isIdent = this.isIdentChar(prevChar);
      //this.log.trace("left scan: idx=" + String(start - 1) + " charCode=" + chr(prevChar) + " isIdent=" + isIdent);

      if (!isIdent) break;
      start = start - 1;
    }
    //this.log.trace("getWordAtPosition: final start=" + start);

    // scan right to end of identifier
    var end = charNum;
    //this.log.trace("getWordAtPosition: starting right scan from end=" + end);

    while (end < line.length()) { // and this.isIdentChar(line[end])) {
      var currChar = line[end];
      var isIdent = this.isIdentChar(currChar);
      //this.log.trace("right scan: idx=" + end + " charCode=" + chr(currChar) + " isIdent=" + isIdent);

      if (!isIdent) break;
      end += 1;
    }
    //this.log.trace("getWordAtPosition: final end=" + end);

    var word = line.slice(start, end);
    this.log.trace("getWordAtPosition: extracted word='" + word + "'");

    return word;
  }

  isIdentChar(code) {
    //this.log.trace("isIdentChar: code=" + code);
    if (code == nil) return false;
    //this.log.trace("isIdentChar: !nil");
    //this.log.trace("isIdentChar: checking if >= 65 and <= 90");
    if (code >= 65 and code <= 90) return true;
    //this.log.trace("isIdentChar: checking if >= 97 and <= 122");
    if (code >= 97 and code <= 122) return true;
    //this.log.trace("isIdentChar: checking if >= 48 and <= 57");
    if (code >= 48 and code <= 57) return true;
    //this.log.trace("isIdentChar: checking if '_'");
    if (code == '_') return true;
    //this.log.trace("isIdentChar: not valid identifier character");
    return false;
  }

  sendResponse(id, result) {
    var responseMap = {};
    responseMap["jsonrpc"] = "2.0";
    responseMap["id"] = id;
    responseMap["result"] = result;

    var jsonString = Json.to_string(responseMap);
    var header = "Content-Length: " + jsonString.length() + "\r\n\r\n";

    this.log.trace("OUT -> ID: " + id + " Body: " + jsonString);

    STDOUT.write(header + jsonString);
    STDOUT.flush();
  }

  getCompletionsForUri(uri) {
    var items = [];

    for (var i = 0; i < this.keywords.length(); i += 1) {
      items.push(this.makeCompletionItem(this.keywords[i], 14, "Keyword"));
    }

    var sourceText = this.documents[uri];
    if (sourceText != nil) {
      var visitedFiles = {};
      visitedFiles[uri] = true;

      var docSymbols = this.extractSymbolsFromSource(sourceText, "current file", visitedFiles);
      items = items + docSymbols;
    }
    return items;
  }

  getBuiltinCompletions() {
    var items = [];

    for (var i = 0; i < this.keywords.length(); i += 1) {
      items.push(this.makeCompletionItem(this.keywords[i], 14, "Keyword"));
    }

    return items;
  }

  getWorkspaceCompletions(uri) {
    var items = this.getBuiltinCompletions();
    var text = this.documents[uri];
    if (text == nil) return items;

    var lines = text.split("\n");
    for (var i = 0; i < lines.length(); i += 1) {
      var line = lines[i].trim();

      if (line.slice(0, 4) == "fun ") {
        var parts = line.split(" ");
        if (parts.length() > 1) {
          var name = parts[1].split("(")[0];
          items.push(this.makeCompletionItem(name, 3, "Function defined on line " + (i + 1)));
        }
      }

      if (line.slice(0, 4) == "var ") {
        var parts = line.split(" ");
        if (parts.length() > 1) {
          var name = parts[1].split("=")[0].trim();
          items.push(this.makeCompletionItem(name, 6, "Variable defined on line " + (i + 1)));
        }
      }

      if (line.slice(0, 6) == "class ") {
        var parts = line.split(" ");
        if (parts.length() > 1) {
          var name = parts[1].trim();
          items.push(this.makeCompletionItem(name, 7, "Class defined on line " + (i + 1)));
        }
      }
    }

    return items;
  }

  handleMessage(msg) {
    var method = msg["method"];
    var id = msg["id"];

    this.log.debug("IN <- Method: " + method + " (id: " +id + ")");

    // 1. lifecycle: initialize
    if (method == "initialize") {
      var capabilities = {};

      var syncOptions = {};
      syncOptions["openClose"] = true;
      syncOptions["change"] = 1; // 1 = full text sync
      capabilities["textDocumentSync"] = syncOptions;
      capabilities["definitionProvider"] = true;
      capabilities["hoverProvider"] = true;

      var completionOptions = {};
      completionOptions["triggerCharacters"] = ["."];
      capabilities["completionProvider"] = completionOptions;

      var result = {};
      result["capabilities"] = capabilities;
      this.sendResponse(id, result);
      return;
    }

    // 2. lifecycle: shutdown
    if (method == "shutdown") {
      this.log.infi("LSP received shutdown request");
      this.sendResponse(id, nil);
      return;
    }

    if (method == "exit") {
      this.log.info("LSP exiting");
      this.running = false;
      this.log.close();
      return;
    }

    // 3. document sync: didOpen
    if (method == "textDocument/didOpen") {
      var params = msg["params"];
      var doc = params["textDocument"];
      this.documents[doc["uri"]] = doc["text"];
      this.log.info("Opened document: " + doc["uri"]);
      return;
    }

    if (method == "textDocument/didClose") {
      var params = msg["params"];
      var doc = params["textDocument"];
      var uri = doc["uri"];
      this.log.trace("didClose received for: " + uri);

      if (this.documents[uri] != nil) {
        this.documents[uri] = nil;
      }
      return;
    }

    // 4. document sync: didChange
    if (method == "textDocument/didChange") {
      var params = msg["params"];
      var uri = params["textDocument"]["uri"];
      var changes = params["contentChanges"];
      if (changes.length() > 0) {
        this.documents[uri] = changes[0]["text"];
        this.log.trace("Updated document text for " + uri);
      }
      return;
    }

    // 5. completion provider
    if (method == "textDocument/completion") {
      var params = msg["params"];
      var uri = params["textDocument"]["uri"];

      var items = this.getCompletionsForUri(uri);
      this.sendResponse(id, items);
      return;
    }

    if (method == "textDocument/definition") {
      this.log.debug("in textDocument/definition");

      var params = msg["params"];
      var uri = params["textDocument"]["uri"];
      var line = params["position"]["line"];
      var character = params["position"]["character"];

      var docText = this.documents[uri];
      this.log.debug("before getWordAtPosition()");
      var word = this.getWordAtPosition(docText, line, character);
      this.log.debug("after getWordAtPosition()");

      if (word != "") {
        var location = this.findSymbolDefinition(word, uri);
        this.log.debug("Definition match: " + Json.to_string(location));
        this.sendResponse(id, location);
      } else {
        this.log.debug("No symbol found under cursor, sending null response");
        this.sendResponse(id, nil);
      }
      return;
    }

    if (method == "textDocument/hover") {
      var params = msg["params"];
      this.handleHover(id, params);
      return;
    }

    if (id != nil) {
      this.log.warn("Unhandled message with ID " + id + ", sending null result");
      this.sendResponse(id, nil);
    }
  }

  extractDocComments(lines, matchLineIndex) {
    var comments = [];
    var i = matchLineIndex - 1;

    while (i >= 0) {
      var line = lines[i].trim();
      if (line.slice(0, 2) == "//") {
        var commentBody = line.slice(2).trim();
        comments = [commentBody] + comments;
        i = i - 1;
      } else {
        break;
      }
    }

    if (comments.length() == 0) return "";

    return "\n---\n" + comments.join("\n");
  }

  findSymbolHover(symbolName, docText) {
    if (symbolName == nil or symbolName == "") {
      this.log.trace("findSymbolHover: empty or nil symbolName");
      return nil;
    }

    var lines = docText.split("\n");
    this.log.trace("findSymbolHover: scanning " + lines.length() + " lines for '" + symbolName + "'");

    for (var i = 0; i < lines.length(); i += 1) {
      var line = lines[i];
      var trimmed = line.trim();
      var isMatch = false;

      var pos = trimmed.find(symbolName);
      if (pos != nil) {
        this.log.trace("  L" + i + " found '" + symbolName + "' in trimmed line: '" + trimmed + "' at pos=" + pos);

        var endPos = pos + symbolName.length();

        // 1. explicit declarations: class x, fun x, var x
        var isDecl = (trimmed.slice(0, 6) == "class ") or
            (trimmed.slice(0, 4) == "fun ") or
            (trimmed.slice(0, 4) == "var ");

        // 2. class method signature: name followed immediately by '('
        var isMethod = false;
        if (pos == 0 and endPos < trimmed.length()) {
          var ch = trimmed[endPos];
          this.log.trace("    L" + i + " isMethod evaluation: pos=0, char at endPos(" + endPos + ")=" + chr(ch));
          if (ch == '(') {
            isMethod = true;
          }
        }

        this.log.trace("  L" + i + " flags: isDecl=" + isDecl + " isMethod=" + isMethod);


        if (isDecl or isMethod) {
          var endPos = pos + symbolName.length();
          if (endPos >= trimmed.length()) {
            isMatch = true;
          } else {
            var nextChar = trimmed[endPos];
            this.log.trace("    L" + i + " checking boundary nextChar=" + chr(nextChar));
            if (nextChar == ' ' or nextChar == '(' or nextChar == '{' or nextChar == ';' or nextChar == ':') {
              isMatch = true;
            }
          }
        }
      }

      this.log.trace("    L" + i + " isMatch=" + isMatch);

      if (isMatch) {
        this.log.trace("    L" + i + " MATCH CONFIRMED! Processing signature...");
        var signature = trimmed;
        if (signature.slice(-1) == "{") {
          signature = signature.slice(0, -1).trim();
        }

        this.log.trace("    L" + i + " extracting doc comments for line " + i);
        var docs = "";
        if (this.extraDocComments != nil) {
          docs = this.extractDocComments(lines, i);
        } else {
          this.log.trace("    L" + i + " extraDocComments is nil or missing!");
        }

        this.log.trace("    L" + i + " final result signature: '" + signature + "'");
        //return "```slox\n" + signature + "\n```" + docs;
        // send plain signature line directly without backticks
        return signature + docs;
      }
    }
    this.log.trace("findSymbolHover: finished loop without finding match for '" + symbolName +"'");
    return nil;
  }

  extraDocComments(lines, targetLineIndex) {
    var comments = [];
    var currIndex = targetLineIndex - 1;

    while (currIndex >= 0) {
      var line = lines[currIndex].trim();
      if (line.slice(0, 2) == "//") {
        var commentText = line.slice(2).trim();
        comments.push(commentText);
        currIndex -= 1;
      } else {
        break;
      }

      if (comments.length() == 0) return "";

      var docStr = "\n\n";
      docStr = docStr + comments.reverse() + "\n";
      return docStr;
    }
  }

  searchHoverInFile(symbolName, fileContent, fileUri, visitedFiles) {
    this.log.trace("searchHoverInFile: enter uri=" + fileUri);

    var hoverText = this.findSymbolHover(symbolName, fileContent);
    if (hoverText != nil) {
      this.log.trace("searchHoverInFile: match found in " + fileUri);
      return hoverText;
    }

    var lines = fileContent.split("\n");
    for (var i = 0; i < lines.length(); i += 1) {
      var line = lines[i].trim();

      if (line.slice(0, 8) == "require(") {
        var reqPath = this.extractRequirePath(line);
        this.log.trace("searchHoverInFile: found require path '" + reqPath + "'");

        if (reqPath != nil) {
          this.log.trace("searchHoverInFile: resolved path -> '" + reqPath + "'");
          var targetPath = this.resolvePath(fileUri, reqPath);

          if (targetPath != nil) {
            var targetUri = "file://" + targetPath;

            if (visitedFiles[targetUri] != true) {
              visitedFiles[targetUri] = true;
              this.log.trace("searchHoverInFile: loading file " + targetPath);

              var depContent = File.load(targetPath);
              if (depContent != nil) {
                var match = this.searchHoverInFile(symbolName, depContent, targetUri, visitedFiles);
                if (match != nil) return match;
              } else {
                this.log.error("searchHoverInFile: File.load returned nil for " + targetPath);
              }
            } else {
              this.log.trace("searchHoverInFile: skipping already visited file " + targetUri);
            }
          }
        }
      }
    }
    this.log.trace("searchHoverInFile: exit (no match) uri=" + fileUri);
    return nil;
  }

  searchHoverInDependencies(symbolName, activeContent, activeUri, visitedFiles) {
    if (visitedFiles == nil) visitedFiles = {};
    visitedFiles[activeUri] = true;

    this.log.trace("searchHoverInDependencies: starting for symbol '" + symbolName + "'");
    return this.searchHoverInFile(symbolName, activeContent, activeUri, visitedFiles);
  }

  handleHover(id, params) {
    this.log.debug("--> handleHover called");

    this.log.trace("handleHover: params=" + params);
    var textDoc = params["textDocument"];
    this.log.trace("handleHover: textDoc=" + textDoc);
    var pos = params["position"];

    var uri = textDoc["uri"];
    var line = pos["line"];
    var character = pos["character"];

    this.log.trace("handleHover: uri=" + uri + "pos=" + line + ":" + character);
    
    var text = this.documents[uri];
    if (text == nil) {
      this.log.debug("handleHover: document text is nil for uri: " + uri);
      this.sendResponse(id, nil);
      return;
    }

    var word = this.getWordAtPosition(text, line, character);
    this.log.debug("handleHover: extracted word: '" + word + "'");

    if (word == nil or word == "") {
      this.log.debug("handleHover: empty word, sending null response");
      this.sendResponse(id, nil);
      return;
    }

    this.log.debug("handleHover: searching in local document...");
    var markdownContent = this.findSymbolHover(word, text);

    if (markdownContent == nil) {
      this.log.debug("handleHover: symbol not found locally, searching dependencies...");
      markdownContent = this.searchHoverInDependencies(word, text, uri, {});
    }

    if (markdownContent != nil) {
      this.log.debug("handleHover: found hover content! Sending response.");
      var response = {
        "contents": {
          "kind": "markdown",
          "value": markdownContent
        }
      };
      this.sendResponse(id, response);
    } else {
      this.log.debug("handleHover: no hover content found, sending null response");
      this.sendResponse(id, nil);
    }
  }

  makeCompletionItem(label, kind, detail) {
    var item = {};
    item["label"] = label;
    item["kind"] = kind;
    item["detail"] = detail;
    return item;
  }

  extractSymbolsFromSource(text, sourceFilename, visitedFiles) {
    var symbols = [];
    if (text == nil) return symbols;

    var lines = text.split("\n");
    for (var i = 0; i < lines.length(); i += 1) {
      var line = lines[i].trim();
      var lineNum = i + 1;

      if (line.slice(0, 6) == "class ") {
        var rest = line.slice(6, line.length()).trim();
        var className = rest.split(" ")[0].split("{")[0].trim();
        if (className.length() > 0) {
          var detail = "Class defined in " + sourceFilename + " line " + lineNum;
          symbols.push(this.makeCompletionItem(className, 7, detail));
        }
      }

      if (line.slice(0, 4) == "fun ") {
        var rest = line.slice(4, line.length()).trim();
        var fnName = rest.split("(")[0].trim();
        if (fnName.length() > 0) {
          var detail = "Function defined in " + sourceFilename + " line " + lineNum;
          symbols.push(this.makeCompletionItem(fnName, 3, detail));
        }
      }

      if (line.slice(0, 4) == "var ") {
        var rest = line.slice(4, line.length()).trim();
        var varName = rest.split("=")[0].trim();
        if (varName.length() > 0) {
          var detail = "Variable defined in " + sourceFilename + " line " + lineNum;
          symbols.push(this.makeCompletionItem(varName, 6, detail));
        }
      }

      if (line.slice(0, 8) == "require(") {
        var reqPath = this.extractRequirePath(line);
        if (reqPath != nil) {
          var importedSymbols = this.loadRequiredSymbols(reqPath, visitedFiles);
          symbols = symbols + importedSymbols;
        }
      }
    }

    return symbols;
  }

  extractRequirePath(line) {
    var firstQuote = line.find("\"");
    if (firstQuote == nil) return nil;

    var rest = line.slice(firstQuote + 1, line.length());
    var secondQuote = rest.find("\"");
    if (secondQuote == nil) return nil;

    return rest.slice(0, secondQuote);
  }

  loadRequiredSymbols(relativePath, visitedFiles) {
    if (visitedFiles[relativePath] == true) return [];
    visitedFiles[relativePath] = true;

    var searchPaths = [
      relativePath,
      "./lib/" + relativePath,
      "/usr/lib64/slox/lib/" + relativePath
    ];

    var fileContent = nil;

    for (var i = 0; i < searchPaths.length(); i += 1) {
      var candidate = searchPaths[i];
      if (File.exists(candidate)) {
        fileContent = File.load(candidate);
        break;
      }
    }

    if (fileContent != nil) {
      return this.extractSymbolsFromSource(fileContent, relativePath, visitedFiles);
    }

    return [];
  }

  start() {
    this.log.info("Server event loop starting...");

    while (this.running) {
      var contentLength = 0;

      while (true) {
        var lineres = STDIN.readline();
        if (!lineres) break;

        var line = lineres.unwrap();
        if (line == nil or line == "\r\n" or line == "\n") break;

        line = line.trim();

        if (line.length() == 0) break;

        if (line.slice(0, 15) == "Content-Length:") {
          var parts = line.split(":");
          if (parts.length() > 1) {
            contentLength = Integer(parts[1].trim());
          }
        }
      }

      if (contentLength > 0) {
        var readRes = STDIN.read(contentLength);
        if (readRes) {
          var rawJson = readRes.unwrap();
          this.log.trace("RAW JSON RECV: " + rawJson);

          var message = Json.parse(rawJson);

          if (message != nil) {
            this.handleMessage(message);
          } else {
            this.log.error("Failed to parse incoming JSON payload: " + rawJson);
          }
        }
      }
    }
    this.log.info("Server event loop finished");
    this.log.close();
  }
}

var server = LSPServer();
server.start();
