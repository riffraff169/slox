    var trace = System.backtrace();
    STDERR.write("\n");
    STDERR.write("=============== LIVE SLOX STACK TRACE =================\n");
    for (var i = 0; i < trace.length(); i += 1) {
      STDERR.write("  " + trace[i] + "\n");
    }
    STDERR.write("=======================================================\n");
    });
*/

var server = LSPServer();
server.start();
