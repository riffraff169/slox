//@ ArgOption
// Class to just hold arguments for ArgParser
class ArgOption {
  init(name, shortName, isFlag, defaultValue, help, optional = false) {
    this.name = name;
    this.shortName = shortName;
    this.isFlag = isFlag;
    this.defaultValue = defaultValue;
    this.optional = optional;
    this.help = help;
  }
}

//@ ParsedArgs
// Returned from ArgParser as the parsed arguments.
class ParsedArgs {
  init() {
    this.opts = {};
    this.args = [];
  }

  __seti__(key, val) {
    this.set(key, val);
    return this;
  }

  //: set
  // Set key to val
  // Requires:
  //   String: key
  //   Value: val
  // Returns:
  //   this
  set(key, val) {
    this.opts[key] = val;
    return this;
  }

  __geti__(key) {
    return this.get(key);
  }

  //: get
  // Get value of key
  // Requires:
  //   String: key
  // Returns:
  //   Value
  get(key) {
    return this.opts[key];
  }
}

//@ ArgParser
// Argument parser class.
// See examples/test_argparser.lox
class ArgParser {
  init(programName, description) {
    this.programName = programName;
    this.description = description;

    this.optionList = [];
    this.flagMap = {};

    this.addFlag("help", "h", "Show this help message");
  }

  //: addFlag
  // Add a flag option. 
  // Example: parser.addOption("verbose", "v", "Enable debug logging");
  // Requires:
  //   String: name
  //   String: shortname
  //   String: help
  addFlag(name, shortName, help) {
    var opt = ArgOption(name, shortName, true, false, help);
    this.registerOption(opt);
  }

  //: addOption
  // Add a variable option
  // Example: parser.addOption("count", "c", "10", "Number of iterations");
  // Requires:
  //   String: name
  //   String: shortName
  //   String: deffaultValue
  //   String: help
  // Optional:
  //   Bool: optional
  addOption(name, shortName, defaultValue, help, optional = false) {
    var opt = ArgOption(name, shortName, false, defaultValue, help, optional);
    this.registerOption(opt);
  }

  registerOption(opt) {
    this.optionList.push(opt);

    this.flagMap["--" + opt.name] = opt;

    if (opt.shortName != nil) {
      this.flagMap["-" + opt.shortName] = opt;
    }
  }

  findOption(flagToken) {
    return this.flagMap[flagToken];
  }

  printHelp() {
    print "Usage: " + this.programName + " [options] [positional args...]";
    if (this.description != nil) {
      print this.description + "\n";
    }
    print "Options:";
    for (var i = 0; i < this.optionList.length(); i += 1) {
      var opt = this.optionList[i];
      var line = "  ";

      if (opt.shortName != nil) {
        line = line + "-" + opt.shortName + ", ";
      } else {
        line = line + "    ";
      }

      line = line + "--" + opt.name;
      if (!opt.isFlag) {
        line = line + " <value>";
      }

      var metaInfo = "";
      if (!opt.isFlag) {
        if (opt.defaultValue != nil) {
          metaInfo = " (default: " + opt.defaultValue + ")";
        } else if (!opt.optional) {
          metaInfo = " [REQUIRED]";
        }
      }

      print line + "\n\t" + opt.help + metaInfo;
    }
  }

  //: parse
  // Parse the provided args to create the options. Generally will be System.ARGV
  // Requires:
  //   Array: args
  // Returns:
  //   ParsedArgs
  parse(args) {
    var parsed = ParsedArgs();

    for (var i = 0; i < this.optionList.length(); i += 1) {
      var opt = this.optionList[i];
      parsed.set(opt.name, opt.defaultValue);
    }

    var idx = 0;
    var stopOptions = false;

    while (idx < args.length()) {
      var arg = args[idx];

      if (stopOptions) {
        parsed.args.push(arg);
        idx += 1;
      } else if (arg == "--") {
        stopOptions = true;
        idx += 1;
      } else {
        var opt = this.findOption(arg);

        if (opt != nil) {
          if (opt.name == "help") {
            this.printHelp();
            return nil;
          }

          if (opt.isFlag) {
            parsed.set(opt.name, true);
            idx += 1;
          } else {
            if (idx + 1 < args.length()) {
              parsed.set(opt.name, args[idx + 1]);
              idx += 2;
            } else {
              print "Error: Option '" + arg + "' requires a value.";
              this.printHelp();
              return nil;
            }
          }
        } else {
          parsed.args.push(arg);
          idx += 1;
        }
      }
    }

    for (var i = 0; i < this.optionList.length(); i += 1) {
      var opt = this.optionList[i];
      if (!opt.optional and parsed.get(opt.name) == nil) {
        print "Error: Missing required option '--" + opt.name + "'";
        this.printHelp();
        return nil;
      }
    }
    return parsed;
  }
}
