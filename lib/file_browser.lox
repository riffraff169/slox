require("canvas.lox");

// A directory-backed adapter around ListWidget. The widget knows nothing about
// files; this class scans a directory, supplies display labels, and maps the
// selected row back to a path.

var _fb_image_exts = ["png", "jpg", "jpeg", "bmp", "gif", "tga",
    "pnm", "ppm", "pgm", "pbm"];

fun _fb_join(dir, name) {
  var base = dir;
  while (base.length() > 1 and base[base.length() - 1] == "/") {
    base = base.slice(0, base.length() - 1);
  }
  if (base == "" or base == ".") return name;
  if (base == "/") return "/" + name;
  return base + "/" + name;
}

fun _fb_parent(path) {
  var base = path;
  while (base.length() > 1 and base[base.length() - 1] == "/") {
    base = base.slice(0, base.length() - 1);
  }
  var slash = base.rfind("/");
  if (slash < 0) return ".";
  if (slash == 0) return "/";
  return base.slice(0, slash);
}

fun _fb_is_image(name) {
  var dot = name.rfind(".");
  if (dot < 0) return false;
  var ext = name.slice(dot + 1, name.length()).to_lower();
  for (var i = 0; i < _fb_image_exts.length(); i += 1) {
    if (ext == _fb_image_exts[i]) return true;
  }
  return false;
}

class FileBrowser {
  // Required args:
  //   String: directory
  //   Canvas: canvas
  //   Function: onSelect
  // Optional args:
  //   Map: options
  //
  // Options:
  //   String: title
  //   Integer: rowHeight
  //   Number: fontSize
  //   Function: onClose
  init(directory, canvas, onSelect, options = nil) {
    this.path = directory;
    this.canvas = canvas;
    this.onSelect = onSelect;
    this.options = options;
    this.title = _canvas_option(options, "title", "Select an image");
    this.rowHeight = _canvas_option(options, "rowHeight", 24);
    this.fontSize = _canvas_option(options, "fontSize", 13.0);
    this.onClose = _canvas_option(options, "onClose", nil);
    this.headerHeight = 34;
    this.footerHeight = 30;
    this.entries = [];
    this.selected = -1;
    this.message = nil;
    this.closed = false;

    var self = this;
    var listHeight = canvas.height - this.headerHeight - this.footerHeight;
    if (listHeight < 0) listHeight = 0;
    this.list = ListWidget(0, this.headerHeight, canvas.width, listHeight, [],
        fun(item, index) { self._openEntry(index); }, {
          "rowHeight": this.rowHeight,
          "fontSize": this.fontSize,
          "selected": -1,
          "activateOnClick": true
        });
    this.refresh();
  }

  //: refresh
  // Re-read the current directory. The first image is selected by default.
  refresh() {
    var listed = Dir.list(this.path).unwrap();
    var entries = [];
    var parent = _fb_parent(this.path);
    if (parent != this.path) {
      entries.push({"name": "..", "path": parent, "isDir": true,
          "sortName": "..", "label": "[dir] .."});
    }

    if (listed != nil) {
      for (var i = 0; i < listed.length(); i += 1) {
        var name = listed[i];
        if (name == "." or name == "..") continue;
        if (name.length() > 1 and name[0] == ".") continue;

        var fullPath = _fb_join(this.path, name);
        if (Dir.isdir(fullPath)) {
          entries.push({"name": name, "path": fullPath, "isDir": true,
              "sortName": name.to_lower(), "label": "[dir] " + name});
        } else if (_fb_is_image(name)) {
          entries.push({"name": name, "path": fullPath, "isDir": false,
              "sortName": name.to_lower(), "label": "      " + name});
        }
      }
    }

    entries.sort(fun(a, b) {
      if (a["isDir"] != b["isDir"]) return a["isDir"] ? -1 : 1;
      return _canvas_compare_text(a["sortName"], b["sortName"]);
    });

    var labels = [];
    var firstImage = -1;
    for (var i = 0; i < entries.length(); i += 1) {
      labels.push(entries[i]["label"]);
      if (firstImage < 0 and !entries[i]["isDir"]) firstImage = i;
    }
    if (firstImage < 0 and entries.length() > 0) firstImage = 0;

    this.entries = entries;
    this.message = (entries.length() == 0) ?
        "No images found in " + this.path : nil;
    this.list.setItems(labels, firstImage);
    this.selected = this.list.selectedIndex();

    if (this.canvas != nil and !this.canvas.offscreen and this.title != nil) {
      this.canvas.setTitle(this.title + " - " + this.path);
    }
    return this;
  }

  //: navigate
  // Browse a different directory.
  navigate(path) {
    this.path = path;
    return this.refresh();
  }

  //: selectedEntry
  // Return the current entry Map, or nil when the list is empty.
  selectedEntry() {
    var index = this.list.selectedIndex();
    if (index < 0 or index >= this.entries.length()) return nil;
    this.selected = index;
    return this.entries[index];
  }

  //: imagePaths
  // Return the paths of image entries in display order.
  imagePaths() {
    var paths = [];
    for (var i = 0; i < this.entries.length(); i += 1) {
      if (!this.entries[i]["isDir"]) paths.push(this.entries[i]["path"]);
    }
    return paths;
  }

  //: selectPath
  // Highlight a currently listed path, if present.
  selectPath(path) {
    for (var i = 0; i < this.entries.length(); i += 1) {
      if (this.entries[i]["path"] == path) {
        this.list.select(i);
        this.selected = i;
        return true;
      }
    }
    return false;
  }

  //: moveSelection
  // Move the highlighted row by delta entries.
  moveSelection(delta, canvas = nil) {
    if (canvas != nil) this._syncBounds(canvas);
    this.list.move(delta);
    this.selected = this.list.selectedIndex();
    return this;
  }

  //: activate
  // Enter the selected directory, or report the selected image via onSelect.
  activate() {
    var used = this.list.activate();
    this.selected = this.list.selectedIndex();
    return used;
  }

  //: rowAt
  // Return the entry index under a mouse position, or -1 outside the list.
  rowAt(canvas, x, y) {
    this._syncBounds(canvas);
    return this.list.indexAt(x, y);
  }

  //: handleEvent
  // Process a parsed Canvas event. Returns true when the event was used.
  handleEvent(event, canvas = nil) {
    if (canvas == nil) canvas = this.canvas;
    if (event == nil or this.closed) return false;

    if (event["close"]) {
      this.close();
      return true;
    }

    var type = event["type"];
    if (type == X11.KeyPress and event["keysym"] == X11.XK_Escape) {
      this.close();
      return true;
    }

    this._syncBounds(canvas);
    var used = this.list.handle(event, canvas);
    this.selected = this.list.selectedIndex();
    return used;
  }

  //: draw
  // Render the browser onto its Canvas.
  draw(canvas = nil) {
    if (canvas == nil) canvas = this.canvas;
    this._syncBounds(canvas);
    canvas.clear(Canvas.BG);

    canvas.fillRect(0, 0, canvas.width, this.headerHeight, Canvas.PANEL);
    canvas.textTop(10, 7, this.title, Canvas.FG, this.fontSize + 2.0);
    canvas.textTop(10, this.headerHeight - this.fontSize - 3,
        _canvas_truncate_text(canvas, this.path, canvas.width - 20,
            this.fontSize), Canvas.MUTED, this.fontSize);

    canvas.fillRect(0, canvas.height - this.footerHeight, canvas.width,
        this.footerHeight, Canvas.PANEL);
    canvas.textTop(10, canvas.height - this.footerHeight + 7,
        "Up/Down: move  Enter/Space: open  Click: open  Esc: close",
        Canvas.MUTED, this.fontSize - 1.0);

    this.list.draw(canvas);
    return this;
  }

  //: close
  // Close the browser window and invoke onClose once.
  close() {
    if (this.closed) return;
    this.closed = true;
    if (this.canvas != nil and this.canvas.isOpen()) this.canvas.close();
    if (this.onClose != nil) this.onClose(this);
  }

  _openEntry(index) {
    var entry = this.entries[index];
    if (entry == nil) return false;
    if (entry["isDir"]) {
      this.navigate(entry["path"]);
      return true;
    }
    if (this.onSelect != nil) this.onSelect(entry["path"]);
    return true;
  }

  _syncBounds(canvas) {
    var height = canvas.height - this.headerHeight - this.footerHeight;
    if (height < 0) height = 0;
    this.list.setBounds(0, this.headerHeight, canvas.width, height);
  }
}
