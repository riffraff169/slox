class Base {
  init(baseValue) {
    this.baseValue = baseValue;
  }
}

class User < Base {
  include FieldIndex;

  init(name, role) {
    super.init("base");
    this.name = name;
    this.role = role;
  }
}

var u = User("Lance", "Architect");

print u["name"];      // expect: Lance
print u.name;         // expect: Lance
print u["role"];      // expect: Architect
print u["baseValue"]; // expect: base

var key = "role";
print u[key]; // expect: Architect

u[key] = "Principal Architect";
print u.role; // expect: Principal Architect

u["title"] = "Chief";
print u.title; // expect: Chief

u["baseValue"] = "updated";
print u.baseValue; // expect: updated

print u["missing"]; // expect: nil

print u.get_field("name"); // expect: Lance
u.set_field("role", "Lead");
print u["role"]; // expect: Lead
