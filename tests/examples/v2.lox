fun logger(prefix, level = "INFO", ...messages) {
  print "[" + level + "] " + prefix + ":";
  
  // Assuming you have a length() method or similar for your ObjArray
  for (var i = 0; i < messages.len(); i = i + 1) {
    print "  - " + messages[i];
  }
}

print "--- Test 1: Full arguments ---";
logger("Render", "DEBUG", "Ray 1 hit", "Ray 2 miss");

print "--- Test 2: Using default level ---";
logger("System", "Service started", "Memory OK");

print "--- Test 3: Only required arg ---";
logger("Cleanup");

// expect: --- Test 1: Full arguments ---
// expect: [DEBUG] Render:
// expect:   - Ray 1 hit
// expect:   - Ray 2 miss
// expect: --- Test 2: Using default level ---
// expect: [Service started] System:
// expect:   - Memory OK
// expect: --- Test 3: Only required arg ---
// expect: [INFO] Cleanup:
