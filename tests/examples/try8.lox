// Test 1: Throw a number
try {
  throw 123;
} catch (e) {
  print "Caught " + e; // If this prints, you support numeric throws

}

// Test 2: Throw nil
try {
  throw nil;
} catch (e) {
  print "Caught nil"; // If this works, you support nil throws

}

// Test 3: Throw an instance
class MyError < Error {}
try {
  throw MyError();
} catch (Error e) {
  print "Caught object"; // If this works, you support object throws

}

try {
  try {
    throw "Inner Error";
  } catch (Error e) {
    print "Caught inner: " + e.message;
    throw e;
  } catch (e) {
    print "Caught inner: " + e;
    throw e;
  }
} catch (Error e) {
  print "Caught outer: " + e.message;
} catch (e) {
  print "Caught outer: " + e;
}

// expect: Caught 123
// expect: Caught nil
// expect: Caught object
// expect: Caught inner: Inner Error
// expect: Caught outer: Inner Error
