// Map/Set keys are distinct across numeric types, even though `==` coerces.
// Keys that compare equal within the same type must still hash equally.

print 100 == 100.0; // expect: true

var m = Map();
m[0] = "int";
m[0.0] = "float";
print m.len();      // expect: 2
print m[0];         // expect: int
print m[0.0];       // expect: float
print m.has(0.0);   // expect: true

var n = Map();
n[0.0] = "float";
n[0] = "int";
print n.len();      // expect: 2
print n[0.0];       // expect: float
print n[0];         // expect: int

// Same-type negative zero must hash like positive zero in a large table.
var nz = 0.0 / -1.0;
var z = Map();
for (var i = 1; i <= 100; i = i + 1) {
    z[i] = i;
}
z[0.0] = "zero";
print z[nz];        // expect: zero

// Vec3 components follow the same same-type equality rules.
var a = Vec3(0.0, 0.0, 0.0);
var b = Vec3(nz, 0.0, 0.0);
var v = Map();
for (var i = 0; i < 100; i = i + 1) {
    v[Vec3(1.0, i, 0.0)] = i;
}
v[a] = "vec";
print v[b];         // expect: vec
