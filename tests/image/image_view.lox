require("image_view.lox");

class FakeZoomImage {
  init(width, height) {
    this.width = width;
    this.height = height;
    this.bytes = Buffer.alloc(width * height * 4);
  }

  get_bytes() { return this.bytes; }
  has_method(name) { return false; }
}

var view = ImageView.fromFile("tests/image/fixture.png");
print view.width;
// expect: 2
print view.height;
// expect: 2
print view.getPixel(0, 0);
// expect: [255, 0, 0, 255]
print view.getPixel(0, 1);
// expect: [0, 0, 255, 128]

view.setPixel(1, 1, [10, 20, 30, 200]);
print view.getPixel(1, 1);
// expect: [10, 20, 30, 200]
print view.image.get_pixel(1, 1);
// expect: [10, 20, 30, 200]

var pixels = view.getPixels();
pixels[0] = 7;
view.refreshFromPixels();
print view.getPixel(0, 0);
// expect: [7, 0, 0, 255]

var canvas = Canvas.offscreen(4, 4);
canvas.clear();
view.draw(canvas, 0, 0, 4, 4);
view.draw(canvas, 0, 0, 4, 4, "bilinear");
view.draw(canvas, 0, 0, 4, 4, Cairo.FILTER_GOOD);
print canvas.savePng("/tmp/slox_image_view_test.png");
// expect: 0

view.syncImage();
print view.image.get_pixel(0, 0);
// expect: [7, 0, 0, 255]

view.release();
print view.cairoSurface() == nil;
// expect: true
view.refresh();
print view.cairoSurface() != nil;
// expect: true

view.dispose();
print view.cairoSurface() == nil;
// expect: true
view.refresh();
print view.cairoSurface() != nil;
// expect: true

var zoomView = ImageView(FakeZoomImage(100, 50));
var zoomCanvas = Canvas.offscreen(100, 50);
zoomView.canvas = zoomCanvas;
print zoomView.zoomSize();
// expect: [100, 50]
zoomView.zoomIn();
print zoomView.zoomSize();
// expect: [110, 55]
print zoomCanvas.width + "x" + zoomCanvas.height;
// expect: 110x55
print zoomView.width + "x" + zoomView.height;
// expect: 100x50
print zoomView.image.width + "x" + zoomView.image.height;
// expect: 100x50
print zoomView.cairoSurface() != nil;
// expect: true
zoomView.zoomOut();
print zoomView.zoomSize();
// expect: [100, 50]
zoomView.zoomIn();
zoomView.zoomIn();
zoomView.zoomIn();
zoomView.zoomOut();
zoomView.zoomOut();
zoomView.zoomOut();
print zoomView.zoomSize();
// expect: [100, 50]
zoomView.zoomTo(0.5);
print zoomView.zoomSize();
// expect: [50, 25]
zoomView.zoomReset();
print zoomView.zoomSize();
// expect: [100, 50]
print zoomCanvas.width + "x" + zoomCanvas.height;
// expect: 100x50

print ImageView.fitSize(100, 50, 40, 40);
// expect: [40, 20]
print ImageView.fitSize(100, 50, 200, 200);
// expect: [100, 50]

var fitCanvas = Canvas.offscreen(80, 80);
zoomView.canvas = fitCanvas;
print zoomView.isFitToWindow();
// expect: false
zoomView.fitToWindow();
print zoomView.isFitToWindow();
// expect: true
print zoomView.fitRect(0, 0, 80, 80);
// expect: [0, 20, 80, 40]
zoomView.draw(fitCanvas, 0, 0, fitCanvas.width, fitCanvas.height);
print fitCanvas.width + "x" + fitCanvas.height;
// expect: 80x80
zoomView.zoomIn();
print zoomView.isFitToWindow();
// expect: false
print fitCanvas.width + "x" + fitCanvas.height;
// expect: 110x55

var limited = ImageView.offscreen("tests/image/fixture.png", nil, nil,
    {"maxWidth": 1, "maxHeight": 1});
print limited.canvas.width + "x" + limited.canvas.height;
// expect: 1x1
limited.close();

canvas.close();
view.close();
zoomCanvas.close();
zoomView.close();
System.gc();
print "done";
// expect: done
