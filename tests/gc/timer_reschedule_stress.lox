GC.stress_mode(GC.StressMode);
require("timer.lox");

var runs = 0;
var timer = nil;

fun schedule_next() {
  timer = Timer.setTimeout(0, fun() {
    timer.cancel();
    runs = runs + 1;

    if (runs < 3) {
      schedule_next();
    } else {
      print runs; // expect: 3
      GC.stress_mode(GC.NormalMode);
    }
  });
}

schedule_next();
