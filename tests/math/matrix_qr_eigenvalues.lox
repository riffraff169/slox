require("matrix.lox");
require("polynomial.lox");

var a = Matrix(2, 3, [1, 2, 3, 4, 5, 6]);
var b = Matrix(3, 2, [7, 8, 9, 10, 11, 12]);
var product = a.mul(b);

print "shape=" + product.rows + "x" + product.cols; // expect: shape=2x2
print "product=" + product.get(0, 0) + "," + product.get(0, 1) + "," +
      product.get(1, 0) + "," + product.get(1, 1); // expect: product=58,64,139,154

var poly = Polynomial([1, -6, 11, -6]);
var roots = poly.companionMatrix().eigenvaluesQR(30);

print "root_count=" + roots.length(); // expect: root_count=3
print "roots=" + roots[0] + "," + roots[1] + "," + roots[2]; // expect: roots=3.00001,1.99999,1
