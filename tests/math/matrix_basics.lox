require("matrix.lox");

fun maxResidual(matrix, lambda, vector) {
  var left = matrix.mul(vector);
  var right = vector.mul(lambda);
  var maxDiff = 0;
  for (var i = 0; i < matrix.rows; i += 1) {
    var diff = left.get(i, 0) - right.get(i, 0);
    if (diff < 0) diff = -diff;
    if (diff > maxDiff) maxDiff = diff;
  }
  return maxDiff;
}

var A = Matrix(2, 2, [4, 1, 2, 3]);

print "det=" + A.det();   // expect: det=10
print "trace=" + A.trace(); // expect: trace=7

var eigen = A.eigen2x2();
var values = eigen["values"];
var vectors = eigen["vectors"];

print "values=" + Math.to_fixed(values[0], 3) + "," + Math.to_fixed(values[1], 3); // expect: values=5.000,2.000
print "residual1=" + Math.to_fixed(maxResidual(A, values[0], vectors[0]), 6);      // expect: residual1=0.000000
print "residual2=" + Math.to_fixed(maxResidual(A, values[1], vectors[1]), 6);      // expect: residual2=0.000000

var rotation = Matrix(2, 2, [0, -1, 1, 0]);
var complexValues = rotation.eigen2x2();

print "complex_count=" + complexValues.length(); // expect: complex_count=2
print "complex_types=" + typeof(complexValues[0]) + "," + typeof(complexValues[1]); // expect: complex_types=Complex,Complex
print "complex1=" + Math.to_fixed(complexValues[0].real, 3) + "," + Math.to_fixed(complexValues[0].imag, 3); // expect: complex1=0.000,1.000
print "complex2=" + Math.to_fixed(complexValues[1].real, 3) + "," + Math.to_fixed(complexValues[1].imag, 3); // expect: complex2=0.000,-1.000
