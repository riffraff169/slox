// Functional helpers added in stdlib.lox on top of the native Array methods.
var nums = [1, 2, 3, 4];

print nums.all(fun(x) { return x > 0; }); // expect: true
print nums.every(fun(x) { return x < 4; }); // expect: false
print nums.any(fun(x) { return x > 3; }); // expect: true
print nums.some(fun(x) { return x > 10; }); // expect: false

// Without a predicate, all/any use element truthiness.
print [nil, 0, false].all(); // expect: false
print [1, true, "x"].any(); // expect: true
print [].all(); // expect: true
print [].any(); // expect: false

print [[1, 2], [3]].flat_map(fun(x) { return x; }); // expect: [1, 2, 3]
print [1, 2].flat_map(fun(x) { return [x, x * 2]; }); // expect: [1, 2, 2, 4]

var indexed = [];
nums.each_with_index(fun(x, i) { indexed.push(i * 10 + x); });
print indexed; // expect: [1, 12, 23, 34]
print nums.each_with_index(fun(x, i) {}).len(); // expect: 4

var groups = [1, 2, 3, 4].group_by(fun(x) { return x % 2; });
print groups.keys().sort(); // expect: [0, 1]
print groups[0]; // expect: [2, 4]
print groups[1]; // expect: [1, 3]

print [1, 2, 2, 3, 1].uniq(); // expect: [1, 2, 3]
print [[1], [1], [2]].uniq(); // expect: [[1], [2]]
print [1, 2, 2, 3].unique(); // expect: [1, 2, 3]
print [1, nil, 2, nil].compact(); // expect: [1, 2]

print [3, 1, 4, 2].min(); // expect: 1
print [3, 1, 4, 2].max(); // expect: 4
print ["b", "a"].min(); // expect: a
print ["b", "a"].max(); // expect: b
print [].min(); // expect: nil
print [].max(); // expect: nil
