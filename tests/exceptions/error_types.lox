// Builtin error classes are global and constructible.
try { throw ArgumentError("boom"); } catch (Error e) {
  print e.class_name() + ":" + e.message; // expect: ArgumentError:boom
}
try { throw LoadError("boom"); } catch (Error e) {
  print e.class_name() + ":" + e.message; // expect: LoadError:boom
}
try { throw NameError("boom"); } catch (Error e) {
  print e.class_name() + ":" + e.message; // expect: NameError:boom
}
try { throw RegexError("boom"); } catch (Error e) {
  print e.class_name() + ":" + e.message; // expect: RegexError:boom
}
try { throw SyntaxError("boom"); } catch (Error e) {
  print e.class_name() + ":" + e.message; // expect: SyntaxError:boom
}
try { throw SystemError("boom"); } catch (Error e) {
  print e.class_name() + ":" + e.message; // expect: SystemError:boom
}
try { throw TypeError("boom"); } catch (Error e) {
  print e.class_name() + ":" + e.message; // expect: TypeError:boom
}

// Specific catches match by class hierarchy.
try { throw TypeError("specific"); } catch (TypeError e) {
  print e.class_name(); // expect: TypeError
}
try { throw TypeError("sibling"); } catch (NameError e) {
  print "wrong catch";
} catch (Error e) {
  print e.class_name(); // expect: TypeError
}

// Explicit Error construction still uses plain Error.
try { throw Error("plain"); } catch (Error e) {
  print e.class_name() + ":" + e.message; // expect: Error:plain
}

// Internal arity and type checks now throw subclasses that Error also catches.
try { Map().each(); } catch (Error e) {
  print e.class_name(); // expect: ArgumentError
}
class MyError < Error {}
try { throw MyError("mine"); } catch (Error e) {
  print e.class_name(); // expect: MyError
}
