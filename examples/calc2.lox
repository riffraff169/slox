require("notcurses.lox");

// Precedence levels for Pratt parsing
var PREC_NONE = 0;
var PREC_ASSIGNMENT = 1;
var PREC_ADDITIVE = 2;
var PREC_FACTOR = 3;
var PREC_POWER = 4;
var PREC_UNARY = 5;
var PREC_CALL = 6;

// Token structure
class Token {
  init(type, text, value) {
    this.type = type;
    this.text = text;
    this.value = value;
  }
}

// Lexer / Tokenizer
fun tokenize(source) {
  var tokens = [];
  var i = 0;
  var len = source.len();

  while (i < len) {
    var c = source[i];

    // Skip whitespace
    if (c == ' ' or c == '\t' or c == '\r' or c == '\n') {
      i = i + 1;
    } else if (c == '+') { tokens.push(Token("PLUS", "+", nil)); i = i + 1; }
    else if (c == '-') { tokens.push(Token("MINUS", "-", nil)); i = i + 1; }
    else if (c == '*') { tokens.push(Token("STAR", "*", nil)); i = i + 1; }
    else if (c == '/') { tokens.push(Token("SLASH", "/", nil)); i = i + 1; }
    else if (c == '^') { tokens.push(Token("CARET", "^", nil)); i = i + 1; }
    else if (c == '(') { tokens.push(Token("LPAREN", "(", nil)); i = i + 1; }
    else if (c == ')') { tokens.push(Token("RPAREN", ")", nil)); i = i + 1; }
    else if ((c >= '0' and c <= '9') or c == '.') {
      var numStr = "";
      while (i < len and ((source[i] >= '0' and source[i] <= '9') or source[i] == '.')) {
        numStr = numStr + chr(source[i]);
        i = i + 1;
      }
      tokens.push(Token("NUMBER", numStr, Number(numStr)));
    } else if ((c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_') {
      var identStr = "";
      while (i < len and ((source[i] >= 'a' and source[i] <= 'z') or (source[i] >= 'A' and source[i] <= 'Z') or (source[i] >= '0' and source[i] <= '9') or source[i] == '_')) {
        identStr = identStr + chr(source[i]);
        i = i + 1;
      }
      tokens.push(Token("IDENTIFIER", identStr, identStr));
    } else {
      i = i + 1; // Ignore unknown characters
    }
  }

  tokens.push(Token("EOF", "", nil));
  return tokens;
}

// Dynamic Pratt Parser Engine
class Parser {
  init(tokens) {
    this.tokens = tokens;
    this.current = 0;
    this.env = {
      "PI": 3.141592653589793,
      "pi": 3.141592653589793,
      "E": 2.718281828459045,
      "e": 2.718281828459045,
      "X": 0.0,
      "x": 0.0,
      "Ans": 0.0
    };
    this.modeRadian = true;
  }

  peek() {
    return this.tokens[this.current];
  }

  advance() {
    var tok = this.tokens[this.current];
    if (tok.type != "EOF") {
      this.current = this.current + 1;
    }
    return tok;
  }

  consume(type, message) {
    if (this.peek().type == type) {
      return this.advance();
    }
    print "Error: " + message;
    return nil;
  }

  setVar(name, val) {
    this.env[name] = val;
  }

  currentPrecedence() {
    var type = this.peek().type;
    if (type == "PLUS" or type == "MINUS") return PREC_ADDITIVE;
    if (type == "STAR" or type == "SLASH") return PREC_FACTOR;
    if (type == "CARET") return PREC_POWER;
    return PREC_NONE;
  }

  parseExpression(precedence) {
    var token = this.advance();
    var left = this.parsePrefix(token);

    while (precedence < this.currentPrecedence()) {
      token = this.advance();
      left = this.parseInfix(left, token);
    }

    return left;
  }

  parsePrefix(token) {
    if (token.type == "NUMBER") return token.value;

    if (token.type == "IDENTIFIER") {
      // Functions
      if (this.isFunction(token.value)) {
        var fnName = token.value;
        this.consume("LPAREN", "Expected '(' after function name.");
        var arg = this.parseExpression(PREC_NONE);
        this.consume("RPAREN", "Expected ')' after function argument.");
        return this.evalFunction(fnName, arg);
      }
      // Variables
      if (this.env.has(token.value)) return this.env[token.value];
      return 0.0;
    }

    if (token.type == "MINUS") {
      return -this.parseExpression(PREC_UNARY);
    }

    if (token.type == "LPAREN") {
      var expr = this.parseExpression(PREC_NONE);
      this.consume("RPAREN", "Expected ')' after expression.");
      return expr;
    }

    return 0.0;
  }

  parseInfix(left, token) {
    if (token.type == "PLUS") return left + this.parseExpression(PREC_ADDITIVE);
    if (token.type == "MINUS") return left - this.parseExpression(PREC_ADDITIVE);
    if (token.type == "STAR") return left * this.parseExpression(PREC_FACTOR);
    if (token.type == "SLASH") {
      var right = this.parseExpression(PREC_FACTOR);
      if (right == 0) return 0.0;
      return left / right;
    }
    if (token.type == "CARET") return left ** this.parseExpression(PREC_POWER - 1);
    return left;
  }

  evalFunction(fn, arg) {
    var targ = this.modeRadian ? arg : (arg * 3.141592653589793 / 180.0);
    if (fn == "sin") return Math.sin(targ);
    if (fn == "cos") return Math.cos(targ);
    if (fn == "tan") return Math.tan(targ);
    if (fn == "sqrt") return Math.sqrt(arg);
    if (fn == "log") return Math.log(arg);
    if (fn == "abs") return Math.abs(arg);
    return 0.0;
  }

  isFunction(name) {
    return name == "sin" or name == "cos" or name == "tan" or
           name == "sqrt" or name == "log" or name == "abs";
  }

  evalAt(xVal) {
    this.current = 0; // Reset token cursor
    this.env["X"] = xVal;
    this.env["x"] = xVal;
    return this.parseExpression(PREC_NONE);
  }
}

// Graph Plotting Engine
class GraphWindow {
  init(xMin, xMax, yMin, yMax, width, height) {
    this.xMin = xMin;
    this.xMax = xMax;
    this.yMin = yMin;
    this.yMax = yMax;
    this.width = width;
    this.height = height;
  }

  mathToPixelY(y) {
    if (y != y or y == nil) return -1;
    var norm = (y - this.yMin) / (this.yMax - this.yMin);
    var py = ((1.0 - norm) * (this.height - 1)).floor();
    if (py < 0 or py >= this.height) return -1;
    return py;
  }

  drawVerticalSpan(pixelBuffer, px, y0, y1, color) {
    if (y0 < 0 and y1 < 0) return;
    if (y0 >= this.height and y1 >= this.height) return;

    var startY = y0 < y1 ? y0 : y1;
    var endY = y0 > y1 ? y0 : y1;

    if (startY < 0) startY = 0;
    if (endY >= this.height) endY = this.height - 1;

    for (var py = startY; py <= endY; py = py + 1) {
      pixelBuffer.setPixel(px, py, color);
    }
  }

  render(pixelBuffer, parser, color) {
    pixelBuffer.clear(0x1E1E1EFF); // Dark background

    // 1. Draw Axes
    var axisX = (((0.0 - this.xMin) / (this.xMax - this.xMin)) * (this.width - 1)).floor();
    var axisY = this.mathToPixelY(0.0);

    if (axisX >= 0 and axisX < this.width) {
      for (var py = 0; py < this.height; py = py + 1) {
        pixelBuffer.setPixel(axisX, py, 0x444444FF);
      }
    }
    if (axisY >= 0 and axisY < this.height) {
      for (var px = 0; px < this.width; px = px + 1) {
        pixelBuffer.setPixel(px, axisY, 0x444444FF);
      }
    }

    // 2. Plot Curve using Pratt Parser
    var prevPy = -1;
    for (var px = 0; px < this.width; px = px + 1) {
      var x = this.xMin + (px / (this.width - 1)) * (this.xMax - this.xMin);
      var y = parser.evalAt(x);
      var py = this.mathToPixelY(y);

      if (px == 0 or prevPy == -1) {
        if (py >= 0 and py < this.height) {
          pixelBuffer.setPixel(px, py, color);
        }
      } else {
        this.drawVerticalSpan(pixelBuffer, px, prevPy, py, color);
      }
      prevPy = py;
    }
  }
}

// Calculator TUI Controller
class CalculatorTUI {
  init(nc) {
    this.nc = nc;
    this.stdPlane = nc.get_stdplane();

    this.graphWidth = 320;
    this.graphHeight = 160;
    this.pixelBuffer = PixelBuffer(this.graphWidth, this.graphHeight);

    this.window = GraphWindow(-10.0, 10.0, -2.0, 2.0, this.graphWidth, this.graphHeight);
    this.history = [];

    this.currentInput = "sin(x)";
    this.plotExpr = "sin(x)";
    this.statusMessage = "OK";
  }

  run() {
    var plotExpr = "2 * x^2 + 5 * x + 3";
    var running = true;

    while (running) {
      this.stdPlane.erase();

      // 1. Tokenize & Parse Plot Expression
      var tokens = tokenize(plotExpr);
      var parser = Parser(tokens);

      // 2. Render plot to pixel buffer
      this.window.render(this.pixelBuffer, parser, 0x00E5FFFF);

      // 3. Blit pixel buffer using hardware pixel mode (BLIT_PIXEL = 7 with CHILDPLANE / flags = 32)
      var visual = Visual(this.pixelBuffer, this.nc);
      var childPlane = visual.blit(this.stdPlane, Visual.BLIT_PIXEL, Visual.SCALE_NONE, 2, 0);

      // 4. Draw Overlay Text
      this.stdPlane.set_fg(0x00, 0xFF, 0xD7);
      this.stdPlane.put_str(0, 0, "MODE: RAD | WINDOW: [-10, 10, -2, 2] | Y1 = " + plotExpr);

      this.stdPlane.set_fg(0x88, 0x88, 0x88);
      this.stdPlane.put_str(1, 0, "Press 'q' or 'Esc' to exit");

      this.nc.render();

      // 5. Cleanup visual frame resources
      if (childPlane != nil) childPlane.destroy();
      visual.destroy();

      // Key Listener
      var key = this.nc.get_key();
      if (key == "q" or key == "Esc") {
        running = false;
      }
    }

    this.nc.stop();
  }
}

fun main() {
  var nc = Notcurses();
  var app = CalculatorTUI(nc);
  app.run();
}

main();
