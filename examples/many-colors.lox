require("color.lox");

var width = 16.0;
var height = 16.0;

// ============================================================================
// 1. Diagonal Gradient (Upper-Left to Lower-Right)
// Blends from Cyan [0, 255, 255] down to Gold [255, 204, 0]
// ============================================================================
print "Diagonal Gradient (16x16):";

var startR = 0.0;   var startG = 255.0; var startB = 255.0; // Cyan
var endR   = 255.0; var endG   = 204.0; var endB   = 0.0;   // Gold

var maxSteps = (width - 1.0) + (height - 1.0);

for (var y = 0.0; y < height; y += 1.0) {
  var line = "";
  for (var x = 0.0; x < width; x += 1.0) {
    // Progress factor t from 0.0 (top-left) to 1.0 (bottom-right)
    var t = (x + y) / maxSteps;

    // Linear interpolation coerced to integer via bitwise OR
    var r = (startR + t * (endR - startR)).floor();
    var g = (startG + t * (endG - startG)).floor();
    var b = (startB + t * (endB - startB)).floor();

    line = line + Color.rgb(r, g, b, true) + "  ";
  }
  line = line + Color.RESET;
  print line;
}
print "";

// ============================================================================
// 2. 2D Bilinear Color Surface (4-Corner Blend)
// Top-Left: Magenta | Top-Right: Yellow
// Bottom-Left: Blue  | Bottom-Right: Green
// ============================================================================
print "2D Bilinear Surface (16x16):";

for (var y = 0.0; y < height; y += 1.0) {
  var line = "";
  for (var x = 0.0; x < width; x += 1.0) {
    // Normalize coordinates to [0.0, 1.0]
    var u = x / (width - 1.0);
    var v = y / (height - 1.0);

    // Calculate RGB channels across 2D plane
    var r = (u * 255.0).floor();
    var g = (v * 255.0).floor();
    var b = ((1.0 - u) * 255.0).floor();

    line = line + Color.rgb(r, g, b, true) + "  ";
  }
  line = line + Color.RESET;
  print line;
}
print "";
