class Mixin {
  test() { print "from mixin"; }
  foo() { print this.string; }
}

class Local {
  include Mixin;
  init() {
    this.string = "booya";
  }
  test() { print "from local"; }
}

class L2 {
  include Mixin;
  init() {
    this.string = "booya";
  }
  notest() { print "notest"; }
}

Local().test();
L2().test();
L2().notest();
L2().foo();
