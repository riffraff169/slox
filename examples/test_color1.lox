require("sloxcolorizer.lox");

var sampleCode = "
// Simple Slox Example
class Person {
    init(name) {
          this.name = name;
            }

      greet() {
            var msg = \"Hello, \" + this.name;
                return msg;
                  }
}
";

// 1. Output directly to ANSI Terminal
print SloxColorizer.toTerminal(sampleCode);

// 2. Generate HTML File content
var htmlOutput = SloxColorizer.toHtml(sampleCode, true);
// Stdio.write_file("output.html", htmlOutput); // If your Slox VM has file write builtins
