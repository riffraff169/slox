#!/usr/bin/env slox
// Minimal image viewer: open the first non-option argument, or browse a
// directory and choose images from a second Canvas window. The browser stays
// open after a selection so another image can be chosen.
// Usage: slox examples/image_viewer.lox <image-or-directory>
//
// Options are intentionally limited to the built-in -h/--help.
// Viewer keys: q quit, n/p next/previous image, +/- zoom, 0 reset zoom,
// f fit image to window (letterboxed). With no DISPLAY, one frame is rendered
// to image_viewer.png.

require("argparser.lox");
require("image_view.lox");
require("file_browser.lox");

var parser = ArgParser("slox examples/image_viewer.lox",
                       "Display an image in a window, or browse a directory.");
var parsed = parser.parse(System.ARGS);

if (parsed == nil) System.exit(0);

if (parsed.args.length() < 1) {
  print "Error: Missing image filename.";
  print "Usage: slox examples/image_viewer.lox <image-or-directory>";
  System.exit(1);
}

var filename = parsed.args[0];
var view = nil;
var canvas = nil;
var browser = nil;
var browserCanvas = nil;
var running = true;
var fileList = [];
var fileIndex = -1;
var currentPath = nil;
var fitMode = false;

fun windowOpen(target) {
  return target != nil and target.isOpen();
}

fun updateTitle() {
  if (view == nil or canvas == nil) return;
  var name = "image";
  if (currentPath != nil) name = Dir.basename(currentPath);
  var zoomLabel = "FIT";
  if (!view.isFitToWindow()) {
    var percent = Math.floor(canvas.width * 100.0 / view.image.width + 0.5);
    zoomLabel = "" + percent + "%";
  }
  canvas.setTitle("slox image view - " + name + " - " + view.image.width + "x" +
      view.image.height + " - " + zoomLabel);
}

fun quit() {
  running = false;
  if (browser != nil) browser.close();
  else if (browserCanvas != nil and browserCanvas.isOpen()) browserCanvas.close();
  if (view != nil) view.close();
}

fun indexOfPath(paths, path) {
  for (var i = 0; i < paths.length(); i += 1) {
    if (paths[i] == path) return i;
  }
  return -1;
}

fun registerViewerEvents(target) {
  target.on("keypress", fun(c, event) {
    var key = event["text"];
    if (key == nil) return;

    if (key == "q" or key == "Q") {
      quit();
    } else if (key == "n" or key == "N") {
      stepFile(1);
    } else if (key == "p" or key == "P") {
      stepFile(-1);
    } else if (key == "+" or key == "=") {
      fitMode = false;
      view.zoomIn();
      updateTitle();
    } else if (key == "-" or key == "_") {
      fitMode = false;
      view.zoomOut();
      updateTitle();
    } else if (key == "0") {
      fitMode = false;
      view.zoomReset();
      updateTitle();
    } else if (key == "f" or key == "F") {
      fitMode = !fitMode;
      view.fitToWindow(fitMode);
      updateTitle();
    }
  });

  target.on("close", fun(c, event) { quit(); });
}

fun drawImage(c) {
  c.clear(Canvas.BG);
  view.draw(c, 0, 0, c.width, c.height);
}

fun drawBrowser(c) {
  if (browser != nil) browser.draw(c);
}

fun renderOffscreenImage() {
  canvas.render(drawImage);
  print "No display available; wrote image_viewer.png";
  print canvas.savePng("image_viewer.png");
  running = false;
}

fun openImage(path) {
  var nextView;
  try {
    nextView = ImageView.window(path, nil, nil, "slox image view - " + path);
  } catch (e) {
    print "Error: Could not open '" + path + "': " + e.message;
    return false;
  }

  if (view != nil) view.close();
  view = nextView;
  canvas = view.canvas;
  currentPath = path;
  registerViewerEvents(canvas);
  if (fitMode) view.fitToWindow();
  updateTitle();
  if (browser != nil) browser.selectPath(path);

  if (canvas.offscreen) renderOffscreenImage();
  return true;
}

fun stepFile(delta) {
  if (fileList.length() == 0) return;
  var count = fileList.length();
  var previous = fileIndex;
  var next = fileIndex;
  if (next < 0) next = 0;
  next = next + delta;
  while (next < 0) next = next + count;
  while (next >= count) next = next - count;

  fileIndex = next;
  if (!openImage(fileList[fileIndex])) fileIndex = previous;
}

fun openBrowser(path) {
  browserCanvas = Canvas.window(520, 640, "Select image", {"x": 100, "y": 80});
  browser = FileBrowser(path, browserCanvas, fun(selected) {
    var oldList = fileList;
    var oldIndex = fileIndex;
    fileList = browser.imagePaths();
    fileIndex = indexOfPath(fileList, selected);
    if (fileIndex < 0) {
      fileList = [selected];
      fileIndex = 0;
    }
    if (!openImage(selected)) {
      fileList = oldList;
      fileIndex = oldIndex;
    }
  }, {
    "title": "slox image browser",
    "onClose": fun(b) {
      if (view == nil) running = false;
    }
  });

  browserCanvas.on("event", fun(c, event) {
    if (browser != nil) browser.handleEvent(event, c);
  });

  if (browserCanvas.offscreen) {
    browserCanvas.render(drawBrowser);
    print "No display available; wrote file_browser.png";
    print browserCanvas.savePng("file_browser.png");
    running = false;
  } else {
    print "Up/Down = move, Enter/Space = open, click = open, Esc = close";
    print "Viewer: n/p = next/previous, +/- zoom, 0 reset, f fit, q = quit";
  }
}

// Yields to both windows because Canvas.run() only pumps one canvas at a time.
fun runWindows() {
  while (running and (windowOpen(browserCanvas) or windowOpen(canvas))) {
    if (windowOpen(browserCanvas)) {
      browserCanvas.handleEvents();
      if (windowOpen(browserCanvas)) browserCanvas.render(drawBrowser);
    }

    if (windowOpen(canvas)) {
      canvas.handleEvents();
      if (windowOpen(canvas)) canvas.render(drawImage);
    }

    System.sleep(1.0 / 60.0);
  }
}

if (Dir.isdir(filename)) {
  openBrowser(filename);
} else if (!openImage(filename)) {
  System.exit(1);
} else {
  fileList = [filename];
  fileIndex = 0;
}

runWindows();

if (view != nil) view.close();
if (browser != nil) browser.close();
