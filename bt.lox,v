    var full_piece = "";

    for (var offset = 0; offset < piece_size; offset = offset + BLOCK_SIZE) {
      var block = this.piece_store[str(offset)];
      if (block == nil) {
        print "CRITICAL ERROR: Missing block data at offset ", offset, ". Aborting piece.";
