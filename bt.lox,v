class SHA1 {
  init() {
    this.reset();
  }

  reset() {
    this.h0 = 0x67452301;
    this.h1 = 0xefcdab89;
    this.h2 = 0x98badcfe;
    this.h3 = 0x10325476;
    this.h4 = 0xc3d2e1f0;
    this.buffer = "";
    this.length = 0;
  }

  processBuffer() {
    var block_str = this.buffer.slice(0, 64);
    this.buffer = this.buffer.slice(64);

    var W = [];
    for (var i = 0; i < 64; i = i + 4) {
      W.push(this.packWord(block_str, i));
    }
    this.processBlock(this.expandSchedule(W));
  }

  update(data) {
    if (data == "") return;
    this.length = this.length + data.len();
    this.buffer = this.buffer + data;

    while (this.buffer.len() >= 64) {
      this.processBuffer();
    }
  }

  final() {
    var bit_length = this.length * 8;

    this.buffer = this.buffer + [128].to_string();

    var remaining_space = (this.buffer.len() % 64);
    var padding_needed = 0;

    if (remaining_space <= 56) {
      padding_needed = 56 - remaining_space;
    } else {
      padding_needed = (64 - remaining_space) + 56;
    }

    if (padding_needed > 0) {
      var zeros = [0; padding_needed];
      this.buffer = this.buffer + zeros.to_string();
    }

    this.buffer = this.buffer + this.pack32(0);
    this.buffer = this.buffer + this.pack32(bit_length);

    this.processBuffer();
    var scanning = true;
    while (scanning) {
      if (this.buffer == "") {
        scanning = false;
      } else {
        if (this.buffer.len() >= 64) {
          this.processBuffer();
          this.buffer = this.buffer.slice(64);
        } else {
          this.processBuffer();
          this.buffer = "";
          scanning = false;
        }
      }
    }

    return [this.h0, this.h1, this.h2, this.h3, this.h4];
    //return Math.hex(this.h0, 8, false)
    //  + Math.hex(this.h1, 8, false)
    //  + Math.hex(this.h2, 8, false)
    //  + Math.hex(this.h3, 8, false)
    //  + Math.hex(this.h4, 8, false);
  }

  pack32(value) {
    var b1 = (value >> 24) & 0xff;
    var b2 = (value >> 16) & 0xff;
    var b3 = (value >> 8) & 0xff;
    var b4 = value & 0xff;

    return [b1, b2, b3, b4].to_string();
  }

  packWord(bytes, offset) {
    return (bytes[offset] << 24) |
      (bytes[offset + 1] << 16) |
      (bytes[offset + 2] << 8) |
      (bytes[offset + 3]);
  }

  expandSchedule(block) {
    var W = [];

    for (var i = 0; i < 16; i = i + 1) {
      W.push(block[i]);
    }

    for (var i = 16; i < 80; i = i + 1) {
      var v1 = W[i - 3];
      var v2 = W[i - 8];
      var v3 = W[i - 14];
      var v4 = W[i - 16];
      var res = v1 ^ v2 ^ v3 ^ v4;
      
      var expanded = this.rotl(res, 1) & 0xffffffff;
      W.push(expanded);
    }

    return W;
  }

  processBlock(W) {
    var a = this.h0;
    var b = this.h1;
    var c = this.h2;
    var d = this.h3;
    var e = this.h4;
    var temp = 0;

    for (var i = 0; i < 80; i = i + 1) {
      var f = 0;
      var k = 0;

      if (i < 20) {
        f = ((b & c) | ((~b) & d));
        k = 0x5a827999;
      } else if (i < 40) {
        f = b ^ c ^ d;
        k = 0x6ed9eba1;
      } else if (i < 60) {
        f = (b & c) | (b & d) | (c & d);
        k = 0x8f1bbcdc;
      } else {
        f = b ^ c ^ d;
        k = 0xca62c1d6;
      }

      temp = ((this.rotl(a, 5) & 0xffffffff) + f) & 0xffffffff;
      temp = (temp + e) & 0xffffffff;
      temp = (temp + k) & 0xffffffff;
      temp = (temp + W[i]) & 0xffffffff;
      e = d;
      d = c;
      c = this.rotl(b, 30);
      b = a;
      a = temp;
    }

    this.h0 = (this.h0 + a) & 0xFFFFFFFF;
    this.h1 = (this.h1 + b) & 0xFFFFFFFF;
    this.h2 = (this.h2 + c) & 0xFFFFFFFF;
    this.h3 = (this.h3 + d) & 0xFFFFFFFF;
    this.h4 = (this.h4 + e) & 0xFFFFFFFF;
  }

  rotl(value, shift) {
    return ((value << shift) | (value >> (32 - shift))) & 0xFFFFFFFF;
  }
}

