                   str(aresponse.val[i + 1]) + "." +
                   str(aresponse.val[i + 2]) + "." +
                   str(aresponse.val[i + 3]);

          var p = (aresponse.val[i + 4] << 8) | aresponse.val[i + 5];

          if (this.verbose) print "Found UDP peer: ", ip, ":", p;
          this.peers.push([ip, p]);
        }
        return true;
      } else if (action == 3) {
        var error_msg = Struct.unpack("s", aresponse.val.slice(8));
        print "Tracker UDP Protocol Error: ", error_msg;
        return false;
