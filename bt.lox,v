  handle_bitfield(payload) {
    // payload[0] is the id (5), bytes start at payload[1]
    for (var i = 0; i < this.total_pieces; i = i + 1) {
      var byteIdx = Math.floor(i / 8) + 1;
      var bitIdx = 7 - (i % 8);
      var res = (payload[byteIdx] >> bitIdx) & 1;

      if (res == 1) {
        this.peer_pieces[i] = true;
      }
    }
  }

