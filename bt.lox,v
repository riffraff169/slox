  recv_all(socket, size) {
    var buffer = "";
    while (buffer.len() < size) {
      var res = socket.recv(size - buffer.len());

      if (!res.ok) {
        return Result(false, nil, "Socket recv error: " + res.err);
      }

      if (res.val == nil) {
        return Result(false, nil, "Peer disconnected cleanly (received nil)");
      }

      if (res.val.len() == 0) {
        return Result(false, nil, "Peer disconnected cleanly (received 0 bytes)");
      }

      buffer = buffer + res.val;
    }
    return Result(true, buffer, nil);
  }

