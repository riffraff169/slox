    while (true) {
      var header = this.p_sock.recv(4);
      if (!header.ok) break;

      var length = Struct.unpack("I", header.val)[0];
      if (length == 0) continue; // keep-alive

      var payloadRes = this.p_sock.recv(length);
      if (!payloadRes.ok) break;

      var payload = payloadRes.val;
      var msgid = payload[0];

      if (msgid == 5) { // bitfield
        this.handle_bitfield(payload);
        peer.send_interested();
      } else if (msgid == 1) { // unchoke
        this.is_choked = false;
        break;
      }
    }
