      this.connection_id, // 64bit connection id
      1,                  // action 1 = announce
      this.trans_id,      // transaction id to verify response matching
      this.info_hash,     // 20 byte torrent info hash
      this.peer_id_str,   // 20 byte unique client peer id
      0, 0, 0,            // downloaded, left, upload offsets (64 bit)
      event,              // current swarm event flag
      0,                  // ip address (0 means tracker uses sender ip)
      this.key,           // unique extensions key
      -1,                 // nu_want (-1 means default chunk size)
      6881                // the port your client listens on for inbound peers
    ]);

    this.sock.send(announce_packet);
    var aresponse = this.sock.recv(1024);

    if (aresponse != nil and aresponse.ok) {
      this.peers = [];
      var header = Struct.unpack("I I I I I", aresponse.val);
      var action = header[0];
      var ret_tid = header[1];
      var interval = header[2];
      var leechers = header[3];
      var seeders = header[4];

