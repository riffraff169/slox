  write_to_files(piece_index, data) {
    var piece_start = piece_index * this.piece_length;
    var piece_end = piece_start + data.len();

    for  (var i = 0; i < this.files.len(); i = i +  1) {
      var f = this.files[i]; //{path, length, start, end}

      var overlap_start = Math.max(piece_start, f.start);
      var overlap_end = Math.min(piece_end, f.end);

      if (overlap_start < overlap_end) {
        var slice_start = overlap_start - piece_start;
        var slice_len = overlap_end - overlap_start;
        var file_offset = overlap_start - f.start;

        var chunk = data.slice(slice_start, slice_len);

        var fh = File.open(f.full_path, "rb+");
        fh.seek(file_offset);
        fh.write(chunk);
        fh.close();

        print "Saved piece ", piece_index, " fragment to ", f.path;
      }
    }
